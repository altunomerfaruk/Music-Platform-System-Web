@model MusicProject.Models.ViewModels.ArtistProfileSettingsViewModel

@{
    ViewData["Title"] = "Profil Ayarları";
    ViewData["PageDescription"] = "Dinleyicilerin göreceği sanatçı bilgilerini düzenle.";
    Layout = "~/Views/Shared/_ArtistLayout.cshtml";
}

<style>
    .profile-settings-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 32px;
    }

    .profile-settings-header {
        margin-bottom: 28px;
    }

    .profile-settings-title {
        margin: 0 0 8px;
        color: #ffffff;
        font-size: 30px;
        font-weight: 700;
    }

    .profile-settings-description {
        margin: 0;
        color: #a7a7b3;
        line-height: 1.6;
    }

    .profile-settings-card {
        padding: 28px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.04);
    }

    .profile-settings-message {
        margin-bottom: 22px;
        padding: 14px 16px;
        border-radius: 12px;
    }

        .profile-settings-message.success {
            border: 1px solid rgba(46, 204, 113, 0.35);
            background: rgba(46, 204, 113, 0.12);
            color: #87e6ae;
        }

        .profile-settings-message.error {
            border: 1px solid rgba(231, 76, 60, 0.35);
            background: rgba(231, 76, 60, 0.12);
            color: #ff9e94;
        }

    .validation-summary-valid {
        display: none;
    }

    .profile-settings-group {
        margin-bottom: 22px;
    }

    .profile-settings-label {
        display: block;
        margin-bottom: 8px;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
    }

    .profile-settings-input {
        width: 100%;
        box-sizing: border-box;
        padding: 13px 15px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 11px;
        outline: none;
        background: rgba(255, 255, 255, 0.06);
        color: #ffffff;
        font-size: 15px;
    }

        .profile-settings-input:focus {
            border-color: #1ed760;
            background: rgba(255, 255, 255, 0.09);
        }

    .profile-settings-select {
        cursor: pointer;
    }

        .profile-settings-select option {
            color: #ffffff;
            background-color: #121713;
        }

    .profile-settings-hint {
        display: block;
        margin-top: 7px;
        color: #85858f;
        font-size: 12px;
        line-height: 1.5;
    }

    .profile-settings-validation {
        display: block;
        margin-top: 7px;
        color: #ff8176;
        font-size: 13px;
    }

    .profile-settings-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 28px;
    }

    .profile-settings-cancel,
    .profile-settings-save {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 130px;
        padding: 12px 18px;
        border-radius: 11px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

    .profile-settings-cancel {
        border: 1px solid rgba(255, 255, 255, 0.13);
        background: transparent;
        color: #d5d5dc;
    }

    .profile-settings-save {
        border: none;
        background: #1ed760;
        color: #071008;
    }

        .profile-settings-save:hover {
            background: #25e66d;
        }

    @@media (max-width: 700px) {
        .profile-settings-page {
            padding: 20px;
        }

        .profile-settings-card {
            padding: 20px;
        }

        .profile-settings-actions {
            flex-direction: column-reverse;
        }

        .profile-settings-cancel,
        .profile-settings-save {
            width: 100%;
        }
    }
</style>

<div class="profile-settings-page">

    <div class="profile-settings-header">

        <h1 class="profile-settings-title">
            Profil Ayarları
        </h1>

        <p class="profile-settings-description">
            Dinleyicilerin göreceği sanatçı bilgilerini buradan güncelleyebilirsin.
        </p>

    </div>

    <div class="profile-settings-card">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="profile-settings-message success">
                @TempData["SuccessMessage"]
            </div>
        }

        <div asp-validation-summary="ModelOnly"
             class="profile-settings-message error">
        </div>

        <form asp-controller="ArtistDashboard"
              asp-action="ProfileSettings"
              method="post">

            @Html.AntiForgeryToken()

            <div class="profile-settings-group">

                <label asp-for="Name"
                       class="profile-settings-label">
                </label>

                <input asp-for="Name"
                       class="profile-settings-input"
                       placeholder="Sanatçı adını yaz" />

                <span class="profile-settings-hint">
                    Bu alan gerçek isim, grup adı veya sahne adı olabilir.
                </span>

                <span asp-validation-for="Name"
                      class="profile-settings-validation">
                </span>

            </div>

            <div class="profile-settings-group">

                <label asp-for="CountryId"
                       class="profile-settings-label">
                </label>

                <select asp-for="CountryId"
                        asp-items="Model.CountryOptions"
                        class="profile-settings-input profile-settings-select">

                    <option value="">
                        Ülke seçiniz
                    </option>

                </select>

                <span class="profile-settings-hint">
                    Ülke yalnızca sistemde kayıtlı seçeneklerden biri olabilir.
                </span>

                <span asp-validation-for="CountryId"
                      class="profile-settings-validation">
                </span>

            </div>

            <div class="profile-settings-group">

                <label asp-for="DebutYear"
                       class="profile-settings-label">
                </label>

                <input asp-for="DebutYear"
                       type="number"
                       min="1900"
                       max="2100"
                       class="profile-settings-input"
                       placeholder="Örneğin: 2020" />

                <span asp-validation-for="DebutYear"
                      class="profile-settings-validation">
                </span>

            </div>

            <div class="profile-settings-actions">

                <a asp-controller="ArtistDashboard"
                   asp-action="Index"
                   class="profile-settings-cancel">
                    Vazgeç
                </a>

                <button type="submit"
                        class="profile-settings-save">
                    Değişiklikleri Kaydet
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}