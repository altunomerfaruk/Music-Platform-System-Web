@using System.Globalization
@model MusicProject.ViewModels.AdminDashboard.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Paneli";
    ViewData["PageDescription"] = "Platformun güncel durumunu buradan takip edebilirsin.";
    Layout = "_AdminLayout";

    var turkishCulture = CultureInfo.GetCultureInfo("tr-TR");
    var adminName = User.Identity?.Name ?? "Admin";
}

@section Styles {
    <style>
        .dashboard-content {
            padding: 32px 34px 50px;
        }

        .welcome-banner {
            position: relative;
            overflow: hidden;
            min-height: 180px;
            padding: 34px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            background: linear-gradient(125deg, rgba(30, 215, 96, 0.20), rgba(18, 23, 19, 0.95) 55%);
            border: 1px solid rgba(30, 215, 96, 0.20);
            border-radius: 22px;
        }

            .welcome-banner::after {
                content: "♪";
                position: absolute;
                right: 50px;
                color: rgba(30, 215, 96, 0.13);
                font-size: 155px;
                font-weight: bold;
                transform: rotate(-12deg);
            }

        .welcome-content {
            position: relative;
            z-index: 1;
        }

        .welcome-label {
            margin-bottom: 10px;
            color: var(--primary);
            font-size: 12px;
            font-weight: 850;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .welcome-title {
            margin-bottom: 10px;
            color: #ffffff;
            font-size: clamp(25px, 3vw, 38px);
            line-height: 1.15;
        }

        .welcome-description {
            max-width: 620px;
            color: var(--text-secondary);
            font-size: 14px;
            line-height: 1.7;
        }

        .welcome-date {
            position: relative;
            z-index: 1;
            min-width: 160px;
            padding: 14px 18px;
            color: #d9e1dc;
            background-color: rgba(0, 0, 0, 0.25);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 13px;
            text-align: center;
            font-size: 13px;
        }

        .stat-grid {
            margin-top: 25px;
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 18px;
        }

        .stat-card {
            min-height: 145px;
            padding: 21px;
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 18px;
            transition: 0.22s ease;
        }

            .stat-card:hover {
                background-color: var(--card-hover);
                border-color: rgba(30, 215, 96, 0.22);
                transform: translateY(-3px);
            }

        .stat-card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .stat-icon {
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 13px;
            font-size: 20px;
        }

        .green-icon {
            color: var(--primary);
            background-color: rgba(30, 215, 96, 0.11);
        }

        .blue-icon {
            color: var(--info);
            background-color: rgba(85, 170, 255, 0.11);
        }

        .orange-icon {
            color: var(--warning);
            background-color: rgba(255, 189, 61, 0.11);
        }

        .red-icon {
            color: var(--danger);
            background-color: rgba(255, 92, 92, 0.11);
        }

        .stat-value-label {
            padding: 5px 8px;
            color: var(--primary);
            background-color: rgba(30, 215, 96, 0.09);
            border-radius: 8px;
            font-size: 10px;
            font-weight: 800;
        }

        .stat-number {
            margin-top: 20px;
            color: #ffffff;
            font-size: 28px;
            font-weight: 900;
        }

        .stat-label {
            margin-top: 6px;
            color: var(--text-secondary);
            font-size: 13px;
        }

        .dashboard-grid {
            margin-top: 25px;
            display: grid;
            grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.75fr);
            gap: 20px;
        }

        .panel {
            overflow: hidden;
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 19px;
        }

        .panel-header {
            min-height: 69px;
            padding: 18px 21px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            border-bottom: 1px solid var(--border);
        }

        .panel-title {
            color: #ffffff;
            font-size: 16px;
            font-weight: 850;
        }

        .panel-subtitle {
            margin-top: 4px;
            color: var(--text-secondary);
            font-size: 12px;
        }

        .panel-value {
            color: var(--primary);
            font-size: 12px;
            font-weight: 800;
        }

        .chart-area {
            height: 300px;
            padding: 27px 22px 18px;
            display: flex;
            align-items: flex-end;
            gap: 13px;
        }

        .chart-column {
            height: 100%;
            min-width: 0;
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            gap: 10px;
        }

        .chart-value {
            color: #ffffff;
            text-align: center;
            font-size: 10px;
            font-weight: 800;
        }

        .chart-bar-wrapper {
            height: 210px;
            display: flex;
            align-items: flex-end;
        }

        .chart-bar {
            width: 100%;
            background: linear-gradient(180deg, var(--primary), rgba(30, 215, 96, 0.22));
            border-radius: 8px 8px 3px 3px;
        }

            .chart-bar.empty {
                height: 3px !important;
                opacity: 0.25;
            }

        .chart-label {
            color: var(--text-secondary);
            text-align: center;
            font-size: 11px;
        }

        .quick-actions {
            padding: 17px;
            display: grid;
            gap: 11px;
        }

        .quick-action {
            min-height: 64px;
            padding: 13px;
            display: flex;
            align-items: center;
            gap: 13px;
            background-color: rgba(255, 255, 255, 0.025);
            border: 1px solid transparent;
            border-radius: 13px;
            transition: 0.2s;
        }

            .quick-action:hover {
                background-color: rgba(255, 255, 255, 0.055);
                border-color: var(--border);
                transform: translateX(3px);
            }

        .quick-action-icon {
            width: 39px;
            height: 39px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: var(--primary);
            background-color: rgba(30, 215, 96, 0.09);
            border-radius: 11px;
        }

        .quick-action-content {
            min-width: 0;
            flex: 1;
        }

        .quick-action-title {
            color: #ffffff;
            font-size: 13px;
            font-weight: 800;
        }

        .quick-action-description {
            margin-top: 4px;
            overflow: hidden;
            color: var(--text-secondary);
            font-size: 11px;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .quick-action-arrow {
            color: #5c655f;
        }

        .tables-grid {
            margin-top: 25px;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

            .data-table th,
            .data-table td {
                padding: 15px 18px;
                border-bottom: 1px solid var(--border);
                text-align: left;
                white-space: nowrap;
            }

            .data-table th {
                color: #687169;
                font-size: 10px;
                font-weight: 850;
                letter-spacing: 0.8px;
                text-transform: uppercase;
            }

            .data-table td {
                color: #d8ded9;
                font-size: 12px;
            }

        .user-cell,
        .song-cell {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .table-avatar,
        .song-cover {
            width: 37px;
            height: 37px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: #071008;
            background-color: var(--primary);
            border-radius: 10px;
            font-size: 13px;
            font-weight: 900;
        }

        .song-cover {
            color: var(--primary);
            background: linear-gradient(135deg, #1d3324, #0c110e);
        }

        .cell-title {
            max-width: 200px;
            overflow: hidden;
            color: #ffffff;
            font-size: 12px;
            font-weight: 750;
            text-overflow: ellipsis;
        }

        .cell-subtitle {
            max-width: 200px;
            margin-top: 3px;
            overflow: hidden;
            color: var(--text-secondary);
            font-size: 10px;
            text-overflow: ellipsis;
        }

        .role-badge,
        .status-badge {
            padding: 5px 9px;
            display: inline-flex;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 800;
        }

        .role-user {
            color: var(--info);
            background-color: rgba(85, 170, 255, 0.10);
        }

        .role-artist {
            color: var(--primary);
            background-color: rgba(30, 215, 96, 0.10);
        }

        .role-admin {
            color: var(--warning);
            background-color: rgba(255, 189, 61, 0.10);
        }

        .status-active {
            color: var(--primary);
            background-color: rgba(30, 215, 96, 0.10);
        }

        .status-inactive {
            color: var(--danger);
            background-color: rgba(255, 92, 92, 0.10);
        }

        .rank {
            font-weight: 900;
        }

        .rank-first {
            color: var(--primary);
        }

        .rank-second {
            color: var(--warning);
        }

        .rank-third {
            color: #d2a67a;
        }

        .rank-other {
            color: var(--text-secondary);
        }

        .empty-state {
            padding: 35px 20px !important;
            color: var(--text-secondary) !important;
            text-align: center !important;
        }

        @@media (max-width: 1200px) {
            .stat-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .dashboard-grid,
            .tables-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 650px) {
            .dashboard-content {
                padding: 20px 16px 35px;
            }

            .welcome-banner {
                min-height: 205px;
                padding: 25px;
                align-items: flex-start;
                flex-direction: column;
            }

            .stat-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="dashboard-content">

    <section class="welcome-banner">

        <div class="welcome-content">

            <p class="welcome-label">
                MusicProject yönetimi
            </p>

            <h2 class="welcome-title">
                Tekrar hoş geldin, @adminName.
            </h2>

            <p class="welcome-description">
                Platformdaki kullanıcı, sanatçı ve şarkı sayılarını takip edebilir;
                dinlenme hareketlerini ve en çok dinlenen şarkıları inceleyebilirsin.
            </p>

        </div>

        <div class="welcome-date">
            @DateTime.Now.ToString("dd MMMM yyyy", turkishCulture)
        </div>

    </section>

    <section class="stat-grid">

        <article class="stat-card">

            <div class="stat-card-top">
                <div class="stat-icon blue-icon">👥</div>
                <span class="stat-value-label">Hesaplar</span>
            </div>

            <div class="stat-number">
                @Model.TotalUsers.ToString("N0", turkishCulture)
            </div>

            <div class="stat-label">
                Toplam kullanıcı
            </div>

        </article>

        <article class="stat-card">

            <div class="stat-card-top">
                <div class="stat-icon green-icon">★</div>
                <span class="stat-value-label">Sanatçılar</span>
            </div>

            <div class="stat-number">
                @Model.TotalArtists.ToString("N0", turkishCulture)
            </div>

            <div class="stat-label">
                Toplam sanatçı
            </div>

        </article>

        <article class="stat-card">

            <div class="stat-card-top">
                <div class="stat-icon orange-icon">♫</div>
                <span class="stat-value-label">Katalog</span>
            </div>

            <div class="stat-number">
                @Model.TotalSongs.ToString("N0", turkishCulture)
            </div>

            <div class="stat-label">
                Toplam şarkı
            </div>

        </article>

        <article class="stat-card">

            <div class="stat-card-top">
                <div class="stat-icon red-icon">▶</div>
                <span class="stat-value-label">Geçmiş</span>
            </div>

            <div class="stat-number">
                @Model.TotalListenings.ToString("N0", turkishCulture)
            </div>

            <div class="stat-label">
                Toplam dinlenme
            </div>

        </article>

    </section>

    <section class="dashboard-grid">

        <article class="panel">

            <div class="panel-header">

                <div>
                    <h3 class="panel-title">Haftalık dinlenme</h3>
                    <p class="panel-subtitle">Son yedi günlük gerçek dinleme kayıtları</p>
                </div>

                <span class="panel-value">
                    @Model.WeeklyListenings.Sum(day => day.ListeningCount).ToString("N0", turkishCulture) dinlenme
                </span>

            </div>

            <div class="chart-area">

                @foreach (var day in Model.WeeklyListenings)
                {
                    <div class="chart-column">

                        <span class="chart-value">
                            @day.ListeningCount
                        </span>

                        <div class="chart-bar-wrapper">

                            <div class="chart-bar @(day.ListeningCount == 0 ? "empty" : "")"
                                 style="height: @(day.BarHeightPercent)%;">
                            </div>

                        </div>

                        <span class="chart-label">
                            @day.DayLabel
                        </span>

                    </div>
                }

            </div>

        </article>

        <article class="panel">

            <div class="panel-header">

                <div>
                    <h3 class="panel-title">Hızlı erişim</h3>
                    <p class="panel-subtitle">Yönetimde sık kullanılan bölümler</p>
                </div>

            </div>

            <div class="quick-actions">

                <a asp-controller="AdminDashboard"
                   asp-action="Users"
                   class="quick-action">

                    <div class="quick-action-icon">
                        👥
                    </div>

                    <div class="quick-action-content">

                        <div class="quick-action-title">
                            Kullanıcıları yönet
                        </div>

                        <div class="quick-action-description">
                            Kullanıcıları ara, görüntüle ve hesap durumlarını yönet
                        </div>

                    </div>

                    <span class="quick-action-arrow">
                        ›
                    </span>

                </a>

                <a href="/hangfire"
                   class="quick-action">

                    <div class="quick-action-icon">
                        ⚙
                    </div>

                    <div class="quick-action-content">

                        <div class="quick-action-title">
                            Hangfire Dashboard
                        </div>

                        <div class="quick-action-description">
                            Planlı yayın işlerini görüntüle
                        </div>

                    </div>

                    <span class="quick-action-arrow">
                        ›
                    </span>

                </a>

            </div>

        </article>

    </section>

    <section class="tables-grid">

        <article class="panel">

            <div class="panel-header">

                <div>
                    <h3 class="panel-title">Son kayıt olan kullanıcılar</h3>
                    <p class="panel-subtitle">Platforma en son katılan hesaplar</p>
                </div>

            </div>

            <div class="table-wrapper">

                <table class="data-table">

                    <thead>
                        <tr>
                            <th>Kullanıcı</th>
                            <th>Rol</th>
                            <th>Durum</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.RecentUsers.Count == 0)
                        {
                            <tr>
                                <td colspan="3" class="empty-state">
                                    Henüz kullanıcı bulunmuyor.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var recentUser in Model.RecentUsers)
                            {
                                var roleClass = $"role-{recentUser.RoleName.ToLowerInvariant()}";

                                <tr>

                                    <td>

                                        <div class="user-cell">

                                            <div class="table-avatar">
                                                @recentUser.Initial
                                            </div>

                                            <div>

                                                <div class="cell-title">
                                                    @recentUser.Username
                                                </div>

                                                <div class="cell-subtitle">
                                                    @recentUser.Email
                                                </div>

                                            </div>

                                        </div>

                                    </td>

                                    <td>
                                        <span class="role-badge @roleClass">
                                            @recentUser.RoleName
                                        </span>
                                    </td>

                                    <td>

                                        @if (recentUser.IsActive)
                                        {
                                            <span class="status-badge status-active">
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-inactive">
                                                Pasif
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </article>

        <article class="panel">

            <div class="panel-header">

                <div>
                    <h3 class="panel-title">En çok dinlenen şarkılar</h3>
                    <p class="panel-subtitle">Dinlenme sayısına göre ilk şarkılar</p>
                </div>

            </div>

            <div class="table-wrapper">

                <table class="data-table">

                    <thead>
                        <tr>
                            <th>Şarkı</th>
                            <th>Dinlenme</th>
                            <th>Sıra</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.TopSongs.Count == 0)
                        {
                            <tr>
                                <td colspan="3" class="empty-state">
                                    Henüz şarkı bulunmuyor.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @for (var index = 0; index < Model.TopSongs.Count; index++)
                            {
                                var song = Model.TopSongs[index];
                                var rank = index + 1;

                                var rankClass = rank switch
                                {
                                    1 => "rank-first",
                                    2 => "rank-second",
                                    3 => "rank-third",
                                    _ => "rank-other"
                                };

                                <tr>

                                    <td>

                                        <div class="song-cell">

                                            <div class="song-cover">
                                                ♪
                                            </div>

                                            <div>

                                                <div class="cell-title">
                                                    @song.Title
                                                </div>

                                                <div class="cell-subtitle">
                                                    @song.ArtistName
                                                </div>

                                            </div>

                                        </div>

                                    </td>

                                    <td>
                                        @song.TotalStreams.ToString("N0", turkishCulture)
                                    </td>

                                    <td>
                                        <span class="rank @rankClass">
                                            #@rank
                                        </span>
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </article>

    </section>

</div>