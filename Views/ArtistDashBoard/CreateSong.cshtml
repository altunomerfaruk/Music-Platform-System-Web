@model MusicProject.Models.ViewModels.CreateSongViewModel

@{
    ViewData["Title"] = "Yeni Şarkı";

    ViewData["PageDescription"] =
        "Yeni bir şarkı ekle, albümünü ve müzik türlerini belirle.";

    Layout = "_ArtistLayout";

    var selectedGenreCount = Model.SelectedGenreIds?.Count ?? 0;
}

@section Styles {
    <style>
        .create-song-content {
            padding: 32px 34px 50px;
        }

        .create-song-container {
            width: 100%;
            max-width: 980px;
            margin: 0 auto;
        }

        .create-song-hero {
            padding: 30px;
            display: flex;
            align-items: center;
            gap: 21px;
            background: linear-gradient( 125deg, rgba(30, 215, 96, 0.21), rgba(18, 23, 19, 0.97) 65% );
            border: 1px solid rgba(30, 215, 96, 0.20);
            border-radius: 21px;
        }

        .create-song-hero-icon {
            width: 86px;
            height: 86px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: #071008;
            background-color: var(--primary);
            border-radius: 20px;
            font-size: 39px;
            box-shadow: 0 15px 36px rgba(0, 0, 0, 0.30);
        }

        .create-song-label {
            color: var(--primary);
            font-size: 11px;
            font-weight: 850;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .create-song-title {
            margin-top: 7px;
            color: #ffffff;
            font-size: clamp(27px, 4vw, 39px);
        }

        .create-song-description {
            max-width: 650px;
            margin-top: 8px;
            color: var(--text-secondary);
            font-size: 13px;
            line-height: 1.7;
        }

        .song-form-panel {
            margin-top: 22px;
            padding: 27px;
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 19px;
        }

        .validation-summary {
            margin-bottom: 20px;
            padding: 14px 16px;
            color: #ffaaaa;
            background-color: rgba(255, 92, 92, 0.08);
            border: 1px solid rgba(255, 92, 92, 0.20);
            border-radius: 11px;
            font-size: 12px;
            line-height: 1.6;
        }

            .validation-summary:empty {
                display: none;
            }

        .song-form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 21px;
        }

        .form-group {
            min-width: 0;
        }

        .form-group-full {
            grid-column: 1 / -1;
        }

        .form-label-row {
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .form-label {
            display: block;
            color: #ffffff;
            font-size: 12px;
            font-weight: 800;
        }

        .form-required {
            color: var(--primary);
        }

        .form-optional {
            color: var(--text-secondary);
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.6px;
            text-transform: uppercase;
        }

        .form-input,
        .form-select {
            width: 100%;
            height: 47px;
            padding: 0 14px;
            color: #ffffff;
            background-color: #0c110e;
            border: 1px solid var(--border);
            border-radius: 11px;
            outline: none;
            transition: 0.2s;
        }

            .form-input:focus,
            .form-select:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(30, 215, 96, 0.10);
            }

            .form-input::placeholder {
                color: #667069;
            }

            .form-select option {
                color: #ffffff;
                background-color: #101612;
            }

        .form-description {
            margin-top: 7px;
            color: var(--text-secondary);
            font-size: 10px;
            line-height: 1.5;
        }

        .field-validation-error {
            margin-top: 7px;
            display: block;
            color: #ff8585;
            font-size: 10px;
        }

        .genre-panel {
            padding: 18px;
            background-color: #0c110e;
            border: 1px solid var(--border);
            border-radius: 13px;
        }

        .genre-panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .genre-panel-title {
            color: #ffffff;
            font-size: 12px;
            font-weight: 800;
        }

        .genre-selected-count {
            padding: 5px 9px;
            color: var(--primary);
            background-color: rgba(30, 215, 96, 0.09);
            border-radius: 999px;
            font-size: 10px;
            font-weight: 800;
        }

        .genre-search-wrapper {
            margin-top: 13px;
            position: relative;
        }

        .genre-search-input {
            width: 100%;
            height: 42px;
            padding: 0 13px 0 38px;
            color: #ffffff;
            background-color: #121914;
            border: 1px solid var(--border);
            border-radius: 10px;
            outline: none;
            transition: 0.2s;
        }

            .genre-search-input:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(30, 215, 96, 0.08);
            }

            .genre-search-input::placeholder {
                color: #687169;
            }

        .genre-search-icon {
            position: absolute;
            top: 50%;
            left: 13px;
            color: var(--text-secondary);
            font-size: 14px;
            transform: translateY(-50%);
            pointer-events: none;
        }

        .genre-options {
            max-height: 270px;
            margin-top: 13px;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
            overflow-y: auto;
        }

        .genre-option {
            position: relative;
        }

        .genre-checkbox {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .genre-option-label {
            min-height: 45px;
            padding: 0 13px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            color: #d7ddd8;
            background-color: rgba(255, 255, 255, 0.025);
            border: 1px solid var(--border);
            border-radius: 10px;
            font-size: 11px;
            font-weight: 750;
            cursor: pointer;
            transition: 0.18s;
        }

            .genre-option-label:hover {
                color: #ffffff;
                border-color: rgba(30, 215, 96, 0.30);
            }

        .genre-check-icon {
            width: 18px;
            height: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: transparent;
            background-color: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border);
            border-radius: 5px;
            font-size: 11px;
            transition: 0.18s;
        }

        .genre-checkbox:checked + .genre-option-label {
            color: #071008;
            background-color: var(--primary);
            border-color: var(--primary);
        }

            .genre-checkbox:checked + .genre-option-label .genre-check-icon {
                color: #071008;
                background-color: rgba(0, 0, 0, 0.12);
                border-color: rgba(0, 0, 0, 0.16);
            }

        .genre-empty-message {
            margin-top: 15px;
            display: none;
            color: var(--text-secondary);
            font-size: 11px;
            text-align: center;
        }

        .song-preview {
            margin-top: 25px;
            padding: 18px;
            display: flex;
            align-items: center;
            gap: 16px;
            background-color: rgba(255, 255, 255, 0.025);
            border: 1px solid var(--border);
            border-radius: 14px;
        }

        .song-preview-cover {
            width: 73px;
            height: 73px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: var(--primary);
            background: radial-gradient( circle at top right, rgba(30, 215, 96, 0.22), transparent 48% ), #0c110e;
            border-radius: 13px;
            font-size: 30px;
        }

        .song-preview-content {
            min-width: 0;
            flex: 1;
        }

        .song-preview-label {
            color: var(--text-secondary);
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

        .song-preview-title {
            margin-top: 6px;
            overflow: hidden;
            color: #ffffff;
            font-size: 17px;
            font-weight: 850;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .song-preview-meta {
            margin-top: 6px;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 7px;
            color: var(--text-secondary);
            font-size: 11px;
        }

        .song-preview-dot {
            color: #525b55;
        }

        .song-form-actions {
            margin-top: 25px;
            padding-top: 20px;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            border-top: 1px solid var(--border);
        }

        .cancel-button,
        .save-button {
            min-height: 44px;
            padding: 0 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            font-size: 12px;
            font-weight: 850;
            transition: 0.2s;
        }

        .cancel-button {
            color: #ffffff;
            background-color: transparent;
            border: 1px solid var(--border);
        }

            .cancel-button:hover {
                color: var(--primary);
                border-color: rgba(30, 215, 96, 0.30);
            }

        .save-button {
            color: #071008;
            background-color: var(--primary);
            border: 1px solid var(--primary);
        }

            .save-button:hover {
                background-color: var(--primary-hover);
                transform: translateY(-1px);
            }

        @@media (max-width: 850px) {
            .create-song-content {
                padding: 22px 16px 40px;
            }

            .song-form-grid {
                grid-template-columns: 1fr;
            }

            .form-group-full {
                grid-column: auto;
            }

            .genre-options {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 650px) {
            .create-song-hero {
                align-items: flex-start;
                flex-direction: column;
            }

            .song-form-panel {
                padding: 20px;
            }

            .genre-options {
                grid-template-columns: 1fr;
            }

            .song-form-actions {
                align-items: stretch;
                flex-direction: column-reverse;
            }

            .cancel-button,
            .save-button {
                width: 100%;
            }
        }
    </style>
}

<div class="create-song-content">

    <div class="create-song-container">

        <section class="create-song-hero">

            <div class="create-song-hero-icon">
                ♪
            </div>

            <div>

                <p class="create-song-label">
                    Yeni yayın
                </p>

                <h2 class="create-song-title">
                    Şarkı Ekle
                </h2>

                <p class="create-song-description">
                    Şarkının adını gir, isteğe bağlı olarak bir albüm seç
                    ve şarkının ait olduğu müzik türlerini belirle.
                </p>

            </div>

        </section>

        <form asp-controller="ArtistDashboard"
              asp-action="CreateSong"
              method="post"
              class="song-form-panel">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>

            <div class="song-form-grid">

                <div class="form-group form-group-full">

                    <div class="form-label-row">

                        <label asp-for="Title"
                               class="form-label">
                            Şarkı adı
                            <span class="form-required">*</span>
                        </label>

                    </div>

                    <input asp-for="Title"
                           class="form-input"
                           placeholder="Örneğin: Gece Yolculuğu"
                           autocomplete="off" />

                    <span asp-validation-for="Title"
                          class="field-validation-error">
                    </span>

                    <p class="form-description">
                        Aynı sanatçı hesabında aynı isimli ikinci bir şarkı oluşturulamaz.
                    </p>

                </div>

                <div class="form-group">

                    <div class="form-label-row">

                        <label asp-for="AlbumId"
                               class="form-label">
                            Albüm
                        </label>

                        <span class="form-optional">
                            İsteğe bağlı
                        </span>

                    </div>

                    <select asp-for="AlbumId"
                            asp-items="Model.AlbumOptions"
                            class="form-select">

                        <option value="">
                            Albüm seçme — Single olarak yayınla
                        </option>

                    </select>

                    <span asp-validation-for="AlbumId"
                          class="field-validation-error">
                    </span>

                    <p class="form-description">
                        Albüm seçmezsen şarkı bağımsız single olarak kaydedilir.
                    </p>

                </div>

                <div class="form-group">

                    <div class="form-label-row">

                        <span class="form-label">
                            Sanatçı
                        </span>

                    </div>

                    <input type="text"
                           class="form-input"
                           value="@Model.Artist.Name"
                           disabled />

                    <p class="form-description">
                        Şarkı otomatik olarak giriş yaptığın sanatçı profiline bağlanır.
                    </p>

                </div>

                <div class="form-group form-group-full">

                    <div class="form-label-row">

                        <span class="form-label">
                            Müzik türleri
                            <span class="form-required">*</span>
                        </span>

                    </div>

                    <div class="genre-panel">

                        <div class="genre-panel-header">

                            <span class="genre-panel-title">
                                En az bir tür seç
                            </span>

                            <span class="genre-selected-count"
                                  id="genreSelectedCount">
                                @selectedGenreCount tür seçildi
                            </span>

                        </div>

                        <div class="genre-search-wrapper">

                            <span class="genre-search-icon">
                                ⌕
                            </span>

                            <input type="text"
                                   id="genreSearchInput"
                                   class="genre-search-input"
                                   placeholder="Tür ara..."
                                   autocomplete="off" />

                        </div>

                        <div class="genre-options"
                             id="genreOptions">

                            @foreach (var genre in Model.GenreOptions)
                            {
                                var checkboxId = $"genre_{genre.Value}";
                                var genreId = int.Parse(genre.Value);

                                var isChecked =
                                    Model.SelectedGenreIds?.Contains(genreId) == true; 

                                <div class="genre-option"
                                     data-genre-name="@genre.Text">

                                    @if (isChecked)
                                    {
                                        <input type="checkbox"
                                               id="@checkboxId"
                                               name="SelectedGenreIds"
                                               value="@genre.Value"
                                               checked
                                               class="genre-checkbox" />
                                    }
                                    else
                                    {
                                        <input type="checkbox"
                                               id="@checkboxId"
                                               name="SelectedGenreIds"
                                               value="@genre.Value"
                                               class="genre-checkbox" />
                                    }

                                    <label for="@checkboxId"
                                           class="genre-option-label">

                                        <span>
                                            @genre.Text
                                        </span>

                                        <span class="genre-check-icon">
                                            ✓
                                        </span>

                                    </label>

                                </div>
                            }

                        </div>

                        <p class="genre-empty-message"
                           id="genreEmptyMessage">
                            Aramana uygun müzik türü bulunamadı.
                        </p>

                    </div>

                    <span asp-validation-for="SelectedGenreIds"
                          class="field-validation-error">
                    </span>

                </div>

            </div>

            <div class="song-preview">

                <div class="song-preview-cover">
                    ♪
                </div>

                <div class="song-preview-content">

                    <p class="song-preview-label">
                        Şarkı önizlemesi
                    </p>

                    <div class="song-preview-title"
                         id="songPreviewTitle">
                        Şarkı adı
                    </div>

                    <div class="song-preview-meta">

                        <span>
                            @Model.Artist.Name
                        </span>

                        <span class="song-preview-dot">
                            •
                        </span>

                        <span id="songPreviewAlbum">
                            Single
                        </span>

                        <span class="song-preview-dot">
                            •
                        </span>

                        <span id="songPreviewGenreCount">
                            @selectedGenreCount tür
                        </span>

                    </div>

                </div>

            </div>

            <div class="song-form-actions">

                <a asp-controller="ArtistDashboard"
                   asp-action="Index"
                   class="cancel-button">
                    Vazgeç
                </a>

                <button type="submit"
                        class="save-button">
                    Şarkıyı Ekle
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const titleInput = document.getElementById("Title");
            const albumSelect = document.getElementById("AlbumId");

            const previewTitle =
                document.getElementById("songPreviewTitle");

            const previewAlbum =
                document.getElementById("songPreviewAlbum");

            const previewGenreCount =
                document.getElementById("songPreviewGenreCount");

            const genreSelectedCount =
                document.getElementById("genreSelectedCount");

            const genreSearchInput =
                document.getElementById("genreSearchInput");

            const genreEmptyMessage =
                document.getElementById("genreEmptyMessage");

            const genreOptions = Array.from(
                document.querySelectorAll(".genre-option")
            );

            const genreCheckboxes = Array.from(
                document.querySelectorAll(".genre-checkbox")
            );

            function normalizeText(value) {
                return value
                    .toLocaleLowerCase("tr-TR")
                    .trim();
            }

            function updateTitlePreview() {
                if (!titleInput || !previewTitle) {
                    return;
                }

                const title = titleInput.value.trim();

                previewTitle.textContent =
                    title || "Şarkı adı";
            }

            function updateAlbumPreview() {
                if (!albumSelect || !previewAlbum) {
                    return;
                }

                const selectedOption =
                    albumSelect.options[albumSelect.selectedIndex];

                const albumName =
                    selectedOption && selectedOption.value
                        ? selectedOption.text
                        : "Single";

                previewAlbum.textContent = albumName;
            }

            function updateGenreCount() {
                const selectedCount = genreCheckboxes.filter(
                    function (checkbox) {
                        return checkbox.checked;
                    }
                ).length;

                if (genreSelectedCount) {
                    genreSelectedCount.textContent =
                        selectedCount + " tür seçildi";
                }

                if (previewGenreCount) {
                    previewGenreCount.textContent =
                        selectedCount + " tür";
                }
            }

            if (titleInput) {
                titleInput.addEventListener(
                    "input",
                    updateTitlePreview
                );

                updateTitlePreview();
            }

            if (albumSelect) {
                albumSelect.addEventListener(
                    "change",
                    updateAlbumPreview
                );

                updateAlbumPreview();
            }

            genreCheckboxes.forEach(function (checkbox) {
                checkbox.addEventListener(
                    "change",
                    updateGenreCount
                );
            });

            updateGenreCount();

            if (genreSearchInput) {
                genreSearchInput.addEventListener("input", function () {
                    const searchValue =
                        normalizeText(genreSearchInput.value);

                    let visibleGenreCount = 0;

                    genreOptions.forEach(function (option) {
                        const genreName = normalizeText(
                            option.dataset.genreName || ""
                        );

                        const isMatch =
                            genreName.includes(searchValue);

                        option.style.display =
                            isMatch ? "block" : "none";

                        if (isMatch) {
                            visibleGenreCount++;
                        }
                    });

                    if (genreEmptyMessage) {
                        genreEmptyMessage.style.display =
                            visibleGenreCount === 0
                                ? "block"
                                : "none";
                    }
                });
            }
        });
    </script>
}