@model MusicProject.Models.ViewModels.UserSettingsViewModel

@{
    ViewData["Title"] = "Hesap Ayarları";
    Layout = "_UserLayout";
}

@section Styles {
    <style>
        .settings-page {
            padding: 32px;
        }

        .settings-container {
            width: 100%;
            max-width: 1050px;
            margin: 0 auto;
        }

        .settings-header {
            margin-bottom: 26px;
        }

        .settings-title {
            margin: 0;
            color: #ffffff;
            font-size: 28px;
            font-weight: 850;
        }

        .settings-description {
            margin: 7px 0 0;
            color: var(--text-secondary);
            font-size: 13px;
        }

        .settings-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 300px;
            gap: 22px;
            align-items: start;
        }

        .settings-card {
            padding: 26px;
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 18px;
        }

        .settings-card-title {
            margin: 0 0 5px;
            color: #ffffff;
            font-size: 18px;
            font-weight: 820;
        }

        .settings-card-description {
            margin: 0 0 24px;
            color: var(--text-secondary);
            font-size: 12px;
            line-height: 1.6;
        }

        .settings-form-group {
            margin-bottom: 19px;
        }

        .settings-label {
            display: block;
            margin-bottom: 8px;
            color: #ffffff;
            font-size: 12px;
            font-weight: 750;
        }

        .settings-input {
            width: 100%;
            height: 47px;
            padding: 0 15px;
            color: #ffffff;
            background-color: #0c110e;
            border: 1px solid var(--border);
            border-radius: 11px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .settings-input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(30, 215, 96, 0.10);
        }

        .settings-input::placeholder {
            color: #657069;
        }

        .settings-validation {
            display: block;
            min-height: 17px;
            margin-top: 6px;
            color: #ff6b75;
            font-size: 11px;
        }

        .settings-validation-summary {
            margin-bottom: 19px;
            padding: 13px 15px;
            color: #ff9ba2;
            background-color: rgba(255, 70, 83, 0.09);
            border: 1px solid rgba(255, 70, 83, 0.22);
            border-radius: 11px;
            font-size: 12px;
        }

        .settings-validation-summary:empty {
            display: none;
        }

        .settings-divider {
            height: 1px;
            margin: 27px 0;
            background-color: var(--border);
        }

        .password-heading {
            margin-bottom: 17px;
        }

        .password-title {
            margin: 0;
            color: #ffffff;
            font-size: 15px;
            font-weight: 800;
        }

        .password-description {
            margin: 5px 0 0;
            color: var(--text-secondary);
            font-size: 11px;
            line-height: 1.5;
        }

        .settings-actions {
            margin-top: 26px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .settings-cancel-button,
        .settings-save-button {
            min-height: 43px;
            padding: 0 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            font-size: 12px;
            font-weight: 800;
            text-decoration: none;
            cursor: pointer;
            transition: transform 0.2s, background-color 0.2s;
        }

        .settings-cancel-button {
            color: #ffffff;
            background-color: #1a211d;
            border: 1px solid var(--border);
        }

        .settings-save-button {
            color: #061108;
            background-color: var(--primary);
            border: none;
        }

        .settings-cancel-button:hover,
        .settings-save-button:hover {
            transform: translateY(-1px);
        }

        .settings-save-button:hover {
            background-color: #35e975;
        }

        .settings-success {
            margin-bottom: 20px;
            padding: 14px 16px;
            color: #7cf2a6;
            background-color: rgba(30, 215, 96, 0.09);
            border: 1px solid rgba(30, 215, 96, 0.23);
            border-radius: 12px;
            font-size: 12px;
            font-weight: 650;
        }

        .profile-summary {
            position: sticky;
            top: 95px;
        }

        .profile-avatar {
            width: 86px;
            height: 86px;
            margin: 0 auto 17px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #061108;
            background: linear-gradient(145deg, #37eb79, #13bd52);
            border: 5px solid rgba(255, 255, 255, 0.06);
            border-radius: 50%;
            font-size: 32px;
            font-weight: 900;
            box-shadow: 0 15px 35px rgba(30, 215, 96, 0.17);
        }

        .profile-name {
            margin: 0;
            overflow: hidden;
            color: #ffffff;
            font-size: 18px;
            font-weight: 850;
            text-align: center;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .profile-email {
            margin: 6px 0 22px;
            overflow: hidden;
            color: var(--text-secondary);
            font-size: 11px;
            text-align: center;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .profile-detail-list {
            display: flex;
            flex-direction: column;
            gap: 11px;
        }

        .profile-detail {
            padding: 12px 13px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            background-color: #0c110e;
            border: 1px solid var(--border);
            border-radius: 11px;
        }

        .profile-detail-label {
            color: var(--text-secondary);
            font-size: 11px;
        }

        .profile-detail-value {
            color: #ffffff;
            font-size: 11px;
            font-weight: 800;
            text-align: right;
        }

        .premium-badge {
            padding: 5px 8px;
            color: var(--primary);
            background-color: rgba(30, 215, 96, 0.10);
            border: 1px solid rgba(30, 215, 96, 0.20);
            border-radius: 999px;
            font-size: 9px;
            font-weight: 850;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        @@media (max-width: 900px) {
            .settings-page {
                padding: 22px;
            }

            .settings-grid {
                grid-template-columns: 1fr;
            }

            .profile-summary {
                position: static;
            }
        }

        @@media (max-width: 560px) {
            .settings-page {
                padding: 16px;
            }

            .settings-card {
                padding: 20px;
            }

            .settings-actions {
                flex-direction: column-reverse;
            }

            .settings-cancel-button,
            .settings-save-button {
                width: 100%;
            }
        }
    </style>
}

<main class="main-content">

    <header class="topbar">

        <div class="topbar-left">

            <button type="button"
                    class="menu-button"
                    id="menuButton">
                ☰
            </button>

            <div class="page-heading">

                <h1>
                    Hesap Ayarları
                </h1>

                <p>
                    Profil ve güvenlik bilgilerini buradan yönetebilirsin.
                </p>

            </div>

        </div>

    </header>

    <div class="settings-page">

        <div class="settings-container">

            <div class="settings-header">

                <h2 class="settings-title">
                    Hesap bilgilerin
                </h2>

                <p class="settings-description">
                    Kullanıcı adını, e-posta adresini ve şifreni güncelle.
                </p>

            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="settings-success">
                    ✓ @TempData["SuccessMessage"]
                </div>
            }

            <div class="settings-grid">

                <section class="settings-card">

                    <h3 class="settings-card-title">
                        Profil bilgileri
                    </h3>

                    <p class="settings-card-description">
                        Bu bilgiler hesabını tanımlamak ve giriş işlemlerini gerçekleştirmek için kullanılır.
                    </p>

                    <form asp-controller="UserDashboard"
                          asp-action="UserSettings"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="settings-validation-summary">
                        </div>

                        <input asp-for="UserId"
                               type="hidden" />

                        <div class="settings-form-group">

                            <label asp-for="Username"
                                   class="settings-label">
                            </label>

                            <input asp-for="Username"
                                   class="settings-input"
                                   placeholder="Kullanıcı adını gir" />

                            <span asp-validation-for="Username"
                                  class="settings-validation">
                            </span>

                        </div>

                        <div class="settings-form-group">

                            <label asp-for="Email"
                                   class="settings-label">
                            </label>

                            <input asp-for="Email"
                                   class="settings-input"
                                   placeholder="E-posta adresini gir" />

                            <span asp-validation-for="Email"
                                  class="settings-validation">
                            </span>

                        </div>

                        <div class="settings-divider"></div>

                        <div class="password-heading">

                            <h4 class="password-title">
                                Şifre değiştir
                            </h4>

                            <p class="password-description">
                                Şifreni değiştirmek istemiyorsan aşağıdaki alanları boş bırakabilirsin.
                            </p>

                        </div>

                        <div class="settings-form-group">

                            <label asp-for="CurrentPassword"
                                   class="settings-label">
                            </label>

                            <input asp-for="CurrentPassword"
                                   class="settings-input"
                                   placeholder="Mevcut şifreni gir"
                                   autocomplete="current-password" />

                            <span asp-validation-for="CurrentPassword"
                                  class="settings-validation">
                            </span>

                        </div>

                        <div class="settings-form-group">

                            <label asp-for="NewPassword"
                                   class="settings-label">
                            </label>

                            <input asp-for="NewPassword"
                                   class="settings-input"
                                   placeholder="Yeni şifreni gir"
                                   autocomplete="new-password" />

                            <span asp-validation-for="NewPassword"
                                  class="settings-validation">
                            </span>

                        </div>

                        <div class="settings-form-group">

                            <label asp-for="ConfirmNewPassword"
                                   class="settings-label">
                            </label>

                            <input asp-for="ConfirmNewPassword"
                                   class="settings-input"
                                   placeholder="Yeni şifreni tekrar gir"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmNewPassword"
                                  class="settings-validation">
                            </span>

                        </div>

                        <div class="settings-actions">

                            <a asp-controller="UserDashboard"
                               asp-action="Index"
                               class="settings-cancel-button">
                                Vazgeç
                            </a>

                            <button type="submit"
                                    class="settings-save-button">
                                Değişiklikleri Kaydet
                            </button>

                        </div>

                    </form>

                </section>

                <aside class="settings-card profile-summary">

                    <div class="profile-avatar">
                        @(string.IsNullOrWhiteSpace(Model.Username)
                            ? "?"
                            : Model.Username.Substring(0, 1).ToUpper())
                    </div>

                    <h3 class="profile-name">
                        @Model.Username
                    </h3>

                    <p class="profile-email">
                        @Model.Email
                    </p>

                    <div class="profile-detail-list">

                        <div class="profile-detail">

                            <span class="profile-detail-label">
                                Hesap rolü
                            </span>

                            <span class="profile-detail-value">
                                @Model.RoleName
                            </span>

                        </div>

                        <div class="profile-detail">

                            <span class="profile-detail-label">
                                Üyelik
                            </span>

                            @if (Model.IsPremium)
                            {
                                <span class="premium-badge">
                                    Premium
                                </span>
                            }
                            else
                            {
                                <span class="profile-detail-value">
                                    Standart
                                </span>
                            }

                        </div>

                        <div class="profile-detail">

                            <span class="profile-detail-label">
                                Beğenilen şarkı
                            </span>

                            <span class="profile-detail-value">
                                @Model.LikedSongCount
                            </span>

                        </div>

                        <div class="profile-detail">

                            <span class="profile-detail-label">
                                Takip edilen
                            </span>

                            <span class="profile-detail-value">
                                @Model.FollowedArtistCount
                            </span>

                        </div>

                    </div>

                </aside>

            </div>

        </div>

    </div>

</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}