@model MusicProject.ViewModels.UserDashboard.AllArtistsViewModel

@{
    ViewData["Title"] = "Tüm Sanatçılar";
    Layout = "_UserLayout";

    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    var hasActiveFilters =
        !string.IsNullOrWhiteSpace(Model.Search) ||
        !string.IsNullOrWhiteSpace(Model.Country) ||
        Model.FollowedOnly ||
        Model.Sort != "name-asc";
}

@section Styles {
    <style>
        .all-artists-content {
            padding: 34px;
        }

        .artists-hero {
            padding: 34px;
            display: flex;
            align-items: center;
            gap: 25px;
            background: linear-gradient(130deg, rgba(30, 215, 96, 0.24), rgba(18, 23, 19, 0.98) 65%);
            border: 1px solid rgba(30, 215, 96, 0.20);
            border-radius: 22px;
        }

        .artists-hero-icon {
            width: 125px;
            height: 125px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: #071008;
            background-color: var(--primary);
            border-radius: 50%;
            font-size: 52px;
            box-shadow: 0 18px 45px rgba(0, 0, 0, 0.30);
        }

        .artists-hero-label {
            color: var(--primary);
            font-size: 12px;
            font-weight: 850;
            letter-spacing: 1.3px;
            text-transform: uppercase;
        }

        .artists-hero-title {
            margin-top: 10px;
            font-size: clamp(30px, 4vw, 48px);
        }

        .artists-hero-description {
            margin-top: 10px;
            color: var(--text-secondary);
            font-size: 14px;
        }

        .artists-hero-count {
            margin-top: 15px;
            font-size: 13px;
            font-weight: 800;
        }

        .artist-filter-panel {
            margin-top: 24px;
            padding: 20px;
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 18px;
        }

        .artist-filter-form {
            display: grid;
            grid-template-columns: minmax(220px, 1.4fr) minmax(160px, 0.8fr) minmax(180px, 0.9fr) auto;
            gap: 14px;
            align-items: end;
        }

        .filter-group {
            min-width: 0;
        }

        .filter-label {
            margin-bottom: 7px;
            display: block;
            color: var(--text-secondary);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.7px;
            text-transform: uppercase;
        }

        .filter-input,
        .filter-select {
            width: 100%;
            height: 44px;
            padding: 0 14px;
            color: #ffffff;
            background-color: #0c110e;
            border: 1px solid var(--border);
            border-radius: 11px;
            outline: none;
            transition: 0.2s;
        }

            .filter-input:focus,
            .filter-select:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(30, 215, 96, 0.10);
            }

            .filter-input::placeholder {
                color: #69746d;
            }

            .filter-select option {
                color: #ffffff;
                background-color: #101612;
            }

        .filter-followed-wrapper {
            margin-top: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .filter-checkbox-label {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: #ffffff;
            font-size: 11px;
            font-weight: 750;
            cursor: pointer;
        }

        .filter-checkbox {
            width: 16px;
            height: 16px;
            accent-color: var(--primary);
        }

        .filter-actions {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .filter-submit-button,
        .filter-clear-button {
            min-height: 42px;
            padding: 0 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            font-size: 11px;
            font-weight: 850;
            text-decoration: none;
            cursor: pointer;
            transition: 0.2s;
        }

        .filter-submit-button {
            color: #061108;
            background-color: var(--primary);
            border: 1px solid var(--primary);
        }

            .filter-submit-button:hover {
                background-color: #39eb79;
                transform: translateY(-1px);
            }

        .filter-clear-button {
            color: #ffffff;
            background-color: transparent;
            border: 1px solid var(--border);
        }

            .filter-clear-button:hover {
                color: var(--primary);
                border-color: rgba(30, 215, 96, 0.32);
            }

        .filter-result-info {
            margin-top: 17px;
            padding-top: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            color: var(--text-secondary);
            border-top: 1px solid var(--border);
            font-size: 11px;
        }

        .filter-result-count {
            color: var(--primary);
            font-weight: 850;
        }

        .all-artists-grid {
            margin-top: 28px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
            gap: 20px;
        }

        .all-artist-card {
            padding: 22px;
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 20px;
            text-align: center;
            transition: 0.2s;
        }

            .all-artist-card:hover {
                background-color: var(--card-hover);
                transform: translateY(-4px);
            }

        .all-artist-link {
            display: block;
            color: inherit;
            text-decoration: none;
        }

        .all-artist-image {
            width: 105px;
            height: 105px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #071008;
            background: linear-gradient(135deg, var(--primary), #8cffb4);
            border-radius: 50%;
            font-size: 38px;
            font-weight: 900;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
        }

        .all-artist-name {
            margin-top: 18px;
            color: white;
            font-size: 16px;
            font-weight: 850;
            transition: 0.2s;
        }

        .all-artist-link:hover .all-artist-name {
            color: var(--primary);
        }

        .all-artist-label {
            margin-top: 6px;
            color: var(--text-secondary);
            font-size: 11px;
        }

        .all-artist-meta {
            margin-top: 10px;
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 6px;
        }

        .artist-meta-badge {
            padding: 5px 8px;
            color: var(--text-secondary);
            background-color: rgba(255, 255, 255, 0.035);
            border: 1px solid var(--border);
            border-radius: 999px;
            font-size: 9px;
        }

        .follow-form {
            margin-top: 17px;
        }

        .follow-button {
            width: 100%;
            padding: 10px 14px;
            color: white;
            background-color: transparent;
            border: 1px solid var(--border);
            border-radius: 22px;
            font-size: 11px;
            font-weight: 850;
            cursor: pointer;
            transition: 0.2s;
        }

            .follow-button:hover {
                color: #071008;
                background-color: var(--primary);
                border-color: var(--primary);
            }

            .follow-button.followed {
                color: #071008;
                background-color: var(--primary);
                border-color: var(--primary);
            }

        .empty-state {
            margin-top: 28px;
            padding: 70px 25px;
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 19px;
            text-align: center;
        }

        .empty-icon {
            color: var(--primary);
            font-size: 55px;
        }

        .empty-title {
            margin-top: 18px;
            font-size: 22px;
        }

        .empty-description {
            max-width: 460px;
            margin: 10px auto 22px;
            color: var(--text-secondary);
            font-size: 13px;
            line-height: 1.6;
        }

        .home-button {
            display: inline-block;
            padding: 12px 20px;
            color: #061108;
            background-color: var(--primary);
            border-radius: 23px;
            font-size: 12px;
            font-weight: 850;
            text-decoration: none;
        }

        @@media (max-width: 1050px) {
            .artist-filter-form {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 800px) {
            .all-artists-content {
                padding: 20px 16px;
            }

            .artists-hero {
                align-items: flex-start;
                flex-direction: column;
            }

            .artists-hero-icon {
                width: 95px;
                height: 95px;
                font-size: 40px;
            }

            .filter-followed-wrapper,
            .filter-result-info {
                align-items: flex-start;
                flex-direction: column;
            }
        }

        @@media (max-width: 560px) {
            .artist-filter-form {
                grid-template-columns: 1fr;
            }

            .filter-actions {
                width: 100%;
                flex-direction: column;
            }

            .filter-submit-button,
            .filter-clear-button {
                width: 100%;
            }
        }
    </style>
}

<main class="main-content">

    <header class="topbar">

        <div class="topbar-left">

            <button type="button"
                    class="menu-button"
                    id="menuButton">
                ☰
            </button>

            <div class="page-heading">

                <h1>
                    Tüm Sanatçılar
                </h1>

                <p>
                    Platformdaki bütün sanatçıları keşfet.
                </p>

            </div>

        </div>

        <a asp-controller="UserDashboard"
           asp-action="Index"
           class="secondary-button">
            ← Ana Sayfaya Dön
        </a>

    </header>

    <div class="all-artists-content">

        <section class="artists-hero">

            <div class="artists-hero-icon">
                ★
            </div>

            <div>

                <p class="artists-hero-label">
                    Sanatçı kataloğu
                </p>

                <h2 class="artists-hero-title">
                    Tüm Sanatçılar
                </h2>

                <p class="artists-hero-description">
                    Platformda bulunan sanatçıları keşfet ve beğendiklerini takip et.
                </p>

                <p class="artists-hero-count">
                    @Model.TotalArtistCount sanatçı
                </p>

            </div>

        </section>

        <section class="artist-filter-panel">

            <form asp-controller="UserDashboard"
                  asp-action="AllArtists"
                  method="get">

                <div class="artist-filter-form">

                    <div class="filter-group">

                        <label for="search"
                               class="filter-label">
                            Sanatçı ara
                        </label>

                        <input type="text"
                               id="search"
                               name="search"
                               value="@Model.Search"
                               class="filter-input"
                               placeholder="Sanatçı adı yaz..." />

                    </div>

                    <div class="filter-group">

                        <label for="country"
                               class="filter-label">
                            Ülke
                        </label>

                        <select id="country"
                                name="country"
                                class="filter-select">

                            <option value="">
                                Tüm ülkeler
                            </option>

                            @foreach (var countryName in Model.Countries)
                            {
                                if (Model.Country.Equals(countryName, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@countryName" selected>
                                        @countryName
                                    </option>
                                }
                                else
                                {
                                    <option value="@countryName">
                                        @countryName
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="filter-group">

                        <label for="sort"
                               class="filter-label">
                            Sırala
                        </label>

                        <select id="sort"
                                name="sort"
                                class="filter-select">

                            @if (Model.Sort == "name-asc")
                            {
                                <option value="name-asc" selected>
                                    İsme göre A–Z
                                </option>
                            }
                            else
                            {
                                <option value="name-asc">
                                    İsme göre A–Z
                                </option>
                            }

                            @if (Model.Sort == "name-desc")
                            {
                                <option value="name-desc" selected>
                                    İsme göre Z–A
                                </option>
                            }
                            else
                            {
                                <option value="name-desc">
                                    İsme göre Z–A
                                </option>
                            }

                            @if (Model.Sort == "year-newest")
                            {
                                <option value="year-newest" selected>
                                    Çıkış yılı: Yeni–Eski
                                </option>
                            }
                            else
                            {
                                <option value="year-newest">
                                    Çıkış yılı: Yeni–Eski
                                </option>
                            }

                            @if (Model.Sort == "year-oldest")
                            {
                                <option value="year-oldest" selected>
                                    Çıkış yılı: Eski–Yeni
                                </option>
                            }
                            else
                            {
                                <option value="year-oldest">
                                    Çıkış yılı: Eski–Yeni
                                </option>
                            }

                        </select>

                    </div>

                    <div class="filter-actions">

                        <button type="submit"
                                class="filter-submit-button">
                            Filtrele
                        </button>

                        @if (hasActiveFilters)
                        {
                            <a asp-controller="UserDashboard"
                               asp-action="AllArtists"
                               class="filter-clear-button">
                                Temizle
                            </a>
                        }

                    </div>

                </div>

                <div class="filter-followed-wrapper">

                    <label class="filter-checkbox-label">

                        @if (Model.FollowedOnly)
                        {
                            <input type="checkbox"
                                   name="followedOnly"
                                   value="true"
                                   checked
                                   class="filter-checkbox" />
                        }
                        else
                        {
                            <input type="checkbox"
                                   name="followedOnly"
                                   value="true"
                                   class="filter-checkbox" />
                        }

                        Yalnızca takip ettiklerimi göster

                    </label>

                </div>

                <div class="filter-result-info">

                    <span>
                        Gösterilen sonuç:
                        <strong class="filter-result-count">
                            @Model.Artists.Count()
                        </strong>
                    </span>

                    @if (hasActiveFilters)
                    {
                        <span>
                            Filtreler aktif
                        </span>
                    }

                </div>

            </form>

        </section>

        @if (Model.Artists.Any())
        {
            <section class="all-artists-grid">

                @foreach (var artist in Model.Artists)
                {
                    var isFollowed = Model.FollowedArtistIds.Contains(artist.ArtistId);

                    var followButtonClass = isFollowed
                        ? "follow-button followed"
                        : "follow-button";

                    var followButtonTitle = isFollowed
                        ? "Takipten çık"
                        : "Sanatçıyı takip et";

                    var followButtonText = isFollowed
                        ? "Takip Ediliyor"
                        : "Takip Et";

                    <article class="all-artist-card">

                        <a asp-controller="UserDashboard"
                           asp-action="ArtistDetails"
                           asp-route-artistId="@artist.ArtistId"
                           class="all-artist-link">

                            <div class="all-artist-image">
                                @(string.IsNullOrWhiteSpace(artist.Name)
                                    ? "?"
                                    : artist.Name.Substring(0, 1).ToUpper())
                            </div>

                            <h3 class="all-artist-name">
                                @artist.Name
                            </h3>

                            <p class="all-artist-label">
                                Sanatçı
                            </p>

                            <div class="all-artist-meta">

                                @if (!string.IsNullOrWhiteSpace(artist.Country))
                                {
                                    <span class="artist-meta-badge">
                                        @artist.Country
                                    </span>
                                }

                                @if (artist.DebutYear.HasValue)
                                {
                                    <span class="artist-meta-badge">
                                        Çıkış: @artist.DebutYear
                                    </span>
                                }

                            </div>

                        </a>

                        <form asp-controller="UserDashboard"
                              asp-action="ToggleFollow"
                              method="post"
                              class="follow-form">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="artistId"
                                   value="@artist.ArtistId" />

                            <input type="hidden"
                                   name="returnUrl"
                                   value="@currentUrl" />

                            <button type="submit"
                                    class="@followButtonClass"
                                    title="@followButtonTitle">
                                @followButtonText
                            </button>

                        </form>

                    </article>
                }

            </section>
        }
        else
        {
            <section class="empty-state">

                <div class="empty-icon">
                    ★
                </div>

                <h3 class="empty-title">
                    Sanatçı bulunamadı
                </h3>

                <p class="empty-description">
                    Seçtiğin filtrelere uygun sanatçı bulunamadı.
                    Arama değerlerini değiştirerek tekrar deneyebilirsin.
                </p>

                @if (hasActiveFilters)
                {
                    <a asp-controller="UserDashboard"
                       asp-action="AllArtists"
                       class="home-button">
                        Filtreleri Temizle
                    </a>
                }
                else
                {
                    <a asp-controller="UserDashboard"
                       asp-action="Index"
                       class="home-button">
                        Ana Sayfaya Dön
                    </a>
                }

            </section>
        }

    </div>

</main>