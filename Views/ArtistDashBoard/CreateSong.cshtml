@model MusicProject.ViewModels.ArtistDashboard.CreateSongViewModel

@{
    ViewData["Title"] = "Yeni Şarkı";
    ViewData["PageDescription"] = "Yeni bir şarkı oluştur ve yayın ayarlarını belirle.";
    Layout = "_ArtistLayout";
}

@section Styles {
    <style>
        .create-song-content {
            max-width: 920px;
            margin: 0 auto;
            padding: 32px 34px 50px;
        }

        .create-song-header {
            padding: 28px;
            display: flex;
            align-items: center;
            gap: 20px;
            background: linear-gradient(125deg, rgba(30, 215, 96, 0.18), rgba(18, 23, 19, 0.97) 65%);
            border: 1px solid rgba(30, 215, 96, 0.20);
            border-radius: 21px;
        }

        .create-song-header-icon {
            width: 82px;
            height: 82px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: #071008;
            background-color: var(--primary);
            border-radius: 18px;
            font-size: 37px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.28);
        }

        .create-song-header-label {
            margin: 0;
            color: var(--primary);
            font-size: 11px;
            font-weight: 850;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .create-song-header-title {
            margin: 7px 0 0;
            color: #ffffff;
            font-size: clamp(25px, 4vw, 36px);
        }

        .create-song-header-description {
            margin: 8px 0 0;
            color: var(--text-secondary);
            font-size: 13px;
            line-height: 1.6;
        }

        .create-song-card {
            margin-top: 22px;
            padding: 28px;
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 19px;
        }

        .create-song-validation-summary {
            margin-bottom: 22px;
            padding: 14px 16px;
            color: #ff9b9b;
            background-color: rgba(255, 92, 92, 0.09);
            border: 1px solid rgba(255, 92, 92, 0.22);
            border-radius: 11px;
            font-size: 13px;
        }

        .validation-summary-valid {
            display: none;
        }

        .create-song-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 21px;
        }

        .create-song-group {
            margin-bottom: 3px;
        }

            .create-song-group.full-width {
                grid-column: 1 / -1;
            }

        .create-song-label {
            display: block;
            margin-bottom: 8px;
            color: #ffffff;
            font-size: 13px;
            font-weight: 750;
        }

        .create-song-input,
        .create-song-select {
            width: 100%;
            padding: 13px 15px;
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.045);
            border: 1px solid var(--border);
            border-radius: 11px;
            outline: none;
            font-size: 14px;
            transition: 0.2s;
        }

        .create-song-select {
            cursor: pointer;
        }

            .create-song-select option {
                color: #ffffff;
                background-color: #151a17;
            }

            .create-song-input:focus,
            .create-song-select:focus {
                background-color: rgba(255, 255, 255, 0.065);
                border-color: rgba(30, 215, 96, 0.65);
                box-shadow: 0 0 0 3px rgba(30, 215, 96, 0.08);
            }

        .audio-upload-box {
            padding: 18px;
            background-color: rgba(30, 215, 96, 0.035);
            border: 1px dashed rgba(30, 215, 96, 0.30);
            border-radius: 13px;
        }

        .audio-upload-input {
            width: 100%;
            color: #dce2de;
            font-size: 12px;
        }

            .audio-upload-input::file-selector-button {
                min-height: 37px;
                margin-right: 12px;
                padding: 0 14px;
                color: #071008;
                background-color: var(--primary);
                border: none;
                border-radius: 9px;
                font-size: 11px;
                font-weight: 800;
                cursor: pointer;
            }

                .audio-upload-input::file-selector-button:hover {
                    background-color: var(--primary-hover);
                }

        .audio-file-info {
            margin-top: 11px;
            display: none;
            padding: 11px 13px;
            color: #dce2de;
            background-color: rgba(255, 255, 255, 0.025);
            border: 1px solid var(--border);
            border-radius: 9px;
            font-size: 11px;
        }

            .audio-file-info.visible {
                display: block;
            }

        .audio-file-name {
            color: var(--primary);
            font-weight: 800;
        }

        .create-song-hint {
            display: block;
            margin-top: 7px;
            color: var(--text-secondary);
            font-size: 11px;
            line-height: 1.5;
        }

        .create-song-validation {
            display: block;
            margin-top: 7px;
            color: #ff8585;
            font-size: 12px;
        }

        .genre-list {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
        }

        .genre-item {
            padding: 11px 12px;
            display: flex;
            align-items: center;
            gap: 9px;
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.035);
            border: 1px solid var(--border);
            border-radius: 10px;
            font-size: 12px;
            cursor: pointer;
        }

            .genre-item:hover {
                border-color: rgba(30, 215, 96, 0.35);
            }

            .genre-item input {
                accent-color: var(--primary);
            }

        .publication-section {
            grid-column: 1 / -1;
            padding: 21px;
            background-color: rgba(30, 215, 96, 0.035);
            border: 1px solid rgba(30, 215, 96, 0.14);
            border-radius: 14px;
        }

            .publication-section.hidden {
                display: none;
            }

        .publication-section-title {
            margin: 0 0 5px;
            color: #ffffff;
            font-size: 15px;
            font-weight: 800;
        }

        .publication-section-description {
            margin: 0 0 19px;
            color: var(--text-secondary);
            font-size: 12px;
            line-height: 1.6;
        }

        .publication-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .scheduled-publish-group {
            display: none;
        }

            .scheduled-publish-group.visible {
                display: block;
            }

        .publication-info {
            grid-column: 1 / -1;
            padding: 13px 15px;
            color: var(--text-secondary);
            background-color: rgba(255, 255, 255, 0.025);
            border: 1px solid var(--border);
            border-radius: 10px;
            font-size: 12px;
            line-height: 1.6;
        }

            .publication-info strong {
                color: var(--primary);
            }

        .album-publication-info {
            grid-column: 1 / -1;
            padding: 14px 16px;
            display: none;
            color: var(--text-secondary);
            background-color: rgba(255, 255, 255, 0.025);
            border: 1px solid var(--border);
            border-radius: 12px;
            font-size: 12px;
            line-height: 1.6;
        }

            .album-publication-info.visible {
                display: block;
            }

            .album-publication-info strong {
                color: var(--primary);
            }

        .create-song-actions {
            margin-top: 24px;
            padding-top: 23px;
            display: flex;
            justify-content: flex-end;
            gap: 11px;
            border-top: 1px solid var(--border);
        }

        .create-song-cancel,
        .create-song-save {
            min-height: 43px;
            padding: 0 19px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            font-size: 12px;
            font-weight: 800;
            text-decoration: none;
            transition: 0.2s;
        }

        .create-song-cancel {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border);
        }

            .create-song-cancel:hover {
                color: var(--primary);
                border-color: rgba(30, 215, 96, 0.35);
            }

        .create-song-save {
            color: #071008;
            background-color: var(--primary);
            border: none;
            cursor: pointer;
        }

            .create-song-save:hover {
                background-color: var(--primary-hover);
                transform: translateY(-2px);
            }

        @@media (max-width: 750px) {
            .create-song-content {
                padding: 22px 16px 40px;
            }

            .create-song-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .create-song-grid,
            .publication-grid {
                grid-template-columns: 1fr;
            }

            .create-song-group.full-width,
            .publication-section,
            .publication-info,
            .album-publication-info {
                grid-column: auto;
            }

            .genre-list {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 520px) {
            .create-song-card {
                padding: 20px;
            }

            .genre-list {
                grid-template-columns: 1fr;
            }

            .create-song-actions {
                flex-direction: column-reverse;
            }

            .create-song-cancel,
            .create-song-save {
                width: 100%;
            }
        }
    </style>
}

<div class="create-song-content">

    <section class="create-song-header">

        <div class="create-song-header-icon">
            ♪
        </div>

        <div>

            <p class="create-song-header-label">
                Şarkı yönetimi
            </p>

            <h2 class="create-song-header-title">
                Yeni Şarkı Oluştur
            </h2>

            <p class="create-song-header-description">
                Şarkı bilgilerini doldur, MP3 dosyanı yükle, türlerini seç ve yayın zamanını belirle.
            </p>

        </div>

    </section>

    <section class="create-song-card">

        <form asp-controller="ArtistDashboard"
              asp-action="CreateSong"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="create-song-validation-summary">
            </div>

            <div class="create-song-grid">

                <div class="create-song-group full-width">

                    <label asp-for="Title"
                           class="create-song-label">
                        Şarkı Adı
                    </label>

                    <input asp-for="Title"
                           class="create-song-input"
                           placeholder="Şarkı adını yaz" />

                    <span asp-validation-for="Title"
                          class="create-song-validation">
                    </span>

                </div>

                <div class="create-song-group full-width">

                    <label asp-for="AudioFile"
                           class="create-song-label">
                        MP3 Dosyası
                    </label>

                    <div class="audio-upload-box">

                        <input asp-for="AudioFile"
                               id="audioFileInput"
                               type="file"
                               accept=".mp3,audio/mpeg"
                               class="audio-upload-input" />

                        <span class="create-song-hint">
                            Yalnızca MP3 yükleyebilirsin. Maksimum dosya boyutu 30 MB.
                        </span>

                        <div id="audioFileInfo"
                             class="audio-file-info">

                            Seçilen dosya:
                            <span id="audioFileName"
                                  class="audio-file-name">
                            </span>

                            <span id="audioFileSize">
                            </span>

                        </div>

                    </div>

                    <span asp-validation-for="AudioFile"
                          class="create-song-validation">
                    </span>

                </div>

                <div class="create-song-group full-width">

                    <label asp-for="AlbumId"
                           class="create-song-label">
                        Albüm
                    </label>

                    <select asp-for="AlbumId"
                            asp-items="Model.AlbumOptions"
                            id="albumSelect"
                            class="create-song-select">

                        <option value="">
                            Albümsüz / Single
                        </option>

                    </select>

                    <span class="create-song-hint">
                        Albüm seçersen şarkının yayın durumunu albüm belirler.
                    </span>

                    <span asp-validation-for="AlbumId"
                          class="create-song-validation">
                    </span>

                </div>

                <div class="create-song-group full-width">

                    <span class="create-song-label">
                        Türler
                    </span>

                    <div class="genre-list">

                        @foreach (var genre in Model.GenreOptions)
                        {
                            var genreId = int.Parse(genre.Value);
                            var isChecked = Model.SelectedGenreIds.Contains(genreId);

                            <label class="genre-item">

                                @if (isChecked)
                                {
                                    <input type="checkbox"
                                           name="SelectedGenreIds"
                                           value="@genre.Value"
                                           checked />
                                }
                                else
                                {
                                    <input type="checkbox"
                                           name="SelectedGenreIds"
                                           value="@genre.Value" />
                                }

                                <span>
                                    @genre.Text
                                </span>

                            </label>
                        }

                    </div>

                    <span asp-validation-for="SelectedGenreIds"
                          class="create-song-validation">
                    </span>

                </div>

                <div id="albumPublicationInfo"
                     class="album-publication-info">

                    <strong>Albüm yayını:</strong>
                    Bu şarkının bağımsız bir yayın tarihi olmayacak.
                    Şarkı, seçtiğin albümün yayın durumunu takip edecek.

                </div>

                <section id="publicationSection"
                         class="publication-section">

                    <h3 class="publication-section-title">
                        Single Yayın Ayarları
                    </h3>

                    <p class="publication-section-description">
                        Albümsüz şarkının ne zaman kullanıcılar tarafından görülebileceğini seç.
                    </p>

                    <div class="publication-grid">

                        <div class="create-song-group">

                            <label asp-for="PublicationStatus"
                                   class="create-song-label">
                                Yayın Durumu
                            </label>

                            <select asp-for="PublicationStatus"
                                    id="publicationStatusSelect"
                                    class="create-song-select">

                                <option value="1">
                                    Taslak olarak kaydet
                                </option>

                                <option value="2">
                                    Cuma günü için planla
                                </option>

                                <option value="3">
                                    Hemen yayınla
                                </option>

                            </select>

                            <span asp-validation-for="PublicationStatus"
                                  class="create-song-validation">
                            </span>

                        </div>

                        <div id="scheduledPublishGroup"
                             class="create-song-group scheduled-publish-group">

                            <label asp-for="ScheduledPublishAtLocal"
                                   class="create-song-label">
                                Planlanan Yayın Zamanı
                            </label>

                            <input asp-for="ScheduledPublishAtLocal"
                                   id="scheduledPublishInput"
                                   type="datetime-local"
                                   class="create-song-input" />

                            <span class="create-song-hint">
                                Türkiye saatine göre gelecekteki bir cuma günü seçmelisin.
                            </span>

                            <span asp-validation-for="ScheduledPublishAtLocal"
                                  class="create-song-validation">
                            </span>

                        </div>

                        <div id="publicationInfo"
                             class="publication-info">
                        </div>

                    </div>

                </section>

            </div>

            <div class="create-song-actions">

                <a asp-controller="ArtistDashboard"
                   asp-action="MySongs"
                   class="create-song-cancel">
                    Vazgeç
                </a>

                <button type="submit"
                        id="createSongButton"
                        class="create-song-save">
                    Taslak Olarak Kaydet
                </button>

            </div>

        </form>

    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const albumSelect =
                document.getElementById("albumSelect");

            const publicationSection =
                document.getElementById("publicationSection");

            const albumPublicationInfo =
                document.getElementById("albumPublicationInfo");

            const publicationStatusSelect =
                document.getElementById("publicationStatusSelect");

            const scheduledPublishGroup =
                document.getElementById("scheduledPublishGroup");

            const scheduledPublishInput =
                document.getElementById("scheduledPublishInput");

            const publicationInfo =
                document.getElementById("publicationInfo");

            const createSongButton =
                document.getElementById("createSongButton");

            const audioFileInput =
                document.getElementById("audioFileInput");

            const audioFileInfo =
                document.getElementById("audioFileInfo");

            const audioFileName =
                document.getElementById("audioFileName");

            const audioFileSize =
                document.getElementById("audioFileSize");

            function updatePublicationFields() {
                if (!publicationStatusSelect ||
                    !scheduledPublishGroup ||
                    !scheduledPublishInput ||
                    !publicationInfo ||
                    !createSongButton) {
                    return;
                }

                const selectedStatus =
                    publicationStatusSelect.value;

                if (selectedStatus === "2") {
                    scheduledPublishGroup.classList.add("visible");
                    scheduledPublishInput.required = true;

                    publicationInfo.innerHTML =
                        "<strong>Planlı yayın:</strong> Single seçilen cuma günü ve saatte otomatik olarak yayına alınacaktır.";

                    createSongButton.textContent =
                        "Single'ı Planla";

                    return;
                }

                scheduledPublishGroup.classList.remove("visible");
                scheduledPublishInput.required = false;
                scheduledPublishInput.value = "";

                if (selectedStatus === "3") {
                    publicationInfo.innerHTML =
                        "<strong>Hemen yayınla:</strong> Single oluşturulduğu anda kullanıcıların kataloğunda yayınlanır.";

                    createSongButton.textContent =
                        "Şarkıyı Yayınla";

                    return;
                }

                publicationInfo.innerHTML =
                    "<strong>Taslak:</strong> Single yalnızca sanatçı panelinde görünür ve daha sonra düzenlenebilir.";

                createSongButton.textContent =
                    "Taslak Olarak Kaydet";
            }

            function updateAlbumBehavior() {
                if (!albumSelect ||
                    !publicationSection ||
                    !albumPublicationInfo ||
                    !createSongButton) {
                    return;
                }

                const hasAlbum =
                    albumSelect.value !== "";

                if (hasAlbum) {
                    publicationSection.classList.add("hidden");
                    albumPublicationInfo.classList.add("visible");

                    if (scheduledPublishInput) {
                        scheduledPublishInput.required = false;
                    }

                    createSongButton.textContent =
                        "Şarkıyı Albüme Ekle";

                    return;
                }

                publicationSection.classList.remove("hidden");
                albumPublicationInfo.classList.remove("visible");

                updatePublicationFields();
            }

            function updateAudioFileInfo() {
                if (!audioFileInput ||
                    !audioFileInfo ||
                    !audioFileName ||
                    !audioFileSize) {
                    return;
                }

                const file = audioFileInput.files[0];

                if (!file) {
                    audioFileInfo.classList.remove("visible");
                    audioFileName.textContent = "";
                    audioFileSize.textContent = "";

                    return;
                }

                audioFileName.textContent = file.name;

                const megabytes =
                    file.size / 1024 / 1024;

                audioFileSize.textContent =
                    ` — ${megabytes.toFixed(2)} MB`;

                audioFileInfo.classList.add("visible");
            }

            if (publicationStatusSelect) {
                publicationStatusSelect.addEventListener(
                    "change",
                    updatePublicationFields);
            }

            if (albumSelect) {
                albumSelect.addEventListener(
                    "change",
                    updateAlbumBehavior);
            }

            if (audioFileInput) {
                audioFileInput.addEventListener(
                    "change",
                    updateAudioFileInfo);
            }

            updatePublicationFields();
            updateAlbumBehavior();
            updateAudioFileInfo();
        });
    </script>
}