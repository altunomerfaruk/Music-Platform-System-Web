@model MusicProject.ViewModels.ArtistDashboard.ArtistAlbumDetailsViewModel

@{
    ViewData["Title"] = "Albüm Detayı";
    ViewData["PageDescription"] = "Albüm bilgilerini ve şarkı performanslarını görüntüle.";
    Layout = "_ArtistLayout";

    var albumDescription = string.IsNullOrWhiteSpace(Model.Album.Description)
        ? "Bu albüm için henüz bir açıklama eklenmemiş."
        : Model.Album.Description;
}

@section Styles {
    <style>
        .album-details-content {
            max-width: 1150px;
            margin: 0 auto;
            padding: 32px 34px 50px;
        }

        .album-details-back {
            min-height: 40px;
            margin-bottom: 18px;
            padding: 0 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            color: var(--text-secondary);
            background-color: rgba(255, 255, 255, 0.035);
            border: 1px solid var(--border);
            border-radius: 10px;
            font-size: 12px;
            font-weight: 750;
            transition: 0.2s;
        }

            .album-details-back:hover {
                color: var(--primary);
                border-color: rgba(30, 215, 96, 0.30);
            }

        .admin-hidden-alert {
            margin-bottom: 18px;
            padding: 17px 18px;
            color: #f0c7c7;
            background-color: rgba(255, 92, 92, 0.08);
            border: 1px solid rgba(255, 92, 92, 0.30);
            border-radius: 14px;
        }

        .admin-hidden-alert-title {
            color: #ff7474;
            font-size: 13px;
            font-weight: 900;
        }

        .admin-hidden-alert-description {
            margin-top: 7px;
            font-size: 11px;
            line-height: 1.65;
        }

        .admin-hidden-alert-reason {
            margin-top: 10px;
            padding: 10px 12px;
            color: #ffffff;
            background-color: rgba(0, 0, 0, 0.18);
            border-radius: 9px;
            font-size: 11px;
            line-height: 1.6;
        }

        .admin-hidden-alert-date {
            margin-top: 8px;
            color: #a78d8d;
            font-size: 9px;
        }

        .album-details-hero {
            padding: 30px;
            display: grid;
            grid-template-columns: 220px minmax(0, 1fr);
            gap: 30px;
            background: linear-gradient(125deg, rgba(30, 215, 96, 0.19), rgba(18, 23, 19, 0.97) 67%);
            border: 1px solid rgba(30, 215, 96, 0.20);
            border-radius: 22px;
        }

            .album-details-hero.admin-hidden {
                background: linear-gradient(125deg, rgba(255, 92, 92, 0.10), rgba(18, 23, 19, 0.97) 67%);
                border-color: rgba(255, 92, 92, 0.25);
            }

        .album-details-cover {
            width: 220px;
            height: 220px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            background: radial-gradient(circle at top right, rgba(30, 215, 96, 0.28), transparent 47%), linear-gradient(135deg, #18241c, #0c110e);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            font-size: 72px;
            box-shadow: 0 18px 42px rgba(0, 0, 0, 0.30);
        }

        .album-details-cover-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .album-details-info {
            min-width: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .album-details-label {
            color: var(--primary);
            font-size: 11px;
            font-weight: 850;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .album-details-title {
            margin-top: 9px;
            overflow-wrap: anywhere;
            color: #ffffff;
            font-size: clamp(31px, 5vw, 54px);
            line-height: 1.1;
        }

        .album-details-artist {
            margin-top: 11px;
            color: #dce2de;
            font-size: 14px;
            font-weight: 700;
        }

        .album-details-description {
            max-width: 720px;
            margin-top: 17px;
            color: var(--text-secondary);
            font-size: 13px;
            line-height: 1.75;
        }

        .album-details-meta {
            margin-top: 18px;
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
        }

        .album-details-meta-item {
            min-height: 35px;
            padding: 0 12px;
            display: inline-flex;
            align-items: center;
            color: #dce2de;
            background-color: rgba(255, 255, 255, 0.045);
            border: 1px solid var(--border);
            border-radius: 18px;
            font-size: 11px;
            font-weight: 700;
        }

            .album-details-meta-item.admin-hidden {
                color: #ff8a8a;
                background-color: rgba(255, 92, 92, 0.08);
                border-color: rgba(255, 92, 92, 0.25);
            }

        .album-details-actions {
            margin-top: 22px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .album-details-edit,
        .album-details-add-song {
            min-height: 43px;
            padding: 0 17px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            font-size: 12px;
            font-weight: 800;
            transition: 0.2s;
        }

        .album-details-edit {
            color: #071008;
            background-color: var(--primary);
        }

            .album-details-edit:hover {
                background-color: var(--primary-hover);
                transform: translateY(-2px);
            }

        .album-details-add-song {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.045);
            border: 1px solid var(--border);
        }

            .album-details-add-song:hover {
                color: var(--primary);
                border-color: rgba(30, 215, 96, 0.32);
            }

        .album-details-stat-grid {
            margin-top: 22px;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
        }

        .album-details-stat-card {
            padding: 21px;
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
        }

        .album-details-stat-value {
            color: #ffffff;
            font-size: 27px;
            font-weight: 900;
        }

        .album-details-stat-name {
            margin-top: 6px;
            color: var(--text-secondary);
            font-size: 12px;
        }

        .album-songs-section {
            margin-top: 27px;
        }

        .album-songs-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 15px;
        }

        .album-songs-title {
            color: #ffffff;
            font-size: 21px;
            font-weight: 850;
        }

        .album-songs-description {
            margin-top: 6px;
            color: var(--text-secondary);
            font-size: 12px;
        }

        .album-songs-count {
            color: var(--primary);
            font-size: 12px;
            font-weight: 800;
        }

        .album-song-list {
            margin-top: 17px;
            overflow: hidden;
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 17px;
        }

        .album-song-header,
        .album-song-row {
            display: grid;
            grid-template-columns: 55px minmax(180px, 1fr) 140px 130px 110px;
            align-items: center;
            gap: 14px;
        }

        .album-song-header {
            min-height: 46px;
            padding: 0 18px;
            color: #747e77;
            background-color: rgba(255, 255, 255, 0.022);
            border-bottom: 1px solid var(--border);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

        .album-song-row {
            min-height: 68px;
            padding: 10px 18px;
            border-bottom: 1px solid var(--border);
            transition: 0.2s;
        }

            .album-song-row:last-child {
                border-bottom: none;
            }

            .album-song-row:hover {
                background-color: rgba(255, 255, 255, 0.03);
            }

        .album-song-number {
            color: var(--text-secondary);
            font-size: 12px;
            font-weight: 800;
        }

        .album-song-main {
            min-width: 0;
        }

        .album-song-name {
            overflow: hidden;
            color: #ffffff;
            font-size: 13px;
            font-weight: 800;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .album-song-type {
            margin-top: 4px;
            color: var(--text-secondary);
            font-size: 10px;
        }

        .song-admin-hidden {
            margin-top: 5px;
            color: #ff7777;
            font-size: 9px;
            font-weight: 800;
        }

        .album-song-stat {
            color: #cbd1cd;
            font-size: 11px;
        }

        .album-song-actions {
            display: flex;
            justify-content: flex-end;
        }

        .album-song-edit {
            min-height: 34px;
            padding: 0 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border);
            border-radius: 9px;
            font-size: 10px;
            font-weight: 800;
            transition: 0.2s;
        }

            .album-song-edit:hover {
                color: var(--primary);
                border-color: rgba(30, 215, 96, 0.30);
            }

        .album-songs-empty {
            margin-top: 17px;
            padding: 65px 24px;
            text-align: center;
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 17px;
        }

        .album-songs-empty-icon {
            color: var(--primary);
            font-size: 45px;
        }

        .album-songs-empty-title {
            margin-top: 15px;
            color: #ffffff;
            font-size: 18px;
        }

        .album-songs-empty-description {
            max-width: 460px;
            margin: 8px auto 19px;
            color: var(--text-secondary);
            font-size: 12px;
            line-height: 1.7;
        }

        @@media (max-width: 950px) {
            .album-details-hero {
                grid-template-columns: 180px minmax(0, 1fr);
            }

            .album-details-cover {
                width: 180px;
                height: 180px;
            }

            .album-song-header,
            .album-song-row {
                grid-template-columns: 45px minmax(170px, 1fr) 110px 100px;
            }

            .album-song-likes-column {
                display: none;
            }
        }

        @@media (max-width: 760px) {
            .album-details-content {
                padding: 22px 16px 40px;
            }

            .album-details-hero {
                grid-template-columns: 1fr;
            }

            .album-details-cover {
                width: 180px;
                height: 180px;
            }

            .album-details-stat-grid {
                grid-template-columns: 1fr;
            }

            .album-song-header {
                display: none;
            }

            .album-song-row {
                grid-template-columns: 35px minmax(0, 1fr) auto;
            }

            .album-song-streams-column,
            .album-song-likes-column {
                display: none;
            }
        }

        @@media (max-width: 500px) {
            .album-details-cover {
                width: 150px;
                height: 150px;
            }

            .album-details-actions {
                flex-direction: column;
            }

            .album-details-edit,
            .album-details-add-song {
                width: 100%;
            }
        }
    </style>
}

<div class="album-details-content">

    <a asp-controller="ArtistDashboard"
       asp-action="MyAlbums"
       class="album-details-back">
        ← Albümlerime Dön
    </a>

    @if (Model.Album.IsAdminHidden)
    {
        <div class="admin-hidden-alert">

            <div class="admin-hidden-alert-title">
                🔒 Bu albüm admin tarafından platformdan gizlendi
            </div>

            <div class="admin-hidden-alert-description">
                Albüm sanatçı panelinde görünmeye devam eder ancak normal kullanıcılar
                albümü ve albüme bağlı şarkıları göremez. Bu moderasyon durumunu yalnızca
                yönetici kaldırabilir.
            </div>

            <div class="admin-hidden-alert-reason">
                <strong>Neden:</strong>
                @(string.IsNullOrWhiteSpace(Model.Album.AdminHiddenReason)
                    ? "Neden belirtilmedi."
                    : Model.Album.AdminHiddenReason)
            </div>

            @if (Model.Album.AdminHiddenAtUtc.HasValue)
            {
                <div class="admin-hidden-alert-date">
                    Gizlenme zamanı:
                    @Model.Album.AdminHiddenAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                </div>
            }

        </div>
    }

    <section class="album-details-hero @(Model.Album.IsAdminHidden ? "admin-hidden" : "")">

        <div class="album-details-cover">

            @if (!string.IsNullOrWhiteSpace(Model.Album.CoverImageUrl))
            {
                <img src="@Model.Album.CoverImageUrl"
                     alt="@Model.Album.Name albüm kapağı"
                     class="album-details-cover-image" />
            }
            else
            {
                <span>◉</span>
            }

        </div>

        <div class="album-details-info">

            <p class="album-details-label">
                Albüm
            </p>

            <h2 class="album-details-title">
                @Model.Album.Name
            </h2>

            <p class="album-details-artist">
                @Model.Artist.Name
            </p>

            <p class="album-details-description">
                @albumDescription
            </p>

            <div class="album-details-meta">

                <span class="album-details-meta-item">
                    @Model.Album.ReleaseDate.ToString("dd MMMM yyyy")
                </span>

                <span class="album-details-meta-item">
                    @Model.SongCount şarkı
                </span>

                <span class="album-details-meta-item">
                    @Model.TotalStreams.ToString("N0") dinlenme
                </span>

                @if (Model.Album.IsAdminHidden)
                {
                    <span class="album-details-meta-item admin-hidden">
                        🔒 Admin gizlemesi aktif
                    </span>
                }

            </div>

            <div class="album-details-actions">

                <a asp-controller="ArtistDashboard"
                   asp-action="EditAlbum"
                   asp-route-albumId="@Model.Album.AlbumId"
                   class="album-details-edit">
                    Albümü Düzenle
                </a>

                <a asp-controller="ArtistDashboard"
                   asp-action="CreateSong"
                   asp-route-albumId="@Model.Album.AlbumId"
                   class="album-details-add-song">
                    + Albüme Şarkı Ekle
                </a>

            </div>

        </div>

    </section>

    <section class="album-details-stat-grid">

        <article class="album-details-stat-card">

            <div class="album-details-stat-value">
                @Model.SongCount
            </div>

            <div class="album-details-stat-name">
                Toplam şarkı
            </div>

        </article>

        <article class="album-details-stat-card">

            <div class="album-details-stat-value">
                @Model.TotalStreams.ToString("N0")
            </div>

            <div class="album-details-stat-name">
                Toplam dinlenme
            </div>

        </article>

        <article class="album-details-stat-card">

            <div class="album-details-stat-value">
                @Model.TotalLikes.ToString("N0")
            </div>

            <div class="album-details-stat-name">
                Toplam beğeni
            </div>

        </article>

    </section>

    <section class="album-songs-section">

        <div class="album-songs-header">

            <div>

                <h3 class="album-songs-title">
                    Albümdeki Şarkılar
                </h3>

                <p class="album-songs-description">
                    Albüme bağlı şarkıların performans bilgileri.
                </p>

            </div>

            <span class="album-songs-count">
                @Model.SongCount şarkı
            </span>

        </div>

        @if (Model.Album.Songs.Any())
        {
            <div class="album-song-list">

                <div class="album-song-header">

                    <span>#</span>

                    <span>Şarkı</span>

                    <span class="album-song-streams-column">
                        Dinlenme
                    </span>

                    <span class="album-song-likes-column">
                        Beğeni
                    </span>

                    <span></span>

                </div>

                @{
                    var songNumber = 1;
                }

                @foreach (var song in Model.Album.Songs)
                {
                    <div class="album-song-row">

                        <span class="album-song-number">
                            @songNumber
                        </span>

                        <div class="album-song-main">

                            <div class="album-song-name">
                                @song.Title
                            </div>

                            <div class="album-song-type">
                                @Model.Album.Name
                            </div>

                            @if (song.IsAdminHidden)
                            {
                                <div class="song-admin-hidden">
                                    🔒 Bu şarkı ayrıca admin tarafından gizlendi
                                </div>
                            }
                            else if (Model.Album.IsAdminHidden)
                            {
                                <div class="song-admin-hidden">
                                    🔒 Albüm gizli olduğu için kullanıcıya kapalı
                                </div>
                            }

                        </div>

                        <span class="album-song-stat album-song-streams-column">
                            @song.TotalStreams.ToString("N0")
                        </span>

                        <span class="album-song-stat album-song-likes-column">
                            @song.TotalLikes.ToString("N0")
                        </span>

                        <div class="album-song-actions">

                            <a asp-controller="ArtistDashboard"
                               asp-action="EditSong"
                               asp-route-songId="@song.SongId"
                               class="album-song-edit">
                                Düzenle
                            </a>

                        </div>

                    </div>

                    songNumber++;
                }

            </div>
        }
        else
        {
            <div class="album-songs-empty">

                <div class="album-songs-empty-icon">
                    ♫
                </div>

                <h3 class="album-songs-empty-title">
                    Bu albümde henüz şarkı yok
                </h3>

                <p class="album-songs-empty-description">
                    Yeni bir şarkı oluşturup bu albümü seçerek albüm kataloğunu doldurabilirsin.
                </p>

                <a asp-controller="ArtistDashboard"
                   asp-action="CreateSong"
                   asp-route-albumId="@Model.Album.AlbumId"
                   class="album-details-edit">
                    Albüme Şarkı Ekle
                </a>

            </div>
        }

    </section>

</div>