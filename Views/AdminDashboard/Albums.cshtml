@using MusicProject.Models.Enums
@model MusicProject.ViewModels.AdminDashboard.AdminAlbumsViewModel

@{
    ViewData["Title"] = "Albüm Yönetimi";
    ViewData["PageDescription"] = "Platformdaki albümleri, yayın durumlarını ve moderasyon işlemlerini yönet.";
    Layout = "_AdminLayout";
}

@section Styles {
    <style>
        .albums-content {
            padding: 32px 34px 50px;
        }

        .albums-hero {
            padding: 29px 31px;
            background: linear-gradient(125deg, rgba(30, 215, 96, 0.18), rgba(18, 23, 19, 0.97) 65%);
            border: 1px solid rgba(30, 215, 96, 0.20);
            border-radius: 21px;
        }

        .albums-hero-label {
            color: var(--primary);
            font-size: 11px;
            font-weight: 850;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .albums-hero-title {
            margin-top: 7px;
            color: #ffffff;
            font-size: clamp(27px, 4vw, 38px);
        }

        .albums-hero-description {
            max-width: 720px;
            margin-top: 8px;
            color: var(--text-secondary);
            font-size: 13px;
            line-height: 1.7;
        }

        .message {
            margin-top: 18px;
            padding: 13px 16px;
            border-radius: 11px;
            font-size: 12px;
            font-weight: 700;
        }

        .message-success {
            color: var(--primary);
            background-color: rgba(30, 215, 96, 0.09);
            border: 1px solid rgba(30, 215, 96, 0.25);
        }

        .message-error {
            color: var(--danger);
            background-color: rgba(255, 92, 92, 0.08);
            border: 1px solid rgba(255, 92, 92, 0.25);
        }

        .albums-stat-grid {
            margin-top: 22px;
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 14px;
        }

        .albums-stat-card {
            padding: 19px;
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
        }

        .albums-stat-label {
            color: var(--text-secondary);
            font-size: 10px;
        }

        .albums-stat-value {
            margin-top: 9px;
            color: #ffffff;
            font-size: 25px;
            font-weight: 900;
        }

        .albums-panel {
            margin-top: 22px;
            overflow: hidden;
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 18px;
        }

        .albums-panel-header {
            padding: 20px 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            border-bottom: 1px solid var(--border);
        }

        .albums-filter-form {
            display: flex;
            gap: 9px;
        }

        .albums-input,
        .albums-select {
            min-height: 42px;
            padding: 0 13px;
            color: #ffffff;
            background-color: #0d110e;
            border: 1px solid var(--border);
            border-radius: 10px;
            outline: none;
        }

        .albums-input {
            width: 230px;
        }

        .albums-button {
            min-height: 42px;
            padding: 0 14px;
            border-radius: 10px;
            font-size: 10px;
            font-weight: 800;
        }

        .filter-button {
            color: #071008;
            background-color: var(--primary);
            border: none;
        }

        .clear-button {
            color: #ffffff;
            background: transparent;
            border: 1px solid var(--border);
        }

        .albums-table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        .albums-table {
            width: 100%;
            min-width: 1000px;
            border-collapse: collapse;
            table-layout: fixed;
        }

            .albums-table th,
            .albums-table td {
                padding: 13px 10px;
                border-bottom: 1px solid var(--border);
                text-align: left;
                vertical-align: middle;
                overflow-wrap: anywhere;
            }

            .albums-table th {
                color: #69716c;
                font-size: 9px;
                text-transform: uppercase;
            }

        .album-column {
            width: 20%;
        }

        .artist-column {
            width: 13%;
        }

        .song-count-column {
            width: 7%;
        }

        .status-column {
            width: 10%;
        }

        .moderation-column {
            width: 18%;
        }

        .publication-column {
            width: 14%;
        }

        .action-column {
            width: 18%;
        }

        .album-cell {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .album-cover {
            width: 40px;
            height: 40px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: var(--primary);
            background-color: #0c110e;
            border-radius: 9px;
        }

            .album-cover img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .album-name {
            color: #ffffff;
            font-size: 11px;
            font-weight: 800;
        }

        .secondary {
            margin-top: 4px;
            color: var(--text-secondary);
            font-size: 9px;
        }

        .status-badge,
        .moderation-badge {
            padding: 5px 8px;
            display: inline-flex;
            border-radius: 20px;
            font-size: 9px;
            font-weight: 800;
        }

        .status-published {
            color: var(--primary);
            background-color: rgba(30, 215, 96, 0.10);
        }

        .status-scheduled {
            color: var(--warning);
            background-color: rgba(255, 189, 61, 0.10);
        }

        .status-draft {
            color: var(--info);
            background-color: rgba(85, 170, 255, 0.10);
        }

        .status-archived,
        .moderation-hidden {
            color: var(--danger);
            background-color: rgba(255, 92, 92, 0.10);
        }

        .moderation-visible {
            color: var(--primary);
            background-color: rgba(30, 215, 96, 0.10);
        }

        .moderation-reason {
            margin-top: 6px;
            color: #c9cfcb;
            font-size: 9px;
            line-height: 1.4;
        }

        .moderation-form {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .reason-input {
            width: 100%;
            min-height: 34px;
            padding: 0 8px;
            color: #ffffff;
            background-color: #090d0a;
            border: 1px solid var(--border);
            border-radius: 7px;
            outline: none;
            font-size: 9px;
        }

        .hide-button,
        .unhide-button {
            width: 100%;
            min-height: 34px;
            padding: 0 8px;
            border-radius: 7px;
            font-size: 9px;
            font-weight: 800;
        }

        .hide-button {
            color: #ffffff;
            background-color: rgba(255, 92, 92, 0.12);
            border: 1px solid rgba(255, 92, 92, 0.28);
        }

        .unhide-button {
            color: #071008;
            background-color: var(--primary);
            border: none;
        }

        .empty-state {
            padding: 55px;
            color: var(--text-secondary);
            text-align: center;
        }

        @@media (max-width: 1200px) {
            .albums-stat-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .albums-panel-header {
                flex-direction: column;
                align-items: stretch;
            }
        }

        @@media (max-width: 750px) {
            .albums-content {
                padding: 20px 16px 35px;
            }

            .albums-stat-grid {
                grid-template-columns: 1fr;
            }

            .albums-filter-form {
                flex-direction: column;
            }

            .albums-input,
            .albums-select,
            .albums-button {
                width: 100%;
            }
        }
    </style>
}

<div class="albums-content">

    <section class="albums-hero">

        <div class="albums-hero-label">
            Yönetim
        </div>

        <h2 class="albums-hero-title">
            Albümler
        </h2>

        <p class="albums-hero-description">
            Albümleri görüntüleyebilir, yayın durumlarını takip edebilir ve gerektiğinde
            sanatçının değiştiremeyeceği şekilde platformdan gizleyebilirsin.
        </p>

    </section>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="message message-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="message message-error">
            @TempData["ErrorMessage"]
        </div>
    }

    <section class="albums-stat-grid">

        <article class="albums-stat-card">
            <div class="albums-stat-label">Görüntülenen</div>
            <div class="albums-stat-value">@Model.DisplayedAlbums</div>
        </article>

        <article class="albums-stat-card">
            <div class="albums-stat-label">Yayında</div>
            <div class="albums-stat-value">@Model.PublishedAlbums</div>
        </article>

        <article class="albums-stat-card">
            <div class="albums-stat-label">Planlandı</div>
            <div class="albums-stat-value">@Model.ScheduledAlbums</div>
        </article>

        <article class="albums-stat-card">
            <div class="albums-stat-label">Taslak</div>
            <div class="albums-stat-value">@Model.DraftAlbums</div>
        </article>

        <article class="albums-stat-card">
            <div class="albums-stat-label">Arşivlendi</div>
            <div class="albums-stat-value">@Model.ArchivedAlbums</div>
        </article>

    </section>

    <section class="albums-panel">

        <div class="albums-panel-header">

            <div>
                <strong>Albüm Listesi</strong>

                <div class="secondary">
                    Albüm veya sanatçı adına göre ara.
                </div>
            </div>

            <form asp-action="Albums" method="get" class="albums-filter-form">

                <input name="search"
                       value="@Model.SearchTerm"
                       class="albums-input"
                       placeholder="Albüm veya sanatçı ara..." />

                <select name="status" class="albums-select">
                    <option value="">Tüm Durumlar</option>
                    <option value="Published" selected="@(Model.StatusFilter == PublicationStatus.Published ? "selected" : null)">Yayında</option>
                    <option value="Scheduled" selected="@(Model.StatusFilter == PublicationStatus.Scheduled ? "selected" : null)">Planlandı</option>
                    <option value="Draft" selected="@(Model.StatusFilter == PublicationStatus.Draft ? "selected" : null)">Taslak</option>
                    <option value="Archived" selected="@(Model.StatusFilter == PublicationStatus.Archived ? "selected" : null)">Arşivlendi</option>
                </select>

                <button class="albums-button filter-button" type="submit">
                    Filtrele
                </button>

                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.StatusFilter.HasValue)
                {
                    <a asp-action="Albums" class="albums-button clear-button">
                        Temizle
                    </a>
                }

            </form>

        </div>

        @if (Model.Albums.Count == 0)
        {
            <div class="empty-state">
                Albüm bulunamadı.
            </div>
        }
        else
        {
            <div class="albums-table-wrapper">

                <table class="albums-table">

                    <thead>
                        <tr>
                            <th class="album-column">Albüm</th>
                            <th class="artist-column">Sanatçı</th>
                            <th class="song-count-column">Şarkı</th>
                            <th class="status-column">Durum</th>
                            <th class="moderation-column">Moderasyon</th>
                            <th class="publication-column">Yayın</th>
                            <th class="action-column">İşlem</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var album in Model.Albums)
                        {
                            var statusText = album.PublicationStatus switch
                            {
                                PublicationStatus.Published => "Yayında",
                                PublicationStatus.Scheduled => "Planlandı",
                                PublicationStatus.Draft => "Taslak",
                                PublicationStatus.Archived => "Arşivlendi",
                                _ => "Bilinmiyor"
                            };

                            var statusClass = album.PublicationStatus switch
                            {
                                PublicationStatus.Published => "status-published",
                                PublicationStatus.Scheduled => "status-scheduled",
                                PublicationStatus.Draft => "status-draft",
                                PublicationStatus.Archived => "status-archived",
                                _ => "status-draft"
                            };

                            <tr>

                                <td>

                                    <div class="album-cell">

                                        <div class="album-cover">

                                            @if (!string.IsNullOrWhiteSpace(album.CoverImageUrl))
                                            {
                                                <img src="@album.CoverImageUrl" alt="@album.Name" />
                                            }
                                            else
                                            {
                                                <span>◉</span>
                                            }

                                        </div>

                                        <div>
                                            <div class="album-name">
                                                @album.Name
                                            </div>

                                            <div class="secondary">
                                                ID: @album.Id
                                            </div>
                                        </div>

                                    </div>

                                </td>

                                <td>
                                    @album.ArtistName
                                </td>

                                <td>
                                    @album.SongCount
                                </td>

                                <td>
                                    <span class="status-badge @statusClass">
                                        @statusText
                                    </span>
                                </td>

                                <td>

                                    @if (album.IsAdminHidden)
                                    {
                                        <span class="moderation-badge moderation-hidden">
                                            🔒 Admin tarafından gizli
                                        </span>

                                        <div class="moderation-reason">
                                            @album.AdminHiddenReason
                                        </div>

                                        @if (album.AdminHiddenAtUtc.HasValue)
                                        {
                                            <div class="secondary">
                                                @album.AdminHiddenAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="moderation-badge moderation-visible">
                                            Görünür
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (album.PublicationStatus == PublicationStatus.Scheduled &&
                                         album.ScheduledPublishAtUtc.HasValue)
                                    {
                                        <div>
                                            @album.ScheduledPublishAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                        </div>

                                        <div class="secondary">
                                            Planlanan
                                        </div>
                                    }
                                    else if (album.PublicationStatus == PublicationStatus.Published &&
                                             album.PublishedAtUtc.HasValue)
                                    {
                                        <div>
                                            @album.PublishedAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                        </div>

                                        <div class="secondary">
                                            Yayınlandı
                                        </div>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }

                                </td>

                                <td>

                                    @if (album.IsAdminHidden)
                                    {
                                        <form asp-action="SetAlbumAdminHiddenStatus"
                                              method="post"
                                              class="moderation-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="albumId" value="@album.Id" />
                                            <input type="hidden" name="isHidden" value="false" />
                                            <input type="hidden" name="search" value="@Model.SearchTerm" />
                                            <input type="hidden" name="status" value="@Model.StatusFilter" />

                                            <button type="submit" class="unhide-button">
                                                Gizliliği Kaldır
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="SetAlbumAdminHiddenStatus"
                                              method="post"
                                              class="moderation-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="albumId" value="@album.Id" />
                                            <input type="hidden" name="isHidden" value="true" />
                                            <input type="hidden" name="search" value="@Model.SearchTerm" />
                                            <input type="hidden" name="status" value="@Model.StatusFilter" />

                                            <input type="text"
                                                   name="reason"
                                                   class="reason-input"
                                                   maxlength="300"
                                                   required
                                                   placeholder="Gizleme nedeni..." />

                                            <button type="submit" class="hide-button">
                                                Albümü Gizle
                                            </button>

                                        </form>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>