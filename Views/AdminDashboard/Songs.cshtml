@using MusicProject.Models.Enums
@model MusicProject.ViewModels.AdminDashboard.AdminSongsViewModel

@{
    ViewData["Title"] = "Şarkı Yönetimi";
    ViewData["PageDescription"] = "Platformdaki şarkıları, yayın durumlarını ve moderasyon işlemlerini yönet.";
    Layout = "_AdminLayout";
}

@section Styles {
    <style>
        .songs-content {
            padding: 32px 34px 50px;
        }

        .songs-hero {
            padding: 29px 31px;
            background: linear-gradient(125deg, rgba(30, 215, 96, 0.18), rgba(18, 23, 19, 0.97) 65%);
            border: 1px solid rgba(30, 215, 96, 0.20);
            border-radius: 21px;
        }

        .songs-hero-label {
            color: var(--primary);
            font-size: 11px;
            font-weight: 850;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .songs-hero-title {
            margin-top: 7px;
            color: #ffffff;
            font-size: clamp(27px, 4vw, 38px);
        }

        .songs-hero-description {
            max-width: 720px;
            margin-top: 8px;
            color: var(--text-secondary);
            font-size: 13px;
            line-height: 1.7;
        }

        .message {
            margin-top: 18px;
            padding: 13px 16px;
            border-radius: 11px;
            font-size: 12px;
            font-weight: 700;
        }

        .message-success {
            color: var(--primary);
            background-color: rgba(30, 215, 96, 0.09);
            border: 1px solid rgba(30, 215, 96, 0.25);
        }

        .message-error {
            color: var(--danger);
            background-color: rgba(255, 92, 92, 0.08);
            border: 1px solid rgba(255, 92, 92, 0.25);
        }

        .songs-stat-grid {
            margin-top: 22px;
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 14px;
        }

        .songs-stat-card {
            padding: 19px;
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
        }

        .songs-stat-label {
            color: var(--text-secondary);
            font-size: 10px;
        }

        .songs-stat-value {
            margin-top: 9px;
            color: #ffffff;
            font-size: 25px;
            font-weight: 900;
        }

        .songs-panel {
            margin-top: 22px;
            overflow: hidden;
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 18px;
        }

        .songs-panel-header {
            padding: 20px 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            border-bottom: 1px solid var(--border);
        }

        .songs-filter-form {
            display: flex;
            gap: 9px;
        }

        .songs-input,
        .songs-select {
            min-height: 42px;
            padding: 0 13px;
            color: #ffffff;
            background-color: #0d110e;
            border: 1px solid var(--border);
            border-radius: 10px;
            outline: none;
        }

        .songs-input {
            width: 230px;
        }

        .songs-filter-button {
            padding: 0 15px;
            color: #071008;
            background-color: var(--primary);
            border: none;
            border-radius: 10px;
            font-weight: 800;
        }

        .songs-table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        .songs-table {
            width: 100%;
            min-width: 1080px;
            border-collapse: collapse;
            table-layout: fixed;
        }

            .songs-table th,
            .songs-table td {
                padding: 13px 10px;
                border-bottom: 1px solid var(--border);
                text-align: left;
                vertical-align: middle;
                overflow-wrap: anywhere;
            }

            .songs-table th {
                color: #69716c;
                font-size: 9px;
                text-transform: uppercase;
                overflow-wrap: normal;
            }

        .song-column {
            width: 15%;
        }

        .artist-column {
            width: 10%;
        }

        .album-column {
            width: 11%;
        }

        .label-column {
            width: 8%;
        }

        .status-column {
            width: 8%;
        }

        .moderation-column {
            width: 13%;
        }

        .number-column {
            width: 7%;
        }

        .action-column {
            width: 14%;
        }

        .song-title {
            color: #ffffff;
            font-size: 12px;
            font-weight: 800;
        }

        .secondary {
            margin-top: 4px;
            color: var(--text-secondary);
            font-size: 9px;
        }

        .status-badge,
        .moderation-badge {
            padding: 5px 8px;
            display: inline-flex;
            border-radius: 20px;
            font-size: 9px;
            font-weight: 800;
            line-height: 1.3;
        }

        .status-published {
            color: var(--primary);
            background-color: rgba(30, 215, 96, 0.10);
        }

        .status-scheduled {
            color: var(--warning);
            background-color: rgba(255, 189, 61, 0.10);
        }

        .status-draft {
            color: var(--info);
            background-color: rgba(85, 170, 255, 0.10);
        }

        .status-archived,
        .moderation-hidden {
            color: var(--danger);
            background-color: rgba(255, 92, 92, 0.10);
        }

        .moderation-album {
            color: var(--warning);
            background-color: rgba(255, 189, 61, 0.10);
        }

        .moderation-visible {
            color: var(--primary);
            background-color: rgba(30, 215, 96, 0.10);
        }

        .moderation-reason {
            margin-top: 6px;
            color: #c9cfcb;
            font-size: 9px;
            line-height: 1.4;
            white-space: normal;
        }

        .moderation-form {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .reason-input {
            width: 100%;
            min-height: 34px;
            padding: 0 8px;
            color: #ffffff;
            background-color: #090d0a;
            border: 1px solid var(--border);
            border-radius: 7px;
            outline: none;
            font-size: 9px;
        }

            .reason-input:focus {
                border-color: var(--danger);
            }

        .hide-button,
        .unhide-button {
            width: 100%;
            min-height: 34px;
            padding: 0 8px;
            border-radius: 7px;
            font-size: 9px;
            font-weight: 800;
            line-height: 1.2;
        }

        .hide-button {
            color: #ffffff;
            background-color: rgba(255, 92, 92, 0.12);
            border: 1px solid rgba(255, 92, 92, 0.28);
        }

            .hide-button:hover {
                background-color: rgba(255, 92, 92, 0.20);
            }

        .unhide-button {
            color: #071008;
            background-color: var(--primary);
            border: none;
        }

            .unhide-button:hover {
                background-color: var(--primary-hover);
            }

        .album-hidden-info {
            color: var(--text-secondary);
            font-size: 9px;
            line-height: 1.45;
        }

        .number-value {
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
        }

        .empty-state {
            padding: 55px;
            color: var(--text-secondary);
            text-align: center;
        }

        @@media (max-width: 1200px) {
            .songs-stat-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .songs-panel-header {
                flex-direction: column;
                align-items: stretch;
            }

            .songs-table {
                min-width: 1050px;
            }
        }

        @@media (max-width: 750px) {
            .songs-content {
                padding: 20px 16px 35px;
            }

            .songs-stat-grid {
                grid-template-columns: 1fr;
            }

            .songs-filter-form {
                flex-direction: column;
            }

            .songs-input,
            .songs-select,
            .songs-filter-button {
                width: 100%;
            }
        }
    </style>
}

<div class="songs-content">

    <section class="songs-hero">
        <div class="songs-hero-label">Yönetim</div>

        <h2 class="songs-hero-title">
            Şarkılar
        </h2>

        <p class="songs-hero-description">
            Şarkıları takip edebilir ve gerektiğinde sanatçının değiştiremeyeceği şekilde platformdan gizleyebilirsin.
        </p>
    </section>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="message message-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="message message-error">
            @TempData["ErrorMessage"]
        </div>
    }

    <section class="songs-stat-grid">

        <article class="songs-stat-card">
            <div class="songs-stat-label">Görüntülenen</div>
            <div class="songs-stat-value">@Model.DisplayedSongs</div>
        </article>

        <article class="songs-stat-card">
            <div class="songs-stat-label">Yayında</div>
            <div class="songs-stat-value">@Model.PublishedSongs</div>
        </article>

        <article class="songs-stat-card">
            <div class="songs-stat-label">Planlandı</div>
            <div class="songs-stat-value">@Model.ScheduledSongs</div>
        </article>

        <article class="songs-stat-card">
            <div class="songs-stat-label">Taslak</div>
            <div class="songs-stat-value">@Model.DraftSongs</div>
        </article>

        <article class="songs-stat-card">
            <div class="songs-stat-label">Arşivlendi</div>
            <div class="songs-stat-value">@Model.ArchivedSongs</div>
        </article>

    </section>

    <section class="songs-panel">

        <div class="songs-panel-header">

            <div>
                <strong>Şarkı Listesi</strong>

                <div class="secondary">
                    Şarkı, sanatçı, albüm veya label ara.
                </div>
            </div>

            <form asp-action="Songs" method="get" class="songs-filter-form">

                <input name="search"
                       value="@Model.SearchTerm"
                       class="songs-input"
                       placeholder="Şarkı veya sanatçı ara..." />

                <select name="status" class="songs-select">
                    <option value="">Tüm Durumlar</option>
                    <option value="Published" selected="@(Model.StatusFilter == PublicationStatus.Published ? "selected" : null)">Yayında</option>
                    <option value="Scheduled" selected="@(Model.StatusFilter == PublicationStatus.Scheduled ? "selected" : null)">Planlandı</option>
                    <option value="Draft" selected="@(Model.StatusFilter == PublicationStatus.Draft ? "selected" : null)">Taslak</option>
                    <option value="Archived" selected="@(Model.StatusFilter == PublicationStatus.Archived ? "selected" : null)">Arşivlendi</option>
                </select>

                <button type="submit" class="songs-filter-button">
                    Filtrele
                </button>

            </form>

        </div>

        @if (Model.Songs.Count == 0)
        {
            <div class="empty-state">
                Şarkı bulunamadı.
            </div>
        }
        else
        {
            <div class="songs-table-wrapper">

                <table class="songs-table">

                    <thead>
                        <tr>
                            <th class="song-column">Şarkı</th>
                            <th class="artist-column">Sanatçı</th>
                            <th class="album-column">Albüm</th>
                            <th class="label-column">Label</th>
                            <th class="status-column">Durum</th>
                            <th class="moderation-column">Moderasyon</th>
                            <th class="number-column">Dinlenme</th>
                            <th class="number-column">Beğeni</th>
                            <th class="number-column">Popülerlik</th>
                            <th class="action-column">İşlem</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var song in Model.Songs)
                        {
                            var statusText = song.PublicationStatus switch
                            {
                                PublicationStatus.Published => "Yayında",
                                PublicationStatus.Scheduled => "Planlandı",
                                PublicationStatus.Draft => "Taslak",
                                PublicationStatus.Archived => "Arşivlendi",
                                _ => "Bilinmiyor"
                            };

                            var statusClass = song.PublicationStatus switch
                            {
                                PublicationStatus.Published => "status-published",
                                PublicationStatus.Scheduled => "status-scheduled",
                                PublicationStatus.Draft => "status-draft",
                                PublicationStatus.Archived => "status-archived",
                                _ => "status-draft"
                            };

                            <tr>

                                <td>
                                    <div class="song-title">
                                        @song.Title
                                    </div>

                                    <div class="secondary">
                                        ID: @song.Id
                                    </div>
                                </td>

                                <td>
                                    @song.ArtistName
                                </td>

                                <td>
                                    @song.AlbumName
                                </td>

                                <td>
                                    @song.LabelName
                                </td>

                                <td>
                                    <span class="status-badge @statusClass">
                                        @statusText
                                    </span>
                                </td>

                                <td>

                                    @if (song.IsAdminHidden)
                                    {
                                        <span class="moderation-badge moderation-hidden">
                                            🔒 Admin tarafından gizli
                                        </span>

                                        <div class="moderation-reason">
                                            @song.AdminHiddenReason
                                        </div>

                                        @if (song.AdminHiddenAtUtc.HasValue)
                                        {
                                            <div class="secondary">
                                                @song.AdminHiddenAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                            </div>
                                        }
                                    }
                                    else if (song.IsHiddenByAlbum)
                                    {
                                        <span class="moderation-badge moderation-album">
                                            🔒 Albüm nedeniyle gizli
                                        </span>

                                        @if (!string.IsNullOrWhiteSpace(song.AlbumAdminHiddenReason))
                                        {
                                            <div class="moderation-reason">
                                                @song.AlbumAdminHiddenReason
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="moderation-badge moderation-visible">
                                            Görünür
                                        </span>
                                    }

                                </td>

                                <td>
                                    <span class="number-value">
                                        @song.TotalStreams.ToString("N0")
                                    </span>
                                </td>

                                <td>
                                    <span class="number-value">
                                        @song.TotalLikes.ToString("N0")
                                    </span>
                                </td>

                                <td>
                                    <span class="number-value">
                                        @song.PopularityScore.ToString("N0")
                                    </span>
                                </td>

                                <td>

                                    @if (song.IsAdminHidden)
                                    {
                                        <form asp-action="SetSongAdminHiddenStatus"
                                              method="post"
                                              class="moderation-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="songId" value="@song.Id" />
                                            <input type="hidden" name="isHidden" value="false" />
                                            <input type="hidden" name="search" value="@Model.SearchTerm" />
                                            <input type="hidden" name="status" value="@Model.StatusFilter" />

                                            <button type="submit" class="unhide-button">
                                                Gizliliği Kaldır
                                            </button>

                                        </form>
                                    }
                                    else if (song.IsHiddenByAlbum)
                                    {
                                        <div class="album-hidden-info">
                                            Bağlı olduğu albüm gizli olduğu için bu şarkı kullanıcıya kapalı.
                                        </div>
                                    }
                                    else
                                    {
                                        <form asp-action="SetSongAdminHiddenStatus"
                                              method="post"
                                              class="moderation-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="songId" value="@song.Id" />
                                            <input type="hidden" name="isHidden" value="true" />
                                            <input type="hidden" name="search" value="@Model.SearchTerm" />
                                            <input type="hidden" name="status" value="@Model.StatusFilter" />

                                            <input type="text"
                                                   name="reason"
                                                   class="reason-input"
                                                   maxlength="300"
                                                   required
                                                   placeholder="Gizleme nedeni..." />

                                            <button type="submit" class="hide-button">
                                                Şarkıyı Gizle
                                            </button>

                                        </form>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>