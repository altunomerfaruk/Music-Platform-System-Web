@using MusicProject.Models.Enums
@model MusicProject.ViewModels.ArtistDashboard.EditSongViewModel

@{
    ViewData["Title"] = "Şarkı Düzenle";
    ViewData["PageDescription"] = "Şarkı bilgilerini, müzik türlerini ve yayın ayarlarını güncelle.";
    Layout = "_ArtistLayout";
}

@section Styles {
    <style>
        .edit-song-content {
            padding: 32px 34px 50px;
        }

        .edit-song-hero {
            padding: 28px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            background: linear-gradient(125deg, rgba(30, 215, 96, 0.18), rgba(18, 23, 19, 0.97) 65%);
            border: 1px solid rgba(30, 215, 96, 0.20);
            border-radius: 21px;
        }

        .edit-song-hero-left {
            display: flex;
            align-items: center;
            gap: 19px;
        }

        .edit-song-hero-icon {
            width: 82px;
            height: 82px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: #071008;
            background-color: var(--primary);
            border-radius: 18px;
            font-size: 36px;
            box-shadow: 0 16px 35px rgba(0, 0, 0, 0.28);
        }

        .edit-song-label {
            color: var(--primary);
            font-size: 11px;
            font-weight: 850;
            letter-spacing: 1.1px;
            text-transform: uppercase;
        }

        .edit-song-title {
            margin-top: 7px;
            color: #ffffff;
            font-size: clamp(27px, 4vw, 38px);
        }

        .edit-song-description {
            margin-top: 8px;
            color: var(--text-secondary);
            font-size: 13px;
            line-height: 1.6;
        }

        .back-button {
            min-height: 42px;
            padding: 0 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border);
            border-radius: 11px;
            font-size: 11px;
            font-weight: 800;
            transition: 0.2s;
        }

        .back-button:hover {
            color: #071008;
            background-color: var(--primary);
            border-color: var(--primary);
        }

        .moderation-alert {
            margin-top: 20px;
            padding: 17px 18px;
            border-radius: 14px;
        }

        .moderation-alert.direct {
            color: #ebc6c6;
            background-color: rgba(255, 92, 92, 0.08);
            border: 1px solid rgba(255, 92, 92, 0.30);
        }

        .moderation-alert.album {
            color: #e4d2aa;
            background-color: rgba(255, 189, 61, 0.07);
            border: 1px solid rgba(255, 189, 61, 0.25);
        }

        .moderation-alert-title {
            font-size: 13px;
            font-weight: 900;
        }

        .moderation-alert.direct .moderation-alert-title {
            color: #ff7777;
        }

        .moderation-alert.album .moderation-alert-title {
            color: var(--warning);
        }

        .moderation-alert-description {
            margin-top: 7px;
            font-size: 11px;
            line-height: 1.7;
        }

        .moderation-alert-reason {
            margin-top: 10px;
            padding: 10px 12px;
            color: #ffffff;
            background-color: rgba(0, 0, 0, 0.18);
            border-radius: 9px;
            font-size: 11px;
            line-height: 1.6;
        }

        .edit-song-grid {
            margin-top: 24px;
            display: grid;
            grid-template-columns: minmax(0, 1.45fr) minmax(270px, 0.55fr);
            gap: 22px;
            align-items: start;
        }

        .form-panel,
        .preview-panel {
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 18px;
        }

        .form-panel {
            padding: 25px;
        }

        .panel-title {
            color: #ffffff;
            font-size: 18px;
            font-weight: 850;
        }

        .panel-description {
            margin-top: 6px;
            color: var(--text-secondary);
            font-size: 11px;
            line-height: 1.6;
        }

        .form-group {
            margin-top: 21px;
        }

        .form-label {
            margin-bottom: 8px;
            display: block;
            color: #dfe5e0;
            font-size: 11px;
            font-weight: 800;
        }

        .form-label-note {
            color: var(--text-secondary);
            font-size: 9px;
            font-weight: 600;
        }

        .form-control {
            width: 100%;
            min-height: 46px;
            padding: 0 14px;
            color: #ffffff;
            background-color: #0e120f;
            border: 1px solid var(--border);
            border-radius: 11px;
            outline: none;
            font-size: 12px;
            transition: 0.2s;
        }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(30, 215, 96, 0.09);
        }

        .form-control option {
            color: #ffffff;
            background-color: #111612;
        }

        .form-control:disabled {
            color: #a8aea9;
            background-color: rgba(255, 189, 61, 0.035);
            border-color: rgba(255, 189, 61, 0.20);
        }

        .form-hint {
            margin-top: 7px;
            display: block;
            color: var(--text-secondary);
            font-size: 9px;
            line-height: 1.5;
        }

        .audio-upload-box {
            padding: 16px;
            background-color: rgba(30, 215, 96, 0.035);
            border: 1px dashed rgba(30, 215, 96, 0.28);
            border-radius: 12px;
        }

        .current-audio-status {
            margin-bottom: 12px;
            padding: 10px 12px;
            border-radius: 9px;
            font-size: 10px;
            line-height: 1.5;
        }

        .current-audio-status.available {
            color: #9ff1ba;
            background-color: rgba(30, 215, 96, 0.07);
            border: 1px solid rgba(30, 215, 96, 0.16);
        }

        .current-audio-status.missing {
            color: #ffb2b2;
            background-color: rgba(255, 92, 92, 0.07);
            border: 1px solid rgba(255, 92, 92, 0.18);
        }

        .audio-file-input {
            width: 100%;
            color: #dce2de;
            font-size: 11px;
        }

        .audio-file-input::file-selector-button {
            min-height: 36px;
            margin-right: 11px;
            padding: 0 13px;
            color: #071008;
            background-color: var(--primary);
            border: none;
            border-radius: 8px;
            font-size: 10px;
            font-weight: 800;
            cursor: pointer;
        }

        .selected-audio {
            margin-top: 10px;
            display: none;
            color: #dce2de;
            font-size: 10px;
        }

        .selected-audio.visible {
            display: block;
        }

        .selected-audio strong {
            color: var(--primary);
        }

        .artist-display {
            min-height: 46px;
            padding: 0 14px;
            display: flex;
            align-items: center;
            color: var(--text-secondary);
            background-color: rgba(255, 255, 255, 0.025);
            border: 1px solid var(--border);
            border-radius: 11px;
            font-size: 12px;
        }

        .genre-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 12px;
        }

        .genre-count {
            color: var(--primary);
            font-size: 10px;
            font-weight: 800;
        }

        .genre-search {
            margin-top: 10px;
        }

        .genre-grid {
            margin-top: 12px;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 9px;
        }

        .genre-option {
            position: relative;
        }

        .genre-checkbox {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .genre-option-label {
            min-height: 42px;
            padding: 0 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            color: #cbd2cc;
            background-color: #0e120f;
            border: 1px solid var(--border);
            border-radius: 10px;
            cursor: pointer;
            font-size: 10px;
            font-weight: 750;
        }

        .genre-check-icon {
            width: 21px;
            height: 21px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: transparent;
            background-color: rgba(255, 255, 255, 0.035);
            border-radius: 6px;
        }

        .genre-checkbox:checked + .genre-option-label {
            color: #ffffff;
            background-color: rgba(30, 215, 96, 0.08);
            border-color: rgba(30, 215, 96, 0.45);
        }

        .genre-checkbox:checked + .genre-option-label .genre-check-icon {
            color: #071008;
            background-color: var(--primary);
        }

        .publication-section {
            margin-top: 25px;
            padding: 20px;
            background-color: rgba(30, 215, 96, 0.035);
            border: 1px solid rgba(30, 215, 96, 0.16);
            border-radius: 14px;
        }

        .publication-section.hidden {
            display: none;
        }

        .publication-section-title {
            color: #ffffff;
            font-size: 14px;
            font-weight: 850;
        }

        .publication-section-description {
            margin-top: 5px;
            color: var(--text-secondary);
            font-size: 10px;
        }

        .scheduled-publish-group {
            display: none;
        }

        .scheduled-publish-group.visible {
            display: block;
        }

        .publication-info,
        .album-publication-info {
            margin-top: 16px;
            padding: 12px 14px;
            color: #cbd2cc;
            background-color: rgba(255, 255, 255, 0.025);
            border: 1px solid var(--border);
            border-radius: 10px;
            font-size: 10px;
            line-height: 1.6;
        }

        .album-publication-info {
            display: none;
        }

        .album-publication-info.visible {
            display: block;
        }

        .publication-info strong,
        .album-publication-info strong {
            color: var(--primary);
        }

        .validation-message {
            margin-top: 7px;
            display: block;
            color: #ff7777;
            font-size: 10px;
        }

        .validation-summary {
            margin-bottom: 18px;
            padding: 13px 15px;
            color: #ff9999;
            background-color: rgba(255, 74, 74, 0.07);
            border: 1px solid rgba(255, 74, 74, 0.20);
            border-radius: 10px;
            font-size: 11px;
        }

        .validation-summary:empty {
            display: none;
        }

        .form-actions {
            margin-top: 25px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .cancel-button,
        .save-button {
            min-height: 43px;
            padding: 0 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            font-size: 11px;
            font-weight: 850;
            cursor: pointer;
        }

        .cancel-button {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border);
        }

        .save-button {
            color: #071008;
            background-color: var(--primary);
            border: 1px solid var(--primary);
        }

        .preview-panel {
            padding: 23px;
            position: sticky;
            top: 24px;
        }

        .preview-cover {
            width: 100%;
            aspect-ratio: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            background: radial-gradient(circle at center, rgba(30, 215, 96, 0.20), rgba(7, 12, 8, 0.98) 65%);
            border-radius: 17px;
            font-size: 72px;
        }

        .preview-label {
            margin-top: 18px;
            color: var(--primary);
            font-size: 9px;
            font-weight: 850;
            text-transform: uppercase;
        }

        .preview-title {
            margin-top: 7px;
            color: #ffffff;
            font-size: 20px;
            font-weight: 900;
        }

        .preview-artist {
            margin-top: 5px;
            color: var(--text-secondary);
            font-size: 11px;
        }

        .preview-info-list {
            margin-top: 19px;
            padding-top: 17px;
            border-top: 1px solid var(--border);
        }

        .preview-info-item {
            padding: 8px 0;
            display: flex;
            justify-content: space-between;
            gap: 15px;
            color: var(--text-secondary);
            font-size: 10px;
        }

        .preview-info-item strong {
            color: #ffffff;
            text-align: right;
        }

        @@media (max-width: 930px) {
            .edit-song-grid {
                grid-template-columns: 1fr;
            }

            .preview-panel {
                position: static;
            }
        }

        @@media (max-width: 650px) {
            .edit-song-content {
                padding: 22px 15px 40px;
            }

            .edit-song-hero,
            .edit-song-hero-left {
                align-items: flex-start;
                flex-direction: column;
            }

            .back-button,
            .cancel-button,
            .save-button {
                width: 100%;
            }

            .genre-grid {
                grid-template-columns: 1fr;
            }

            .form-actions {
                flex-direction: column-reverse;
            }
        }
    </style>
}

<div class="edit-song-content">

    <section class="edit-song-hero">

        <div class="edit-song-hero-left">

            <div class="edit-song-hero-icon">
                ♫
            </div>

            <div>

                <p class="edit-song-label">
                    Şarkı yönetimi
                </p>

                <h2 class="edit-song-title">
                    Şarkıyı Düzenle
                </h2>

                <p class="edit-song-description">
                    Şarkı bilgilerini, MP3 dosyasını ve yayın durumunu güncelle.
                </p>

            </div>

        </div>

        <a asp-controller="ArtistDashboard"
           asp-action="MySongs"
           class="back-button">
            Şarkılarıma Dön
        </a>

    </section>

    @if (Model.IsAdminHidden)
    {
        <section class="moderation-alert direct">

            <div class="moderation-alert-title">
                🔒 Bu şarkı admin tarafından platformdan gizlendi
            </div>

            <div class="moderation-alert-description">
                Şarkıyı düzenleyebilirsin ancak admin gizliliği kaldırılana kadar
                normal kullanıcılar tarafından görülemez veya dinlenemez.
            </div>

            <div class="moderation-alert-reason">
                <strong>Neden:</strong>
                @(string.IsNullOrWhiteSpace(Model.AdminHiddenReason)
                    ? "Neden belirtilmedi."
                    : Model.AdminHiddenReason)
            </div>

        </section>
    }

    @if (Model.IsHiddenByAlbum)
    {
        <section class="moderation-alert album">

            <div class="moderation-alert-title">
                🔒 Bağlı albüm admin tarafından gizlendi
            </div>

            <div class="moderation-alert-description">
                Albüm gizli kaldığı sürece bu şarkı da normal kullanıcılara kapalıdır.
            </div>

            <div class="moderation-alert-reason">
                <strong>Neden:</strong>
                @(string.IsNullOrWhiteSpace(Model.AlbumAdminHiddenReason)
                    ? "Neden belirtilmedi."
                    : Model.AlbumAdminHiddenReason)
            </div>

        </section>
    }

    <div class="edit-song-grid">

        <section class="form-panel">

            <h3 class="panel-title">
                Şarkı bilgileri
            </h3>

            <p class="panel-description">
                Yeni bir MP3 seçmezsen mevcut ses dosyası kullanılmaya devam eder.
            </p>

            <form asp-controller="ArtistDashboard"
                  asp-action="EditSong"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input asp-for="SongId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>

                <div class="form-group">

                    <label asp-for="Title"
                           class="form-label">
                        Şarkı adı
                    </label>

                    <input asp-for="Title"
                           id="songTitle"
                           class="form-control" />

                    <span asp-validation-for="Title"
                          class="validation-message">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="AudioFile"
                           class="form-label">
                        MP3 Dosyası
                    </label>

                    <div class="audio-upload-box">

                        @if (Model.HasAudioFile)
                        {
                            <div class="current-audio-status available">
                                ✓ Bu şarkının mevcut bir MP3 dosyası var.
                                Yeni dosya seçmezsen mevcut MP3 korunur.
                            </div>
                        }
                        else
                        {
                            <div class="current-audio-status missing">
                                Bu şarkının henüz bir MP3 dosyası yok.
                                Dinlenebilmesi için bir MP3 yüklemelisin.
                            </div>
                        }

                        <input asp-for="AudioFile"
                               id="audioFileInput"
                               type="file"
                               accept=".mp3,audio/mpeg"
                               class="audio-file-input" />

                        <span class="form-hint">
                            İsteğe bağlı. Yeni bir MP3 seçersen mevcut ses dosyasının yerini alır.
                            Maksimum 30 MB.
                        </span>

                        <div id="selectedAudio"
                             class="selected-audio">

                            Yeni dosya:
                            <strong id="selectedAudioName"></strong>
                            <span id="selectedAudioSize"></span>

                        </div>

                    </div>

                    <span asp-validation-for="AudioFile"
                          class="validation-message">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="AlbumId"
                           class="form-label">
                        Albüm
                    </label>

                    @if (Model.IsHiddenByAlbum)
                    {
                        <input type="hidden"
                               name="AlbumId"
                               value="@Model.AlbumId" />

                        <select asp-for="AlbumId"
                                asp-items="Model.AlbumOptions"
                                id="albumSelect"
                                class="form-control"
                                disabled>

                            <option value="">
                                Single / Albümsüz
                            </option>

                        </select>
                    }
                    else
                    {
                        <select asp-for="AlbumId"
                                asp-items="Model.AlbumOptions"
                                id="albumSelect"
                                class="form-control">

                            <option value="">
                                Single / Albümsüz
                            </option>

                        </select>
                    }

                </div>

                <div class="form-group">

                    <label asp-for="LabelId"
                           class="form-label">
                        Plak Şirketi ID
                    </label>

                    <input asp-for="LabelId"
                           type="number"
                           min="1"
                           class="form-control" />

                </div>

                <div class="form-group">

                    <label class="form-label">
                        Sanatçı
                    </label>

                    <div class="artist-display">
                        @Model.Artist.Name
                    </div>

                </div>

                <div class="form-group">

                    <div class="genre-header">

                        <label class="form-label">
                            Müzik türleri
                        </label>

                        <span class="genre-count">
                            <span id="selectedGenreCount">0</span> tür seçili
                        </span>

                    </div>

                    <input type="text"
                           id="genreSearch"
                           class="form-control genre-search"
                           placeholder="Tür ara..." />

                    <div class="genre-grid">

                        @foreach (var genre in Model.GenreOptions)
                        {
                            var checkboxId = $"genre_{genre.Value}";
                            var genreId = int.Parse(genre.Value);
                            var isChecked = Model.SelectedGenreIds.Contains(genreId);

                            <div class="genre-option"
                                 data-genre-name="@genre.Text.ToLowerInvariant()">

                                <input type="checkbox"
                                       id="@checkboxId"
                                       name="SelectedGenreIds"
                                       value="@genre.Value"
                                       checked="@isChecked"
                                       class="genre-checkbox" />

                                <label for="@checkboxId"
                                       class="genre-option-label">

                                    <span>@genre.Text</span>

                                    <span class="genre-check-icon">
                                        ✓
                                    </span>

                                </label>

                            </div>
                        }

                    </div>

                    <span asp-validation-for="SelectedGenreIds"
                          class="validation-message">
                    </span>

                </div>

                <div id="albumPublicationInfo"
                     class="album-publication-info">

                    <strong>Albüm yayını:</strong>
                    Şarkının yayın durumu bağlı olduğu albüm tarafından yönetilir.

                </div>

                <section id="publicationSection"
                         class="publication-section">

                    <h3 class="publication-section-title">
                        Single Yayın Ayarları
                    </h3>

                    <p class="publication-section-description">
                        Şarkı albümsüz olduğunda yayın durumunu buradan belirleyebilirsin.
                    </p>

                    <div>

                        <div class="form-group">

                            <label asp-for="PublicationStatus"
                                   class="form-label">
                                Yayın Durumu
                            </label>

                            <select asp-for="PublicationStatus"
                                    id="publicationStatusSelect"
                                    class="form-control">

                                <option value="@((int)PublicationStatus.Draft)">
                                    Taslak
                                </option>

                                <option value="@((int)PublicationStatus.Scheduled)">
                                    Cuma günü için planla
                                </option>

                                <option value="@((int)PublicationStatus.Published)">
                                    Yayında
                                </option>

                                <option value="@((int)PublicationStatus.Archived)">
                                    Arşivlendi
                                </option>

                            </select>

                        </div>

                        <div id="scheduledPublishGroup"
                             class="form-group scheduled-publish-group">

                            <label asp-for="ScheduledPublishAtLocal"
                                   class="form-label">
                                Planlanan Yayın Zamanı
                            </label>

                            <input asp-for="ScheduledPublishAtLocal"
                                   id="scheduledPublishInput"
                                   type="datetime-local"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   class="form-control" />

                        </div>

                        <div id="publicationInfo"
                             class="publication-info">
                        </div>

                    </div>

                </section>

                <div class="form-actions">

                    <a asp-controller="ArtistDashboard"
                       asp-action="MySongs"
                       class="cancel-button">
                        İptal
                    </a>

                    <button type="submit"
                            id="saveSongButton"
                            class="save-button">
                        Değişiklikleri Kaydet
                    </button>

                </div>

            </form>

        </section>

        <aside class="preview-panel">

            <div class="preview-cover">
                ♪
            </div>

            <p class="preview-label">
                Ön izleme
            </p>

            <h3 class="preview-title"
                id="previewTitle">
                @Model.Title
            </h3>

            <p class="preview-artist">
                @Model.Artist.Name
            </p>

            <div class="preview-info-list">

                <div class="preview-info-item">
                    <span>MP3</span>
                    <strong>
                        @(Model.HasAudioFile ? "Yüklü" : "Yok")
                    </strong>
                </div>

                <div class="preview-info-item">
                    <span>Albüm</span>
                    <strong id="previewAlbum">Single</strong>
                </div>

                <div class="preview-info-item">
                    <span>Tür</span>
                    <strong id="previewGenreCount">0</strong>
                </div>

                <div class="preview-info-item">
                    <span>Yayın</span>
                    <strong id="previewPublicationStatus">-</strong>
                </div>

            </div>

        </aside>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const draftStatus = "@((int)PublicationStatus.Draft)";
            const scheduledStatus = "@((int)PublicationStatus.Scheduled)";
            const publishedStatus = "@((int)PublicationStatus.Published)";
            const archivedStatus = "@((int)PublicationStatus.Archived)";

            const titleInput = document.getElementById("songTitle");
            const albumSelect = document.getElementById("albumSelect");
            const publicationSection = document.getElementById("publicationSection");
            const albumPublicationInfo = document.getElementById("albumPublicationInfo");
            const publicationStatusSelect = document.getElementById("publicationStatusSelect");
            const scheduledPublishGroup = document.getElementById("scheduledPublishGroup");
            const scheduledPublishInput = document.getElementById("scheduledPublishInput");
            const publicationInfo = document.getElementById("publicationInfo");
            const previewTitle = document.getElementById("previewTitle");
            const previewAlbum = document.getElementById("previewAlbum");
            const previewGenreCount = document.getElementById("previewGenreCount");
            const previewPublicationStatus = document.getElementById("previewPublicationStatus");
            const selectedGenreCount = document.getElementById("selectedGenreCount");
            const audioFileInput = document.getElementById("audioFileInput");
            const selectedAudio = document.getElementById("selectedAudio");
            const selectedAudioName = document.getElementById("selectedAudioName");
            const selectedAudioSize = document.getElementById("selectedAudioSize");
            const genreSearch = document.getElementById("genreSearch");
            const genreOptions = document.querySelectorAll(".genre-option");
            const genreCheckboxes = document.querySelectorAll(".genre-checkbox");

            function updateTitlePreview() {
                previewTitle.textContent =
                    titleInput.value.trim() || "Şarkı adı";
            }

            function updateAlbumPreview() {
                const selectedOption =
                    albumSelect.options[albumSelect.selectedIndex];

                previewAlbum.textContent =
                    selectedOption && selectedOption.value !== ""
                        ? selectedOption.text
                        : "Single";
            }

            function updateGenreCount() {
                const count =
                    document.querySelectorAll(".genre-checkbox:checked").length;

                selectedGenreCount.textContent = count;
                previewGenreCount.textContent = count;
            }

            function updateAudioInfo() {
                const file = audioFileInput.files[0];

                if (!file) {
                    selectedAudio.classList.remove("visible");
                    return;
                }

                selectedAudioName.textContent = file.name;

                selectedAudioSize.textContent =
                    ` — ${(file.size / 1024 / 1024).toFixed(2)} MB`;

                selectedAudio.classList.add("visible");
            }

            function updatePublicationFields() {
                const selectedStatus =
                    publicationStatusSelect.value;

                if (selectedStatus === scheduledStatus) {
                    scheduledPublishGroup.classList.add("visible");
                    scheduledPublishInput.required = true;
                    publicationInfo.innerHTML =
                        "<strong>Planlandı:</strong> Şarkı seçilen cuma günü yayınlanacak.";
                    previewPublicationStatus.textContent = "Planlandı";
                    return;
                }

                scheduledPublishGroup.classList.remove("visible");
                scheduledPublishInput.required = false;

                if (selectedStatus === publishedStatus) {
                    publicationInfo.innerHTML =
                        "<strong>Yayında:</strong> Şarkının yayın durumu yayındadır.";
                    previewPublicationStatus.textContent = "Yayında";
                    return;
                }

                if (selectedStatus === archivedStatus) {
                    publicationInfo.innerHTML =
                        "<strong>Arşivlendi:</strong> Şarkı normal kullanıcılara gösterilmez.";
                    previewPublicationStatus.textContent = "Arşivlendi";
                    return;
                }

                publicationInfo.innerHTML =
                    "<strong>Taslak:</strong> Şarkı yalnızca sanatçı panelinde görünür.";

                previewPublicationStatus.textContent = "Taslak";
            }

            function updateAlbumBehavior() {
                const hasAlbum =
                    albumSelect.value !== "";

                if (hasAlbum) {
                    publicationSection.classList.add("hidden");
                    albumPublicationInfo.classList.add("visible");
                    previewPublicationStatus.textContent = "Albümü takip ediyor";
                    return;
                }

                publicationSection.classList.remove("hidden");
                albumPublicationInfo.classList.remove("visible");
                updatePublicationFields();
            }

            titleInput.addEventListener("input", updateTitlePreview);
            audioFileInput.addEventListener("change", updateAudioInfo);

            if (!albumSelect.disabled) {
                albumSelect.addEventListener("change", function() {
                    updateAlbumPreview();
                    updateAlbumBehavior();
                });
            }

            publicationStatusSelect.addEventListener(
                "change",
                updatePublicationFields);

            genreCheckboxes.forEach(function(checkbox) {
                checkbox.addEventListener("change", updateGenreCount);
            });

            genreSearch.addEventListener("input", function() {
                const search =
                    genreSearch.value.trim().toLowerCase();

                genreOptions.forEach(function(option) {
                    option.style.display =
                        option.dataset.genreName.includes(search)
                            ? "block"
                            : "none";
                });
            });

            updateTitlePreview();
            updateAlbumPreview();
            updateGenreCount();
            updatePublicationFields();
            updateAlbumBehavior();
        });
    </script>
}