@model MusicProject.ViewModels.ArtistDashboard.CreateAlbumViewModel

@{
    ViewData["Title"] = "Yeni Albüm";
    ViewData["PageDescription"] = "Yeni bir albüm oluştur ve kataloğuna ekle.";
    Layout = "_ArtistLayout";
}

@section Styles {
    <style>
        .create-album-content {
            max-width: 920px;
            margin: 0 auto;
            padding: 32px 34px 50px;
        }

        .create-album-header {
            padding: 28px;
            display: flex;
            align-items: center;
            gap: 20px;
            background: linear-gradient(125deg, rgba(30, 215, 96, 0.18), rgba(18, 23, 19, 0.97) 65%);
            border: 1px solid rgba(30, 215, 96, 0.20);
            border-radius: 21px;
        }

        .create-album-header-icon {
            width: 82px;
            height: 82px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: #071008;
            background-color: var(--primary);
            border-radius: 18px;
            font-size: 37px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.28);
        }

        .create-album-header-label {
            color: var(--primary);
            font-size: 11px;
            font-weight: 850;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .create-album-header-title {
            margin-top: 7px;
            color: #ffffff;
            font-size: clamp(25px, 4vw, 36px);
        }

        .create-album-header-description {
            margin-top: 8px;
            color: var(--text-secondary);
            font-size: 13px;
            line-height: 1.6;
        }

        .create-album-card {
            margin-top: 22px;
            padding: 28px;
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 19px;
        }

        .create-album-validation-summary {
            margin-bottom: 22px;
            padding: 14px 16px;
            color: #ff9b9b;
            background-color: rgba(255, 92, 92, 0.09);
            border: 1px solid rgba(255, 92, 92, 0.22);
            border-radius: 11px;
            font-size: 13px;
        }

        .validation-summary-valid {
            display: none;
        }

        .create-album-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 21px;
        }

        .create-album-group {
            margin-bottom: 21px;
        }

            .create-album-group.full-width {
                grid-column: 1 / -1;
            }

        .create-album-label {
            display: block;
            margin-bottom: 8px;
            color: #ffffff;
            font-size: 13px;
            font-weight: 750;
        }

        .create-album-input,
        .create-album-textarea {
            width: 100%;
            padding: 13px 15px;
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.045);
            border: 1px solid var(--border);
            border-radius: 11px;
            outline: none;
            font-size: 14px;
            transition: 0.2s;
        }

            .create-album-input:focus,
            .create-album-textarea:focus {
                background-color: rgba(255, 255, 255, 0.065);
                border-color: rgba(30, 215, 96, 0.65);
                box-shadow: 0 0 0 3px rgba(30, 215, 96, 0.08);
            }

            .create-album-input::placeholder,
            .create-album-textarea::placeholder {
                color: #687169;
            }

        .create-album-textarea {
            min-height: 135px;
            resize: vertical;
            line-height: 1.6;
        }

        .create-album-hint {
            display: block;
            margin-top: 7px;
            color: var(--text-secondary);
            font-size: 11px;
            line-height: 1.5;
        }

        .create-album-validation {
            display: block;
            margin-top: 7px;
            color: #ff8585;
            font-size: 12px;
        }

        .create-album-preview {
            margin-top: 10px;
            padding: 14px;
            display: none;
            align-items: center;
            gap: 14px;
            background-color: rgba(255, 255, 255, 0.025);
            border: 1px solid var(--border);
            border-radius: 12px;
        }

            .create-album-preview.visible {
                display: flex;
            }

        .create-album-preview-image {
            width: 75px;
            height: 75px;
            flex-shrink: 0;
            object-fit: cover;
            background-color: #0c110e;
            border-radius: 10px;
        }

        .create-album-preview-title {
            color: #ffffff;
            font-size: 12px;
            font-weight: 750;
        }

        .create-album-preview-description {
            margin-top: 5px;
            color: var(--text-secondary);
            font-size: 11px;
        }

        .create-album-actions {
            margin-top: 9px;
            padding-top: 23px;
            display: flex;
            justify-content: flex-end;
            gap: 11px;
            border-top: 1px solid var(--border);
        }

        .create-album-cancel,
        .create-album-save {
            min-height: 43px;
            padding: 0 19px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            font-size: 12px;
            font-weight: 800;
            transition: 0.2s;
        }

        .create-album-cancel {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border);
        }

            .create-album-cancel:hover {
                color: var(--primary);
                border-color: rgba(30, 215, 96, 0.35);
            }

        .create-album-save {
            color: #071008;
            background-color: var(--primary);
            border: none;
            cursor: pointer;
        }

            .create-album-save:hover {
                background-color: var(--primary-hover);
                transform: translateY(-2px);
            }

        @@media (max-width: 750px) {
            .create-album-content {
                padding: 22px 16px 40px;
            }

            .create-album-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .create-album-grid {
                grid-template-columns: 1fr;
            }

            .create-album-group.full-width {
                grid-column: auto;
            }
        }

        @@media (max-width: 520px) {
            .create-album-card {
                padding: 20px;
            }

            .create-album-actions {
                flex-direction: column-reverse;
            }

            .create-album-cancel,
            .create-album-save {
                width: 100%;
            }
        }
    </style>
}

<div class="create-album-content">

    <section class="create-album-header">

        <div class="create-album-header-icon">
            ◉
        </div>

        <div>
            <p class="create-album-header-label">
                Albüm yönetimi
            </p>

            <h2 class="create-album-header-title">
                Yeni Albüm Oluştur
            </h2>

            <p class="create-album-header-description">
                Albüm bilgilerini girerek sanatçı kataloğuna yeni bir albüm ekleyebilirsin.
            </p>
        </div>

    </section>

    <section class="create-album-card">

        <div asp-validation-summary="ModelOnly"
             class="create-album-validation-summary">
        </div>

        <form asp-controller="ArtistDashboard"
              asp-action="CreateAlbum"
              method="post">

            @Html.AntiForgeryToken()

            <div class="create-album-grid">

                <div class="create-album-group">

                    <label asp-for="Name"
                           class="create-album-label">
                        Albüm Adı
                    </label>

                    <input asp-for="Name"
                           class="create-album-input"
                           placeholder="Albüm adını yaz" />

                    <span asp-validation-for="Name"
                          class="create-album-validation">
                    </span>

                </div>

                <div class="create-album-group">

                    <label asp-for="ReleaseDate"
                           class="create-album-label">
                        Yayın Tarihi
                    </label>

                    <input asp-for="ReleaseDate"
                           type="date"
                           class="create-album-input" />

                    <span asp-validation-for="ReleaseDate"
                          class="create-album-validation">
                    </span>

                </div>

                <div class="create-album-group full-width">

                    <label asp-for="Description"
                           class="create-album-label">
                        Açıklama
                    </label>

                    <textarea asp-for="Description"
                              class="create-album-textarea"
                              placeholder="Albüm hakkında kısa bir açıklama yaz"></textarea>

                    <span class="create-album-hint">
                        Açıklama isteğe bağlıdır ve en fazla 1000 karakter olabilir.
                    </span>

                    <span asp-validation-for="Description"
                          class="create-album-validation">
                    </span>

                </div>

                <div class="create-album-group full-width">

                    <label asp-for="CoverImageUrl"
                           class="create-album-label">
                        Kapak Görseli Adresi
                    </label>

                    <input asp-for="CoverImageUrl"
                           class="create-album-input"
                           id="coverImageUrlInput"
                           placeholder="https://ornek.com/album-kapagi.jpg" />

                    <span class="create-album-hint">
                        Doğrudan açılabilen bir görsel bağlantısı kullanmalısın. Bu alan isteğe bağlıdır.
                    </span>

                    <span asp-validation-for="CoverImageUrl"
                          class="create-album-validation">
                    </span>

                    <div class="create-album-preview"
                         id="coverImagePreview">

                        <img src=""
                             alt="Albüm kapak önizlemesi"
                             class="create-album-preview-image"
                             id="coverImagePreviewImage" />

                        <div>
                            <p class="create-album-preview-title">
                                Kapak görseli önizlemesi
                            </p>

                            <p class="create-album-preview-description">
                                Bağlantı geçerliyse seçtiğin görsel burada gösterilir.
                            </p>
                        </div>

                    </div>

                </div>

            </div>

            <div class="create-album-actions">

                <a asp-controller="ArtistDashboard"
                   asp-action="MyAlbums"
                   class="create-album-cancel">
                    Vazgeç
                </a>

                <button type="submit"
                        class="create-album-save">
                    Albümü Oluştur
                </button>

            </div>

        </form>

    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const coverInput = document.getElementById("coverImageUrlInput");
            const preview = document.getElementById("coverImagePreview");
            const previewImage = document.getElementById("coverImagePreviewImage");

            if (!coverInput || !preview || !previewImage) {
                return;
            }

            function updatePreview() {
                const imageUrl = coverInput.value.trim();

                if (!imageUrl) {
                    preview.classList.remove("visible");
                    previewImage.removeAttribute("src");
                    return;
                }

                previewImage.src = imageUrl;
                preview.classList.add("visible");
            }

            previewImage.addEventListener("error", function() {
                preview.classList.remove("visible");
            });

            coverInput.addEventListener("input", updatePreview);

            updatePreview();
        });
    </script>
}