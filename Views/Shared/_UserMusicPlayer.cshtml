<div class="music-player">

    <div class="playing-song">

        <div class="playing-cover">
            ♪
        </div>

        <div class="playing-info">

            <div class="playing-name"
                 id="playingSongName">
                Henüz şarkı seçilmedi
            </div>

            <div class="playing-artist"
                 id="playingSongArtist">
                Bir şarkıyı oynat
            </div>

        </div>

        <button type="button"
                class="like-button"
                title="Şarkıyı beğen">
            ♡
        </button>

    </div>

    <div class="player-center">

        <div class="player-controls">

            <button type="button"
                    class="player-control"
                    title="Karıştır">
                ⤨
            </button>

            <button type="button"
                    class="player-control"
                    title="Önceki">
                ◀
            </button>

            <button type="button"
                    class="main-play-button"
                    id="mainPlayButton"
                    title="Oynat">
                ▶
            </button>

            <button type="button"
                    class="player-control"
                    title="Sonraki">
                ▶
            </button>

            <button type="button"
                    class="player-control"
                    title="Tekrarla">
                ↻
            </button>

        </div>

        <div class="progress-area">

            <span class="progress-time">
                0:00
            </span>

            <div class="progress-line">
                <div class="progress-value"></div>
            </div>

            <span class="progress-time">
                0:00
            </span>

        </div>

    </div>

    <div class="player-right">

        <span>
            🔊
        </span>

        <div class="volume-line">
            <div class="volume-value"></div>
        </div>

    </div>

</div>
