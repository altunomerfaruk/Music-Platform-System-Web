@model MusicProject.ViewModels.AdminDashboard.AdminLayoutViewModel

@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Admin Paneli";

    var pageDescription =
        ViewData["PageDescription"]?.ToString() ??
        "Platform yönetimini buradan gerçekleştirebilirsin.";

    var adminName = User.Identity?.Name ?? "Admin";

    var adminInitial = string.IsNullOrWhiteSpace(adminName)
        ? "A"
        : char.ToUpperInvariant(adminName.Trim()[0]).ToString();

    var action = ViewContext.RouteData.Values["action"]?.ToString();

    var isDashboard = action == "Index";
    var isUsers = action == "Users";
}

<!DOCTYPE html>
<html lang="tr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle - MusicProject</title>

    <style>
        :root {
            --background: #080b09;
            --sidebar: #0d110f;
            --card: #121713;
            --card-hover: #171e19;
            --border: rgba(255, 255, 255, 0.08);
            --primary: #1ed760;
            --primary-hover: #25e66d;
            --primary-dark: #18b950;
            --text: #ffffff;
            --text-secondary: #9da6a0;
            --danger: #ff5c5c;
            --warning: #ffbd3d;
            --info: #55aaff;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            overflow-x: hidden;
            color: var(--text);
            background:
                radial-gradient(circle at 75% 5%, rgba(30, 215, 96, 0.10), transparent 24%),
                var(--background);
            font-family: Inter, Arial, Helvetica, sans-serif;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button,
        input,
        select,
        textarea {
            font-family: inherit;
        }

        button {
            cursor: pointer;
        }

        .admin-layout {
            min-height: 100vh;
            display: flex;
        }

        .admin-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            width: 265px;
            height: 100vh;
            padding: 24px 17px;
            display: flex;
            flex-direction: column;
            background-color: rgba(13, 17, 15, 0.97);
            border-right: 1px solid var(--border);
            backdrop-filter: blur(15px);
            transition: transform 0.25s ease;
        }

        .admin-brand {
            padding: 0 12px 26px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid var(--border);
        }

        .admin-brand-icon {
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: #071009;
            background-color: var(--primary);
            border-radius: 14px;
            font-size: 24px;
            font-weight: 900;
            box-shadow: 0 8px 25px rgba(30, 215, 96, 0.22);
        }

        .admin-brand-name {
            display: block;
            color: #ffffff;
            font-size: 19px;
            font-weight: 800;
        }

        .admin-brand-panel {
            display: block;
            margin-top: 3px;
            color: var(--text-secondary);
            font-size: 12px;
        }

        .admin-navigation {
            margin-top: 26px;
            flex: 1;
            overflow-x: hidden;
            overflow-y: auto;
        }

        .admin-navigation-title {
            margin: 0 13px 10px;
            color: #687169;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.4px;
            text-transform: uppercase;
        }

        .admin-system-title {
            margin-top: 27px;
        }

        .admin-navigation-list {
            list-style: none;
        }

        .admin-navigation-item {
            margin-bottom: 6px;
        }

        .admin-navigation-link {
            min-height: 48px;
            padding: 0 14px;
            display: flex;
            align-items: center;
            gap: 13px;
            color: var(--text-secondary);
            border-radius: 12px;
            font-size: 14px;
            font-weight: 700;
            transition: 0.2s ease;
        }

        .admin-navigation-link:hover {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.05);
        }

        .admin-navigation-link.active {
            color: #061108;
            background-color: var(--primary);
            box-shadow: 0 9px 28px rgba(30, 215, 96, 0.16);
        }

        .admin-navigation-icon {
            width: 23px;
            flex-shrink: 0;
            text-align: center;
            font-size: 18px;
        }

        .admin-navigation-badge {
            min-width: 25px;
            margin-left: auto;
            padding: 4px 7px;
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.12);
            border-radius: 20px;
            text-align: center;
            font-size: 11px;
        }

        .admin-navigation-link.active .admin-navigation-badge {
            color: #ffffff;
            background-color: rgba(0, 0, 0, 0.25);
        }

        .admin-sidebar-footer {
            padding-top: 17px;
            border-top: 1px solid var(--border);
        }

        .admin-profile-small {
            padding: 11px;
            display: flex;
            align-items: center;
            gap: 11px;
            background-color: rgba(255, 255, 255, 0.035);
            border-radius: 13px;
        }

        .admin-profile-avatar {
            width: 39px;
            height: 39px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: #08110a;
            background-color: var(--primary);
            border-radius: 50%;
            font-weight: 900;
        }

        .admin-profile-info {
            min-width: 0;
            flex: 1;
        }

        .admin-profile-name {
            overflow: hidden;
            color: #ffffff;
            font-size: 13px;
            font-weight: 800;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .admin-profile-role {
            margin-top: 3px;
            color: var(--text-secondary);
            font-size: 11px;
        }

        .admin-logout {
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
            border-radius: 9px;
            transition: 0.2s;
        }

        .admin-logout:hover {
            color: var(--danger);
            background-color: rgba(255, 92, 92, 0.10);
        }

        .admin-main {
            width: calc(100% - 265px);
            min-height: 100vh;
            margin-left: 265px;
        }

        .admin-topbar {
            position: sticky;
            top: 0;
            z-index: 900;
            min-height: 78px;
            padding: 16px 34px;
            display: flex;
            align-items: center;
            gap: 15px;
            background-color: rgba(8, 11, 9, 0.83);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(18px);
        }

        .admin-menu-button {
            width: 42px;
            height: 42px;
            display: none;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: #ffffff;
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 11px;
            font-size: 20px;
        }

        .admin-page-heading h1 {
            color: #ffffff;
            font-size: 22px;
            font-weight: 850;
        }

        .admin-page-heading p {
            margin-top: 5px;
            color: var(--text-secondary);
            font-size: 13px;
        }

        .admin-sidebar-overlay {
            position: fixed;
            inset: 0;
            z-index: 950;
            display: none;
            background-color: rgba(0, 0, 0, 0.65);
        }

        @@media (max-width: 900px) {
            .admin-sidebar {
                transform: translateX(-100%);
            }

            .admin-sidebar.open {
                transform: translateX(0);
            }

            .admin-sidebar-overlay.open {
                display: block;
            }

            .admin-main {
                width: 100%;
                margin-left: 0;
            }

            .admin-menu-button {
                display: flex;
            }
        }

        @@media (max-width: 650px) {
            .admin-topbar {
                padding: 14px 17px;
            }

            .admin-page-heading p {
                display: none;
            }
        }
    </style>

    @RenderSection("Styles", required: false)

</head>

<body>

    <div class="admin-layout">

        <aside class="admin-sidebar" id="adminSidebar">

            <a asp-controller="AdminDashboard"
               asp-action="Index"
               class="admin-brand">

                <div class="admin-brand-icon">
                    ♪
                </div>

                <div>

                    <span class="admin-brand-name">
                        MusicProject
                    </span>

                    <span class="admin-brand-panel">
                        Yönetim paneli
                    </span>

                </div>

            </a>

            <nav class="admin-navigation">

                <p class="admin-navigation-title">
                    Yönetim
                </p>

                <ul class="admin-navigation-list">

                    <li class="admin-navigation-item">

                        <a asp-controller="AdminDashboard"
                           asp-action="Index"
                           class="admin-navigation-link @(isDashboard ? "active" : "")">

                            <span class="admin-navigation-icon">
                                ▦
                            </span>

                            Genel Bakış

                        </a>

                    </li>

                    <li class="admin-navigation-item">

                        <a asp-controller="AdminDashboard"
                           asp-action="Users"
                           class="admin-navigation-link @(isUsers ? "active" : "")">

                            <span class="admin-navigation-icon">
                                👥
                            </span>

                            Kullanıcılar

                            <span class="admin-navigation-badge">
                                @Model.TotalUsers
                            </span>

                        </a>

                    </li>

                    <li class="admin-navigation-item">

                        <span class="admin-navigation-link">

                            <span class="admin-navigation-icon">
                                ★
                            </span>

                            Sanatçılar

                            <span class="admin-navigation-badge">
                                @Model.TotalArtists
                            </span>

                        </span>

                    </li>

                    <li class="admin-navigation-item">

                        <span class="admin-navigation-link">

                            <span class="admin-navigation-icon">
                                ♫
                            </span>

                            Şarkılar

                            <span class="admin-navigation-badge">
                                @Model.TotalSongs
                            </span>

                        </span>

                    </li>

                </ul>

                <p class="admin-navigation-title admin-system-title">
                    Sistem
                </p>

                <ul class="admin-navigation-list">

                    <li class="admin-navigation-item">

                        <a href="/hangfire"
                           class="admin-navigation-link">

                            <span class="admin-navigation-icon">
                                ⚙
                            </span>

                            Hangfire

                        </a>

                    </li>

                    <li class="admin-navigation-item">

                        <a href="/"
                           class="admin-navigation-link">

                            <span class="admin-navigation-icon">
                                ↗
                            </span>

                            Siteyi Görüntüle

                        </a>

                    </li>

                </ul>

            </nav>

            <div class="admin-sidebar-footer">

                <div class="admin-profile-small">

                    <div class="admin-profile-avatar">
                        @adminInitial
                    </div>

                    <div class="admin-profile-info">

                        <div class="admin-profile-name">
                            @adminName
                        </div>

                        <div class="admin-profile-role">
                            Admin
                        </div>

                    </div>

                    <a asp-controller="Auth"
                       asp-action="Logout"
                       class="admin-logout"
                       title="Çıkış Yap">
                        ↪
                    </a>

                </div>

            </div>

        </aside>

        <div class="admin-sidebar-overlay"
             id="adminSidebarOverlay">
        </div>

        <main class="admin-main">

            <header class="admin-topbar">

                <button type="button"
                        class="admin-menu-button"
                        id="adminMenuButton">
                    ☰
                </button>

                <div class="admin-page-heading">

                    <h1>
                        @pageTitle
                    </h1>

                    <p>
                        @pageDescription
                    </p>

                </div>

            </header>

            @RenderBody()

        </main>

    </div>

    <script>
        const adminMenuButton = document.getElementById("adminMenuButton");
        const adminSidebar = document.getElementById("adminSidebar");
        const adminSidebarOverlay = document.getElementById("adminSidebarOverlay");

        function openAdminSidebar() {
            adminSidebar.classList.add("open");
            adminSidebarOverlay.classList.add("open");
        }

        function closeAdminSidebar() {
            adminSidebar.classList.remove("open");
            adminSidebarOverlay.classList.remove("open");
        }

        if (adminMenuButton) {
            adminMenuButton.addEventListener("click", openAdminSidebar);
        }

        if (adminSidebarOverlay) {
            adminSidebarOverlay.addEventListener("click", closeAdminSidebar);
        }
    </script>

    @RenderSection("Scripts", required: false)

</body>

</html>