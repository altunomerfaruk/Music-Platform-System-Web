@model MusicProject.ViewModels.UserDashboard.UserDashboardViewModel

@{
    ViewData["Title"] = "Kullanıcı Paneli";
    Layout = "_UserLayout";

    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    var searchSuggestionsUrl = Url.Action("SearchSuggestions", "UserDashboard");
    var searchResultsUrl = Url.Action("Search", "UserDashboard");
    var songDetailsUrl = Url.Action("SongDetails", "UserDashboard");
    var artistDetailsUrl = Url.Action("ArtistDetails", "UserDashboard");
    var albumDetailsUrl = Url.Action("AlbumDetails", "UserDashboard");
}

@section Styles {
    <style>
        .live-search-container {
            position: relative;
            width: 100%;
            max-width: 430px;
        }

        .live-search-container .search-box {
            width: 100%;
        }

        .search-suggestions {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            left: 0;
            z-index: 1500;
            display: none;
            max-height: 440px;
            overflow-y: auto;
            background-color: #101612;
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: 0 22px 55px rgba(0, 0, 0, 0.50);
        }

        .search-suggestions.show {
            display: block;
        }

        .suggestion-loading,
        .suggestion-empty {
            padding: 22px 16px;
            color: var(--text-secondary);
            font-size: 12px;
            text-align: center;
        }

        .suggestion-group {
            padding: 9px 0;
            border-bottom: 1px solid var(--border);
        }

        .suggestion-group:last-of-type {
            border-bottom: none;
        }

        .suggestion-group-title {
            padding: 5px 15px 9px;
            color: var(--primary);
            font-size: 10px;
            font-weight: 850;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .suggestion-item {
            padding: 10px 15px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: inherit;
            text-decoration: none;
            transition: 0.2s;
        }

        .suggestion-item:hover,
        .suggestion-item.active {
            background-color: var(--card-hover);
        }

        .suggestion-icon {
            width: 39px;
            height: 39px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: var(--primary);
            background-color: rgba(30, 215, 96, 0.11);
            border-radius: 10px;
            font-size: 16px;
        }

        .suggestion-content {
            min-width: 0;
        }

        .suggestion-name {
            overflow: hidden;
            color: white;
            font-size: 12px;
            font-weight: 800;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .suggestion-subtitle {
            margin-top: 3px;
            overflow: hidden;
            color: var(--text-secondary);
            font-size: 10px;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .suggestion-all-results {
            padding: 14px 15px;
            display: block;
            color: var(--primary);
            font-size: 11px;
            font-weight: 850;
            text-align: center;
            text-decoration: none;
            border-top: 1px solid var(--border);
            transition: 0.2s;
        }

        .suggestion-all-results:hover {
            background-color: var(--card-hover);
        }

        .history-empty {
            padding: 36px 20px;
            text-align: center;
        }

        .history-empty-icon {
            margin-bottom: 12px;
            color: var(--primary);
            font-size: 34px;
        }

        .history-empty-text {
            margin: 0;
            color: var(--text-secondary);
            font-size: 12px;
        }

        .history-album-link {
            color: inherit;
            text-decoration: none;
            transition: 0.2s;
        }

        .history-album-link:hover {
            color: var(--primary);
        }

        @@media (max-width: 900px) {
            .live-search-container {
                max-width: none;
            }
        }
    </style>
}

<main class="main-content">

    <header class="topbar">

        <div class="topbar-left">

            <button type="button"
                    class="menu-button"
                    id="menuButton">
                ☰
            </button>

            <div class="page-heading">

                <h1>
                    Ana Sayfa
                </h1>

                <p>
                    Sevdiğin müzikleri keşfet ve dinlemeye başla.
                </p>

            </div>

        </div>

        <div class="topbar-actions">

            <div class="live-search-container"
                 id="liveSearchContainer">

                <form asp-controller="UserDashboard"
                      asp-action="Search"
                      method="get"
                      class="search-box"
                      id="searchForm">

                    <span>
                        ⌕
                    </span>

                    <input type="text"
                           name="query"
                           id="searchInput"
                           placeholder="Şarkı, sanatçı veya albüm ara..."
                           autocomplete="off"
                           aria-label="Şarkı, sanatçı veya albüm ara"
                           aria-controls="searchSuggestions"
                           aria-expanded="false" />

                </form>

                <div class="search-suggestions"
                     id="searchSuggestions"
                     role="listbox">
                </div>

            </div>

            <button type="button"
                    class="notification-button"
                    title="Bildirimler">

                ♢

                <span class="notification-dot"></span>

            </button>

        </div>

    </header>

    <div class="dashboard-content">

        <!-- KARŞILAMA ALANI -->
        <section class="welcome-banner">

            <div class="welcome-content">

                <p class="welcome-label">
                    Senin için seçildi
                </p>

                <h2 class="welcome-title">
                    Tekrar hoş geldin, @Model.Username.
                </h2>

                <p class="welcome-description">
                    Yeni yayınlanan şarkıları keşfet, favori sanatçılarını takip et
                    ve beğendiğin müzikleri kendi kitaplığında sakla.
                </p>

                <div class="welcome-actions">

                    <a asp-controller="UserDashboard"
                       asp-action="AllSongs"
                       class="primary-button">
                        ▶ Dinlemeye Başla
                    </a>

                    <a asp-controller="UserDashboard"
                       asp-action="AllSongs"
                       class="secondary-button">
                        Şarkıları Keşfet
                    </a>

                </div>

            </div>

            <div class="featured-cover">
                ♪
            </div>

        </section>

        <!-- KULLANICI İSTATİSTİKLERİ -->
        <section class="section">

            <div class="section-header">

                <div>

                    <h3 class="section-title">
                        Müzik özetin
                    </h3>

                    <p class="section-description">
                        Hesabındaki müzik etkinliklerinin kısa özeti
                    </p>

                </div>

            </div>

            <div class="stat-grid">

                <article class="stat-card">

                    <div class="stat-icon">
                        ▶
                    </div>

                    <div class="stat-number"
                         id="totalListeningCount">
                        @Model.TotalListeningCount
                    </div>

                    <div class="stat-label">
                        Toplam dinleme
                    </div>

                </article>

                <article class="stat-card">

                    <div class="stat-icon">
                        ♥
                    </div>

                    <div class="stat-number">
                        @Model.LikedSongIds.Count
                    </div>

                    <div class="stat-label">
                        Beğendiğin şarkı
                    </div>

                </article>

                <article class="stat-card">

                    <div class="stat-icon">
                        ★
                    </div>

                    <div class="stat-number">
                        @Model.FollowedArtistIds.Count
                    </div>

                    <div class="stat-label">
                        Takip ettiğin sanatçı
                    </div>

                </article>

                <article class="stat-card">

                    <div class="stat-icon">
                        ◷
                    </div>

                    <div class="stat-number">
                        @Model.RecentListeningHistory.Count()
                    </div>

                    <div class="stat-label">
                        Son listelenen dinleme
                    </div>

                </article>

            </div>

        </section>

        <!-- POPÜLER ŞARKILAR -->
        <section class="section">

            <div class="section-header">

                <div>

                    <h3 class="section-title">
                        Popüler şarkılar
                    </h3>

                    <p class="section-description">
                        Platformda en çok dinlenen şarkılar
                    </p>

                </div>

                <a asp-controller="UserDashboard"
                   asp-action="AllSongs"
                   class="section-link">
                    Tümünü Gör
                </a>

            </div>

            @if (Model.PopularSongs.Any())
            {
                <div class="song-grid">

                    @foreach (var song in Model.PopularSongs)
                    {
                        var isLiked = Model.LikedSongIds.Contains(song.Id);

                        var likeButtonClass = isLiked
                            ? "like-button liked"
                            : "like-button";

                        var likeButtonTitle = isLiked
                            ? "Beğeniyi kaldır"
                            : "Şarkıyı beğen";

                        var likeButtonIcon = isLiked
                            ? "♥"
                            : "♡";

                        <article class="song-card">

                            <div class="song-card-cover">

                                ♪

                                <button type="button"
                                        class="song-play-button"
                                        data-song-id="@song.Id"
                                        title="@song.Title şarkısını oynat">
                                    ▶
                                </button>

                            </div>

                            <a asp-controller="UserDashboard"
                               asp-action="SongDetails"
                               asp-route-songId="@song.Id"
                               class="song-details-link">

                                <h4 class="song-name">
                                    @song.Title
                                </h4>

                                <p class="song-artist">
                                    @(song.Album?.Name ?? "Albüm bilgisi yok")
                                </p>

                            </a>

                            <div class="song-card-footer">

                                <span class="song-duration">
                                    @(song.SongStat?.TotalStreams ?? 0) dinlenme
                                </span>

                                <form asp-controller="UserDashboard"
                                      asp-action="ToggleLike"
                                      method="post"
                                      class="like-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="songId"
                                           value="@song.Id" />

                                    <input type="hidden"
                                           name="returnUrl"
                                           value="@currentUrl" />

                                    <button type="submit"
                                            class="@likeButtonClass"
                                            title="@likeButtonTitle">
                                        @likeButtonIcon
                                    </button>

                                </form>

                            </div>

                        </article>
                    }

                </div>
            }
            else
            {
                <div class="panel"
                     style="padding: 24px;">

                    <p class="section-description"
                       style="margin: 0;">
                        Henüz gösterilecek popüler şarkı bulunmuyor.
                    </p>

                </div>
            }

        </section>

        <!-- SANATÇILAR -->
        <section class="section">

            <div class="section-header">

                <div>

                    <h3 class="section-title">
                        Keşfedebileceğin sanatçılar
                    </h3>

                    <p class="section-description">
                        Yeni sanatçılarla ve yeni müziklerle tanış
                    </p>

                </div>

                <a asp-controller="UserDashboard"
                   asp-action="AllArtists"
                   class="section-link">
                    Tüm Sanatçılar
                </a>

            </div>

            @if (Model.Artists.Any())
            {
                <div class="artist-grid">

                    @foreach (var artist in Model.Artists.Take(6))
                    {
                        var isFollowed = Model.FollowedArtistIds.Contains(artist.Id);

                        var followButtonClass = isFollowed
                            ? "follow-button followed"
                            : "follow-button";

                        var followButtonTitle = isFollowed
                            ? "Takipten çık"
                            : "Sanatçıyı takip et";

                        var followButtonText = isFollowed
                            ? "Takip Ediliyor"
                            : "Takip Et";

                        <article class="artist-card">

                            <a asp-controller="UserDashboard"
                               asp-action="ArtistDetails"
                               asp-route-artistId="@artist.Id"
                               class="artist-details-link">

                                <div class="artist-image">
                                    @(string.IsNullOrWhiteSpace(artist.Name)
                                        ? "?"
                                        : artist.Name.Substring(0, 1).ToUpper())
                                </div>

                                <h4 class="artist-name">
                                    @artist.Name
                                </h4>

                                <p class="artist-label">
                                    Sanatçı
                                </p>

                            </a>

                            <form asp-controller="UserDashboard"
                                  asp-action="ToggleFollow"
                                  method="post"
                                  class="follow-form">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="artistId"
                                       value="@artist.Id" />

                                <input type="hidden"
                                       name="returnUrl"
                                       value="@currentUrl" />

                                <button type="submit"
                                        class="@followButtonClass"
                                        title="@followButtonTitle">
                                    @followButtonText
                                </button>

                            </form>

                        </article>
                    }

                </div>
            }
            else
            {
                <div class="panel"
                     style="padding: 24px;">

                    <p class="section-description"
                       style="margin: 0;">
                        Henüz gösterilecek sanatçı bulunmuyor.
                    </p>

                </div>
            }

        </section>

        <!-- SON DİNLENENLER -->
        <section class="section panel">

            <div class="panel-header">

                <div>

                    <h3 class="section-title">
                        Son dinlediklerin
                    </h3>

                    <p class="section-description">
                        Kaldığın yerden dinlemeye devam et
                    </p>

                </div>

                <a asp-controller="UserDashboard"
                   asp-action="ListeningHistory"
                   class="section-link">
                    Geçmişi Gör
                </a>

            </div>

            @if (Model.RecentListeningHistory.Any())
            {
                <div class="table-wrapper">

                    <table class="data-table">

                        <thead>
                            <tr>
                                <th>Şarkı</th>
                                <th>Albüm</th>
                                <th>Tür</th>
                                <th>Dinlenme zamanı</th>
                                <th>Dinle</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var history in Model.RecentListeningHistory)
                            {
                                <tr>

                                    <td>

                                        <a asp-controller="UserDashboard"
                                           asp-action="SongDetails"
                                           asp-route-songId="@history.SongId"
                                           class="song-details-link">

                                            <div class="table-song">

                                                <div class="table-cover">
                                                    ♪
                                                </div>

                                                <div>

                                                    <div class="cell-title">
                                                        @history.SongTitle
                                                    </div>

                                                    <div class="cell-subtitle">
                                                        @history.ArtistName
                                                    </div>

                                                </div>

                                            </div>

                                        </a>

                                    </td>

                                    <td>

                                        @if (history.AlbumId.HasValue)
                                        {
                                            <a asp-controller="UserDashboard"
                                               asp-action="AlbumDetails"
                                               asp-route-albumId="@history.AlbumId"
                                               class="history-album-link">
                                                @history.AlbumName
                                            </a>
                                        }
                                        else
                                        {
                                            @history.AlbumName
                                        }

                                    </td>

                                    <td>
                                        @history.GenreName
                                    </td>

                                    <td>
                                        @* DEĞİŞİKLİK:
                                           Zincir ifade tamamen @() içine alındı.
                                           Böylece metotlar ekrana düz yazı olarak basılmaz. *@
                                        @(history.ListenedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                                    </td>

                                    <td>

                                        <button type="button"
                                                class="table-play-button"
                                                data-song-id="@history.SongId"
                                                title="@history.SongTitle şarkısını oynat">
                                            ▶
                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="history-empty">

                    <div class="history-empty-icon">
                        ◷
                    </div>

                    <p class="history-empty-text">
                        Henüz bir şarkı dinlemedin. Oynat butonuna bastığında burada görünecek.
                    </p>

                </div>
            }

        </section>

    </div>

</main>

<!-- ALT MÜZİK OYNATICI -->
<div class="music-player">

    <div class="playing-song">

        <div class="playing-cover">
            ♪
        </div>

        <div class="playing-info">

            <div class="playing-name"
                 id="playingSongName">
                Henüz şarkı seçilmedi
            </div>

            <div class="playing-artist"
                 id="playingSongArtist">
                Bir şarkıyı oynat
            </div>

        </div>

        <button type="button"
                class="like-button"
                title="Şarkıyı beğen">
            ♡
        </button>

    </div>

    <div class="player-center">

        <div class="player-controls">

            <button type="button"
                    class="player-control"
                    title="Karıştır">
                ⤨
            </button>

            <button type="button"
                    class="player-control"
                    title="Önceki">
                ◀
            </button>

            <button type="button"
                    class="main-play-button"
                    id="mainPlayButton"
                    title="Oynat">
                ▶
            </button>

            <button type="button"
                    class="player-control"
                    title="Sonraki">
                ▶
            </button>

            <button type="button"
                    class="player-control"
                    title="Tekrarla">
                ↻
            </button>

        </div>

        <div class="progress-area">

            <span class="progress-time">
                0:00
            </span>

            <div class="progress-line">
                <div class="progress-value"></div>
            </div>

            <span class="progress-time">
                0:00
            </span>

        </div>

    </div>

    <div class="player-right">

        <span>
            🔊
        </span>

        <div class="volume-line">
            <div class="volume-value"></div>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        const mainPlayButton = document.getElementById("mainPlayButton");

        mainPlayButton?.addEventListener("click", function () {
            if (mainPlayButton.textContent.trim() === "▶") {
                mainPlayButton.textContent = "Ⅱ";
                mainPlayButton.title = "Duraklat";
            }
            else {
                mainPlayButton.textContent = "▶";
                mainPlayButton.title = "Oynat";
            }
        });

        // CANLI ARAMA
        const liveSearchContainer = document.getElementById("liveSearchContainer");
        const searchInput = document.getElementById("searchInput");
        const searchSuggestions = document.getElementById("searchSuggestions");

        const searchSuggestionsUrl = "@searchSuggestionsUrl";
        const searchResultsUrl = "@searchResultsUrl";
        const songDetailsUrl = "@songDetailsUrl";
        const artistDetailsUrl = "@artistDetailsUrl";
        const albumDetailsUrl = "@albumDetailsUrl";

        let searchTimer = null;
        let activeRequestController = null;

        searchInput?.addEventListener("input", function () {
            clearTimeout(searchTimer);

            const query = searchInput.value.trim();

            if (query.length < 2) {
                closeSearchSuggestions();
                return;
            }

            showSearchLoading();

            searchTimer = setTimeout(function () {
                loadSearchSuggestions(query);
            }, 300);
        });

        searchInput?.addEventListener("focus", function () {
            const query = searchInput.value.trim();

            if (query.length >= 2 &&
                searchSuggestions.innerHTML.trim() !== "") {
                openSearchSuggestions();
            }
        });

        async function loadSearchSuggestions(query) {
            if (activeRequestController) {
                activeRequestController.abort();
            }

            activeRequestController = new AbortController();

            try {
                const url =
                    `${searchSuggestionsUrl}?query=${encodeURIComponent(query)}`;

                const response = await fetch(url, {
                    method: "GET",
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    signal: activeRequestController.signal
                });

                if (!response.ok) {
                    throw new Error("Canlı arama sonuçları alınamadı.");
                }

                const data = await response.json();

                if (searchInput.value.trim() !== query) {
                    return;
                }

                renderSearchSuggestions(data, query);
            }
            catch (error) {
                if (error.name === "AbortError") {
                    return;
                }

                console.error(error);
                closeSearchSuggestions();
            }
        }

        function renderSearchSuggestions(data, query) {
            const songs = Array.isArray(data.songs) ? data.songs : [];
            const artists = Array.isArray(data.artists) ? data.artists : [];
            const albums = Array.isArray(data.albums) ? data.albums : [];

            const hasSongs = songs.length > 0;
            const hasArtists = artists.length > 0;
            const hasAlbums = albums.length > 0;

            if (!hasSongs && !hasArtists && !hasAlbums) {
                searchSuggestions.innerHTML = `
                    <div class="suggestion-empty">
                        “${escapeHtml(query)}” için sonuç bulunamadı.
                    </div>

                    <a href="${createSearchResultsUrl(query)}"
                       class="suggestion-all-results">
                        Ayrıntılı arama sayfasını aç
                    </a>
                `;

                openSearchSuggestions();
                return;
            }

            let html = "";

            if (hasSongs) {
                html += createSuggestionGroup(
                    "Şarkılar",
                    songs,
                    songDetailsUrl,
                    "songId",
                    "♪"
                );
            }

            if (hasArtists) {
                html += createSuggestionGroup(
                    "Sanatçılar",
                    artists,
                    artistDetailsUrl,
                    "artistId",
                    "★"
                );
            }

            if (hasAlbums) {
                html += createSuggestionGroup(
                    "Albümler",
                    albums,
                    albumDetailsUrl,
                    "albumId",
                    "▣"
                );
            }

            html += `
                <a href="${createSearchResultsUrl(query)}"
                   class="suggestion-all-results">
                    Tüm sonuçları görüntüle
                </a>
            `;

            searchSuggestions.innerHTML = html;
            openSearchSuggestions();
        }

        function createSuggestionGroup(title, items, baseUrl, routeName, icon) {
            const itemHtml = items.map(function (item) {
                const itemUrl =
                    `${baseUrl}?${routeName}=${encodeURIComponent(item.id)}`;

                return `
                    <a href="${itemUrl}"
                       class="suggestion-item"
                       role="option">

                        <div class="suggestion-icon">
                            ${icon}
                        </div>

                        <div class="suggestion-content">

                            <div class="suggestion-name">
                                ${escapeHtml(item.name)}
                            </div>

                            <div class="suggestion-subtitle">
                                ${escapeHtml(item.subtitle)}
                            </div>

                        </div>

                    </a>
                `;
            }).join("");

            return `
                <div class="suggestion-group">

                    <div class="suggestion-group-title">
                        ${escapeHtml(title)}
                    </div>

                    ${itemHtml}

                </div>
            `;
        }

        function createSearchResultsUrl(query) {
            return `${searchResultsUrl}?query=${encodeURIComponent(query)}`;
        }

        function showSearchLoading() {
            searchSuggestions.innerHTML = `
                <div class="suggestion-loading">
                    Sonuçlar aranıyor...
                </div>
            `;

            openSearchSuggestions();
        }

        function openSearchSuggestions() {
            searchSuggestions.classList.add("show");
            searchInput?.setAttribute("aria-expanded", "true");
        }

        function closeSearchSuggestions() {
            searchSuggestions.classList.remove("show");
            searchSuggestions.innerHTML = "";
            searchInput?.setAttribute("aria-expanded", "false");
        }

        function escapeHtml(value) {
            const temporaryElement = document.createElement("div");
            temporaryElement.textContent = value ?? "";
            return temporaryElement.innerHTML;
        }

        document.addEventListener("click", function (event) {
            if (liveSearchContainer &&
                !liveSearchContainer.contains(event.target)) {
                closeSearchSuggestions();
            }
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                closeSearchSuggestions();
                searchInput?.blur();
            }
        });
    </script>
}