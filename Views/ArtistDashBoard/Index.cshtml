@model MusicProject.Models.ViewModels.ArtistDashboardViewModel

@{
    ViewData["Title"] = "Sanatçı Paneli";

    ViewData["PageDescription"] =
        "Şarkılarını, albümlerini ve performansını buradan yönetebilirsin.";

    Layout = "_ArtistLayout";

    var artistName = string.IsNullOrWhiteSpace(Model.Artist.Name)
        ? "Sanatçı"
        : Model.Artist.Name;

    var countryText = string.IsNullOrWhiteSpace(Model.Artist.Country)
        ? "Ülke bilgisi yok"
        : Model.Artist.Country;

    var debutText = Model.Artist.DebutYear.HasValue
        ? Model.Artist.DebutYear.Value.ToString()
        : "Belirtilmedi";
}

@section Styles {
    <style>
        .artist-dashboard-content {
            padding: 32px 34px 50px;
        }

        .artist-profile-banner {
            min-height: 235px;
            padding: 34px;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            gap: 28px;
            background: linear-gradient( 125deg, rgba(30, 215, 96, 0.22), rgba(18, 23, 19, 0.96) 57% );
            border: 1px solid rgba(30, 215, 96, 0.20);
            border-radius: 22px;
        }

            .artist-profile-banner::after {
                content: "♫";
                position: absolute;
                right: 35px;
                bottom: -55px;
                color: rgba(30, 215, 96, 0.12);
                font-size: 190px;
                transform: rotate(-10deg);
            }

        .artist-avatar-large {
            width: 145px;
            height: 145px;
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: #071008;
            background: radial-gradient( circle at 35% 30%, #52ef8a, var(--primary) 42%, #0c6d30 );
            border: 5px solid rgba(255, 255, 255, 0.12);
            border-radius: 50%;
            font-size: 48px;
            font-weight: 900;
            box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
        }

        .artist-profile-content {
            position: relative;
            z-index: 1;
            flex: 1;
        }

        .artist-verified-label {
            margin-bottom: 10px;
            color: var(--primary);
            font-size: 12px;
            font-weight: 850;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .artist-main-name {
            margin-bottom: 10px;
            color: #ffffff;
            font-size: clamp(30px, 4vw, 48px);
            line-height: 1.1;
        }

        .artist-description {
            max-width: 700px;
            color: var(--text-secondary);
            font-size: 14px;
            line-height: 1.7;
        }

        .artist-profile-meta {
            margin-top: 18px;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 18px;
        }

        .artist-profile-meta-item {
            color: #dce2dd;
            font-size: 13px;
        }

            .artist-profile-meta-item strong {
                color: #ffffff;
            }

        .artist-edit-profile-button {
            padding: 12px 17px;
            position: relative;
            z-index: 1;
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.06);
            border: 1px solid var(--border);
            border-radius: 12px;
            font-size: 13px;
            font-weight: 800;
            transition: 0.2s;
        }

            .artist-edit-profile-button:hover {
                color: #071008;
                background-color: #ffffff;
            }

        .artist-stat-grid {
            margin-top: 25px;
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 18px;
        }

        .artist-stat-card {
            min-height: 145px;
            padding: 21px;
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 18px;
            transition: 0.22s ease;
        }

            .artist-stat-card:hover {
                background-color: var(--card-hover);
                border-color: rgba(30, 215, 96, 0.22);
                transform: translateY(-3px);
            }

        .artist-stat-card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .artist-stat-icon {
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 13px;
            font-size: 20px;
        }

        .artist-green-icon {
            color: var(--primary);
            background-color: rgba(30, 215, 96, 0.11);
        }

        .artist-blue-icon {
            color: var(--info);
            background-color: rgba(85, 170, 255, 0.11);
        }

        .artist-orange-icon {
            color: var(--warning);
            background-color: rgba(255, 189, 61, 0.11);
        }

        .artist-red-icon {
            color: var(--danger);
            background-color: rgba(255, 92, 92, 0.11);
        }

        .artist-stat-mini-value {
            padding: 5px 8px;
            color: var(--primary);
            background-color: rgba(30, 215, 96, 0.09);
            border-radius: 8px;
            font-size: 11px;
            font-weight: 800;
        }

        .artist-stat-number {
            margin-top: 20px;
            color: #ffffff;
            font-size: 28px;
            font-weight: 900;
        }

        .artist-stat-label {
            margin-top: 6px;
            color: var(--text-secondary);
            font-size: 13px;
        }

        .artist-dashboard-grid {
            margin-top: 25px;
            display: grid;
            grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
            gap: 20px;
        }

        .artist-panel {
            background-color: var(--card);
            border: 1px solid var(--border);
            border-radius: 19px;
        }

        .artist-panel-header {
            min-height: 69px;
            padding: 18px 21px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            border-bottom: 1px solid var(--border);
        }

        .artist-panel-title {
            color: #ffffff;
            font-size: 16px;
            font-weight: 850;
        }

        .artist-panel-subtitle {
            margin-top: 4px;
            color: var(--text-secondary);
            font-size: 12px;
        }

        .artist-panel-link {
            flex-shrink: 0;
            color: var(--primary);
            font-size: 12px;
            font-weight: 750;
        }

            .artist-panel-link:hover {
                text-decoration: underline;
            }

        .artist-album-list,
        .artist-quick-actions {
            padding: 17px;
            display: grid;
            gap: 11px;
        }

        .artist-album-item,
        .artist-quick-action {
            min-height: 68px;
            padding: 13px;
            display: flex;
            align-items: center;
            gap: 13px;
            background-color: rgba(255, 255, 255, 0.025);
            border: 1px solid transparent;
            border-radius: 13px;
            transition: 0.2s;
        }

            .artist-album-item:hover,
            .artist-quick-action:hover {
                background-color: rgba(255, 255, 255, 0.055);
                border-color: var(--border);
                transform: translateX(3px);
            }

        .artist-album-cover,
        .artist-quick-action-icon {
            width: 43px;
            height: 43px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: var(--primary);
            background-color: rgba(30, 215, 96, 0.09);
            border-radius: 11px;
        }

        .artist-album-content,
        .artist-quick-action-content {
            min-width: 0;
            flex: 1;
        }

        .artist-album-title,
        .artist-quick-action-title {
            overflow: hidden;
            color: #ffffff;
            font-size: 13px;
            font-weight: 800;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .artist-album-description,
        .artist-quick-action-description {
            margin-top: 4px;
            overflow: hidden;
            color: var(--text-secondary);
            font-size: 11px;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .artist-album-song-count {
            flex-shrink: 0;
            color: var(--primary);
            font-size: 11px;
            font-weight: 800;
        }

        .artist-quick-action-arrow {
            color: #5c655f;
        }

        .artist-songs-panel {
            margin-top: 25px;
        }

        .artist-table-wrapper {
            overflow-x: auto;
        }

        .artist-data-table {
            width: 100%;
            border-collapse: collapse;
        }

            .artist-data-table th,
            .artist-data-table td {
                padding: 15px 18px;
                border-bottom: 1px solid var(--border);
                text-align: left;
                white-space: nowrap;
            }

            .artist-data-table th {
                color: #687169;
                font-size: 10px;
                font-weight: 850;
                letter-spacing: 0.8px;
                text-transform: uppercase;
            }

            .artist-data-table td {
                color: #d8ded9;
                font-size: 12px;
            }

            .artist-data-table tbody tr:hover {
                background-color: rgba(255, 255, 255, 0.025);
            }

            .artist-data-table tbody tr:last-child td {
                border-bottom: none;
            }

        .artist-song-cell {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .artist-song-cover {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: var(--primary);
            background: linear-gradient(135deg, #1d3324, #0c110e);
            border-radius: 11px;
            font-size: 17px;
        }

        .artist-cell-title {
            color: #ffffff;
            font-size: 12px;
            font-weight: 750;
        }

        .artist-cell-subtitle {
            margin-top: 3px;
            color: var(--text-secondary);
            font-size: 10px;
        }

        .artist-status-badge {
            padding: 5px 9px;
            display: inline-flex;
            color: var(--primary);
            background-color: rgba(30, 215, 96, 0.10);
            border-radius: 20px;
            font-size: 10px;
            font-weight: 800;
        }

        .artist-empty-panel {
            padding: 45px 24px;
            text-align: center;
        }

        .artist-empty-icon {
            color: var(--primary);
            font-size: 38px;
        }

        .artist-empty-title {
            margin-top: 14px;
            color: #ffffff;
            font-size: 15px;
            font-weight: 800;
        }

        .artist-empty-description {
            margin-top: 7px;
            color: var(--text-secondary);
            font-size: 12px;
            line-height: 1.6;
        }

        @@media (max-width: 1200px) {
            .artist-stat-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .artist-dashboard-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 700px) {
            .artist-dashboard-content {
                padding: 20px 16px 35px;
            }

            .artist-profile-banner {
                padding: 25px;
                align-items: flex-start;
                flex-direction: column;
            }

            .artist-avatar-large {
                width: 110px;
                height: 110px;
                font-size: 38px;
            }

            .artist-edit-profile-button {
                width: 100%;
                text-align: center;
            }

            .artist-stat-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="artist-dashboard-content">

    <section class="artist-profile-banner">

        <div class="artist-avatar-large">
            @Model.ArtistInitial
        </div>

        <div class="artist-profile-content">

            <p class="artist-verified-label">
                Sanatçı hesabı
            </p>

            <h2 class="artist-main-name">
                @artistName
            </h2>

            <p class="artist-description">
                Müziklerini yönet, albümlerini düzenle ve dinleyicilerinin
                şarkılarınla nasıl etkileşime girdiğini takip et.
            </p>

            <div class="artist-profile-meta">

                <span class="artist-profile-meta-item">
                    <strong>@Model.TotalSongs</strong> şarkı
                </span>

                <span class="artist-profile-meta-item">
                    <strong>@Model.TotalAlbums</strong> albüm
                </span>

                <span class="artist-profile-meta-item">
                    <strong>@Model.TotalFollowers.ToString("N0")</strong>
                    takipçi
                </span>

                <span class="artist-profile-meta-item">
                    @countryText
                </span>

                <span class="artist-profile-meta-item">
                    Başlangıç:
                    <strong>@debutText</strong>
                </span>

            </div>

        </div>

        <a asp-controller="ArtistDashboard"
           asp-action="ProfileSettings"
           class="artist-edit-profile-button">
            Profili Düzenle
        </a>

    </section>

    <section class="artist-stat-grid">

        <article class="artist-stat-card">

            <div class="artist-stat-card-top">

                <div class="artist-stat-icon artist-green-icon">
                    ▶
                </div>

                <span class="artist-stat-mini-value">
                    Tüm zamanlar
                </span>

            </div>

            <div class="artist-stat-number">
                @Model.TotalStreams.ToString("N0")
            </div>

            <div class="artist-stat-label">
                Toplam dinlenme
            </div>

        </article>

        <article class="artist-stat-card">

            <div class="artist-stat-card-top">

                <div class="artist-stat-icon artist-blue-icon">
                    👥
                </div>

                <span class="artist-stat-mini-value">
                    Aylık
                </span>

            </div>

            <div class="artist-stat-number">
                @Model.MonthlyListeners.ToString("N0")
            </div>

            <div class="artist-stat-label">
                Aylık dinleyici
            </div>

        </article>

        <article class="artist-stat-card">

            <div class="artist-stat-card-top">

                <div class="artist-stat-icon artist-orange-icon">
                    ♡
                </div>

                <span class="artist-stat-mini-value">
                    Tüm şarkılar
                </span>

            </div>

            <div class="artist-stat-number">
                @Model.TotalLikes.ToString("N0")
            </div>

            <div class="artist-stat-label">
                Toplam beğeni
            </div>

        </article>

        <article class="artist-stat-card">

            <div class="artist-stat-card-top">

                <div class="artist-stat-icon artist-red-icon">
                    ♫
                </div>

                <span class="artist-stat-mini-value">
                    Yayında
                </span>

            </div>

            <div class="artist-stat-number">
                @Model.TotalSongs
            </div>

            <div class="artist-stat-label">
                Toplam şarkı
            </div>

        </article>

    </section>

    <section class="artist-dashboard-grid">

        <article class="artist-panel">

            <div class="artist-panel-header">

                <div>

                    <h3 class="artist-panel-title">
                        Son albümler
                    </h3>

                    <p class="artist-panel-subtitle">
                        En son yayınladığın albümler
                    </p>

                </div>

                <a asp-controller="ArtistDashboard"
                   asp-action="MyAlbums"
                   class="artist-panel-link">
                    Tümünü Gör
                </a>

            </div>

            @if (Model.RecentAlbums.Any())
            {
                <div class="artist-album-list">

                    @foreach (var album in Model.RecentAlbums)
                    {
                        <a asp-controller="ArtistDashboard"
                           asp-action="AlbumDetails"
                           asp-route-albumId="@album.Id"
                           class="artist-album-item">

                            <div class="artist-album-cover">
                                ◉
                            </div>

                            <div class="artist-album-content">

                                <div class="artist-album-title">
                                    @album.Name
                                </div>

                                <div class="artist-album-description">
                                    @album.ReleaseDate.ToString("dd.MM.yyyy")
                                </div>

                            </div>

                            <span class="artist-album-song-count">
                                @album.Songs.Count şarkı
                            </span>

                        </a>
                    }

                </div>
            }
            else
            {
                <div class="artist-empty-panel">

                    <div class="artist-empty-icon">
                        ◉
                    </div>

                    <h4 class="artist-empty-title">
                        Henüz albüm bulunmuyor
                    </h4>

                    <p class="artist-empty-description">
                        İlk albümünü oluşturduğunda burada görüntülenecek.
                    </p>

                </div>
            }

        </article>

        <article class="artist-panel">

            <div class="artist-panel-header">

                <div>

                    <h3 class="artist-panel-title">
                        Hızlı işlemler
                    </h3>

                    <p class="artist-panel-subtitle">
                        Sanatçı hesabını kolayca yönet
                    </p>

                </div>

            </div>

            <div class="artist-quick-actions">

                <a asp-controller="ArtistDashboard"
                   asp-action="CreateAlbum"
                   class="artist-quick-action">

                    <div class="artist-quick-action-icon">
                        ◉
                    </div>

                    <div class="artist-quick-action-content">

                        <div class="artist-quick-action-title">
                            Yeni albüm oluştur
                        </div>

                        <div class="artist-quick-action-description">
                            Sanatçı profiline yeni albüm ekle
                        </div>

                    </div>

                    <span class="artist-quick-action-arrow">
                        ›
                    </span>

                </a>

                <a asp-controller="ArtistDashboard"
                   asp-action="CreateSong"
                   class="artist-quick-action">

                    <div class="artist-quick-action-icon">
                        ＋
                    </div>

                    <div class="artist-quick-action-content">

                        <div class="artist-quick-action-title">
                            Yeni şarkı yükle
                        </div>

                        <div class="artist-quick-action-description">
                            Sisteme yeni bir şarkı ekle
                        </div>

                    </div>

                    <span class="artist-quick-action-arrow">
                        ›
                    </span>

                </a>

                <a asp-controller="ArtistDashboard"
                   asp-action="MySongs"
                   class="artist-quick-action">

                    <div class="artist-quick-action-icon">
                        ♫
                    </div>

                    <div class="artist-quick-action-content">

                        <div class="artist-quick-action-title">
                            Şarkılarımı yönet
                        </div>

                        <div class="artist-quick-action-description">
                            Şarkılarını düzenle veya kaldır
                        </div>

                    </div>

                    <span class="artist-quick-action-arrow">
                        ›
                    </span>

                </a>

                <a asp-controller="ArtistDashboard"
                   asp-action="ProfileSettings"
                   class="artist-quick-action">

                    <div class="artist-quick-action-icon">
                        ⚙
                    </div>

                    <div class="artist-quick-action-content">

                        <div class="artist-quick-action-title">
                            Profilini düzenle
                        </div>

                        <div class="artist-quick-action-description">
                            İsim, ülke ve başlangıç yılını değiştir
                        </div>

                    </div>

                    <span class="artist-quick-action-arrow">
                        ›
                    </span>

                </a>

            </div>

        </article>

    </section>

    <section class="artist-panel artist-songs-panel">

        <div class="artist-panel-header">

            <div>

                <h3 class="artist-panel-title">
                    En iyi performans gösteren şarkılarım
                </h3>

                <p class="artist-panel-subtitle">
                    Popülerlik ve dinlenme sayısına göre sıralanmıştır
                </p>

            </div>

            <a asp-controller="ArtistDashboard"
               asp-action="MySongs"
               class="artist-panel-link">
                Tümünü Gör
            </a>

        </div>

        @if (Model.PopularSongs.Any())
        {
            <div class="artist-table-wrapper">

                <table class="artist-data-table">

                    <thead>
                        <tr>
                            <th>Şarkı</th>
                            <th>Eklenme</th>
                            <th>Dinlenme</th>
                            <th>Beğeni</th>
                            <th>Popülerlik</th>
                            <th>Durum</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var song in Model.PopularSongs)
                        {
                            var albumName =
                                song.Album?.Name ?? "Single";

                            var totalStreams =
                                song.SongStat?.TotalStreams ?? 0;

                            var totalLikes =
                                song.SongStat?.TotalLikes ?? 0;

                            var popularityScore =
                                song.SongStat?.PopularityScore ?? 0;

                            <tr>

                                <td>

                                    <div class="artist-song-cell">

                                        <div class="artist-song-cover">
                                            ♪
                                        </div>

                                        <div>

                                            <div class="artist-cell-title">
                                                @song.Title
                                            </div>

                                            <div class="artist-cell-subtitle">
                                                @albumName
                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <td>
                                    @song.CreatedAt.ToString("dd.MM.yyyy")
                                </td>

                                <td>
                                    @totalStreams.ToString("N0")
                                </td>

                                <td>
                                    @totalLikes.ToString("N0")
                                </td>

                                <td>
                                    @popularityScore.ToString("N0")
                                </td>

                                <td>

                                    <span class="artist-status-badge">
                                        Yayında
                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="artist-empty-panel">

                <div class="artist-empty-icon">
                    ♫
                </div>

                <h4 class="artist-empty-title">
                    Henüz şarkı bulunmuyor
                </h4>

                <p class="artist-empty-description">
                    İlk şarkını eklediğinde performans bilgileri burada gösterilecek.
                </p>

            </div>
        }

    </section>

</div>