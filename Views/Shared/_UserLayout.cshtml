@model MusicProject.ViewModels.UserDashboard.UserLayoutViewModel

<!DOCTYPE html>
<html lang="tr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - MusicProject
    </title>

    <link rel="stylesheet"
          href="~/css/user-layout.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <div class="user-layout">

        <partial name="_UserSidebar"
                 model="Model" />

        <div class="sidebar-overlay"
             id="sidebarOverlay">
        </div>

        @RenderBody()

    </div>

    <audio id="globalAudioPlayer"
           preload="metadata">
    </audio>

    <form id="playSongTokenForm"
          data-play-url="@Url.Action("PlaySong", "UserDashboard")"
          style="display: none;">

        @Html.AntiForgeryToken()

    </form>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/js/user-player.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>